---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mascot from '../components/Mascot.astro';
import { LANGS, pagePath } from '../i18n/routes';
import { t } from '../i18n';
---
<!-- GitHub Pages serves one root 404.html, so both languages are shown here. -->
<BaseLayout lang="pt" title={t('pt', 'notfound.title')} noindex>
  <div class="notfound">
    <Mascot pose="sad" size="normal" />
    <span class="azulejo-corner azulejo-corner--mirror notfound__corner" aria-hidden="true"></span>
  </div>
  {
    LANGS.map((lang) => (
      <section lang={lang} aria-labelledby={`notfound-${lang}`}>
        <h1 id={`notfound-${lang}`}>{t(lang, 'notfound.title')}</h1>
        <p>{t(lang, 'notfound.text')}</p>
        <p>
          <a class="button" href={pagePath(lang, 'home')}>{t(lang, 'notfound.home')}</a>
        </p>
      </section>
    ))
  }
</BaseLayout>

<style>
  /* The corner signature of the page: top right, in the free space above the headings. */
  .notfound {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .notfound__corner {
    margin: 0;
  }
</style>
