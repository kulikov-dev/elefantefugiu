---
import '../styles/global.css';
import FaviconLinks from '../components/FaviconLinks.astro';
import { LANGS, LANG_NAMES, pagePath, withBase, type Lang } from '../i18n/routes';
import { rootScript } from '../lib/lang-choice';

const hrefs = Object.fromEntries(LANGS.map((lang) => [lang, pagePath(lang, 'home')])) as Record<Lang, string>;
---
<!doctype html>
<html lang="pt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>O Elefante Fugiu</title>
    <FaviconLinks />
    {LANGS.map((lang) => <link rel="alternate" hreflang={lang} href={hrefs[lang]} />)}
    <!-- Saved choice first, then the browser language (ru* -> Russian, en* -> English, anything else -> Portuguese). -->
    <script is:inline set:html={rootScript(hrefs)} />
  </head>
  <body>
    <main class="lang-chooser">
      <h1>O Elefante Fugiu</h1>
      <ul class="lang-chooser__links">
        {LANGS.map((lang) => <li><a class="button" href={hrefs[lang]} lang={lang} hreflang={lang}>{LANG_NAMES[lang]}</a></li>)}
      </ul>
    </main>
  </body>
</html>
