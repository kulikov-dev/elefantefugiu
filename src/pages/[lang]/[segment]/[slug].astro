---
// One route file for the three kinds of content pages that live at /{lang}/{segment}/{slug}:
//   card    /pt/historia/{slug}   /en/story/{slug}
//   epoch   /pt/epoca/{slug}      /en/era/{slug}
//   thread  /pt/fio/{slug}        /en/thread/{slug}
//   panel   /pt/painel/{slug}     /en/panel/{slug}   (the finished panel of an epoch that has `panno`; noindex)
//   myth    /pt/mito-ou-verdade/{id}  /en/myth-or-fact/{id}   (one claim of "Myth or fact": the page of all of them with that one first; noindex)
// Segments come from src/i18n/routes.ts, slugs from the data (one per language).
// Epochs without content and threads with too few cards get no page.
import type { GetStaticPaths } from 'astro';
import EpochView from '../../../views/EpochView.astro';
import StoryView from '../../../views/StoryView.astro';
import PannoView from '../../../views/PannoView.astro';
import MythsView from '../../../views/MythsView.astro';
import ThreadView from '../../../views/ThreadView.astro';
import { EPOCH_SEGMENT, LANGS, PANNO_SEGMENT, ROUTES, STORY_SEGMENT, THREAD_SEGMENT, type Lang } from '../../../i18n/routes';
import { epochHasContent, type EpochData, type ThreadData } from '../../../lib/epochs';
import type { EventData } from '../../../lib/events';
import { liveMyths } from '../../../lib/myths';
import { MYTHS } from '../../../lib/myths-data';
import { loadSite } from '../../../lib/site-data';

type PageProps =
  | { kind: 'story'; event: EventData }
  | { kind: 'epoch'; epoch: EpochData }
  | { kind: 'thread'; thread: ThreadData }
  | { kind: 'panno'; epoch: EpochData }
  | { kind: 'myth'; id: string };

export const getStaticPaths = (async () => {
  const site = await loadSite();
  return LANGS.flatMap((lang) => [
    ...site.events.map((event) => ({
      params: { lang, segment: STORY_SEGMENT[lang], slug: event.slug[lang] },
      props: { kind: 'story', event } as PageProps,
    })),
    ...site.epochs
      .filter((epoch) => epochHasContent(epoch, site.events))
      .map((epoch) => ({
        params: { lang, segment: EPOCH_SEGMENT[lang], slug: epoch.slug[lang] },
        props: { kind: 'epoch', epoch } as PageProps,
      })),
    ...site.epochs
      .filter((epoch) => epoch.panno && epochHasContent(epoch, site.events))
      .map((epoch) => ({
        params: { lang, segment: PANNO_SEGMENT[lang], slug: epoch.slug[lang] },
        props: { kind: 'panno', epoch } as PageProps,
      })),
    ...liveMyths(MYTHS, site.events).map((myth) => ({
      params: { lang, segment: ROUTES.myths[lang], slug: myth.id },
      props: { kind: 'myth', id: myth.id } as PageProps,
    })),
    ...site.visibleThreads.map((thread) => ({
      params: { lang, segment: THREAD_SEGMENT[lang], slug: thread.slug[lang] },
      props: { kind: 'thread', thread } as PageProps,
    })),
  ]);
}) satisfies GetStaticPaths;

const props = Astro.props as PageProps;
const lang = Astro.params.lang as Lang;
---
{props.kind === 'story' && <StoryView lang={lang} event={props.event} />}
{props.kind === 'epoch' && <EpochView lang={lang} epoch={props.epoch} />}
{props.kind === 'panno' && <PannoView lang={lang} epoch={props.epoch} />}
{props.kind === 'myth' && <MythsView lang={lang} first={props.id} />}
{props.kind === 'thread' && <ThreadView lang={lang} thread={props.thread} />}
