---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import HomeView from '../../views/HomeView.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LANGS, ROUTES, type Lang, type PageKey } from '../../i18n/routes';
import { t } from '../../i18n';

export const getStaticPaths = (() => {
  // The map has its own route file ([map].astro): map code and styles must not reach the other pages.
  const keys = (Object.keys(ROUTES) as PageKey[]).filter((key) => key !== 'map');
  return LANGS.flatMap((lang) =>
    keys.map((pageKey) => ({
      // An empty slug becomes undefined so the home page lands on /pt/ and /en/.
      params: { lang, page: ROUTES[pageKey][lang] || undefined },
      props: { lang: lang as Lang, pageKey },
    })),
  );
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { lang, pageKey } = Astro.props as Props;

const isHome = pageKey === 'home';
const title = isHome ? t(lang, 'site.name') : t(lang, `pages.${pageKey}.title`);
---
{
  isHome ? (
    <HomeView lang={lang} />
  ) : (
    <BaseLayout lang={lang} pageKey={pageKey} title={title}>
      <h1>{title}</h1>
      <p class="notice">{t(lang, 'stub.notice')}</p>
    </BaseLayout>
  )
}
