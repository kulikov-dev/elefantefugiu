---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import HomeView from '../../views/HomeView.astro';
import MythsView from '../../views/MythsView.astro';
import GamesView from '../../views/GamesView.astro';
import OrderView from '../../views/OrderView.astro';
import ReportView from '../../views/ReportView.astro';
import ShareView from '../../views/ShareView.astro';
import StaticView from '../../views/StaticView.astro';
import SearchView from '../../views/SearchView.astro';
import SurpriseView from '../../views/SurpriseView.astro';
import CabinetView from '../../views/CabinetView.astro';
import GlossaryView from '../../views/GlossaryView.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LANGS, ROUTES, type Lang, type PageKey } from '../../i18n/routes';
import { isGlossaryLang } from '../../lib/glossary';
import { t } from '../../i18n';

export const getStaticPaths = (() => {
  // The map has its own route file ([map].astro): map code and styles must not reach the other pages.
  const keys = (Object.keys(ROUTES) as PageKey[]).filter((key) => key !== 'map');
  return LANGS.flatMap((lang) =>
    // The glossary has no Portuguese page: its words are Portuguese, and the Portuguese text is not marked.
    keys.filter((key) => key !== 'glossary' || isGlossaryLang(lang)).map((pageKey) => ({
      // An empty slug becomes undefined so the home page lands on /pt/ and /en/.
      params: { lang, page: ROUTES[pageKey][lang] || undefined },
      props: { lang: lang as Lang, pageKey },
    })),
  );
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { lang, pageKey } = Astro.props as Props;

const isHome = pageKey === 'home';
const title = isHome ? t(lang, 'site.name') : t(lang, `pages.${pageKey}.title`);
---
{
  isHome ? (
    <HomeView lang={lang} />
  ) : pageKey === 'surprise' ? (
    <SurpriseView lang={lang} />
  ) : pageKey === 'glossary' && isGlossaryLang(lang) ? (
    <GlossaryView lang={lang} />
  ) : pageKey === 'search' ? (
    <SearchView lang={lang} />
  ) : pageKey === 'myths' ? (
    <MythsView lang={lang} />
  ) : pageKey === 'games' ? (
    <GamesView lang={lang} />
  ) : pageKey === 'cabinet' ? (
    <CabinetView lang={lang} />
  ) : pageKey === 'order' ? (
    <OrderView lang={lang} />
  ) : pageKey === 'report' ? (
    <ReportView lang={lang} />
  ) : pageKey === 'share' ? (
    <ShareView lang={lang} />
  ) : pageKey === 'about' || pageKey === 'method' || pageKey === 'legal' ? (
    <StaticView lang={lang} pageKey={pageKey} />
  ) : (
    <BaseLayout lang={lang} pageKey={pageKey} title={title}>
      <h1>{title}</h1>
      <p class="notice">{t(lang, 'stub.notice')}</p>
    </BaseLayout>
  )
}
