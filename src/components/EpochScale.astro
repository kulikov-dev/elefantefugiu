---
// The epoch filter of the map page as a scale of time under the map: all the epochs in order, each as wide as its years
// (beyond a minimum width, so that a short epoch stays readable and can be pressed), the ready ones are buttons that filter the
// map, the others are pale text. A ground for the year slider that may come later (the slider is not built).
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';
import { epochYearsText, type EpochData } from '../lib/epochs';

interface Props {
  lang: Lang;
  epochs: readonly EpochData[];
  /** Ids of the epochs that have a page (and stories). */
  readyIds: ReadonlySet<string>;
}

const { lang, epochs, readyIds } = Astro.props;
const sorted = [...epochs].sort((a, b) => a.order - b.order);
// The length of an epoch in years; an epoch without numbers counts as a short one.
const span = (e: EpochData) => (e.years ? Math.max(e.years.to - e.years.from, 1) : 50);
---
<nav class="epoch-scale" aria-label={t(lang, 'map.timeline_label')}>
  <ol class="epoch-scale__list">
    <li class="epoch-scale__item epoch-scale__item--all">
      <button type="button" class="epoch-scale__button" data-epoca="" aria-pressed="true">{t(lang, 'map.all_epochs')}</button>
    </li>
    {
      sorted.map((epoch) => (
        <li class="epoch-scale__item" style={`flex-grow:${span(epoch)}`}>
          {readyIds.has(epoch.id) ? (
            <button type="button" class="epoch-scale__button" data-epoca={epoch.id} aria-pressed="false">
              <span class="epoch-scale__name">{epoch.name[lang]}</span>
              <span class="epoch-scale__years">{epochYearsText(epoch, lang)}</span>
            </button>
          ) : (
            <span class="epoch-scale__button epoch-scale__button--soon">
              <span class="epoch-scale__name">{epoch.name[lang]}</span>
              <span class="epoch-scale__years">{epochYearsText(epoch, lang)}</span>
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .epoch-scale {
    margin-block-start: var(--space-3);
    overflow-x: auto;
    padding-block-end: var(--space-2);
  }

  .epoch-scale__list {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Width in proportion to the years (flex-grow is the length of the epoch, the basis is zero), but never narrower than the minimum. */
  .epoch-scale__item {
    display: flex;
    flex-basis: 0;
    min-width: var(--epoch-scale-min);
  }

  .epoch-scale__item--all {
    flex: 0 0 auto;
    min-width: 0;
  }

  .epoch-scale__button {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-1);
    min-height: var(--touch-target-large);
    padding: var(--space-2);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-sm);
    line-height: 1.25;
    text-align: start;
  }

  button.epoch-scale__button {
    cursor: pointer;
  }

  .epoch-scale__name {
    font-size: var(--text-xs);
    font-weight: 600;
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .epoch-scale__years {
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
  }

  button.epoch-scale__button[aria-pressed='true'] {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-surface);
  }

  button.epoch-scale__button[aria-pressed='true'] .epoch-scale__years {
    color: inherit;
  }

  /* An epoch that is not ready: pale, dashed, not a button. */
  .epoch-scale__button--soon {
    border-style: dashed;
    border-color: var(--epoch-line);
    background: transparent;
    color: var(--color-ink-muted);
  }

  .epoch-scale__item--all .epoch-scale__button {
    justify-content: center;
  }
</style>
