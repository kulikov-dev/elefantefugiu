---
// The epoch filter of the map page as a scale of time under the map: all the epochs in order, each in a cell of the same width
// (a strip that scrolls sideways and fades at the edge), the ready ones are buttons that filter the
// map, the others are pale text. A ground for the year slider that may come later (the slider is not built).
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';
import { epochYearsText, type EpochData } from '../lib/epochs';

interface Props {
  lang: Lang;
  epochs: readonly EpochData[];
  /** Ids of the epochs that have a page (and stories). */
  readyIds: ReadonlySet<string>;
}

const { lang, epochs, readyIds } = Astro.props;
const sorted = [...epochs].sort((a, b) => a.order - b.order);
---
<nav class="epoch-scale" data-scroll-fade aria-label={t(lang, 'map.timeline_label')}>
  <ol class="epoch-scale__list">
    <li class="epoch-scale__item epoch-scale__item--all">
      <button type="button" class="epoch-scale__button" data-epoca="" aria-pressed="true">{t(lang, 'map.all_epochs')}</button>
    </li>
    {
      sorted.map((epoch) => (
        <li class="epoch-scale__item">
          {readyIds.has(epoch.id) ? (
            <button type="button" class="epoch-scale__button" data-epoca={epoch.id} aria-pressed="false" style={`--tone: var(--tone-${epoch.id}, var(--epoch-primary))`}>
              <span class="epoch-scale__name">{epoch.name[lang]}</span>
              <span class="epoch-scale__years">{epochYearsText(epoch, lang)}</span>
            </button>
          ) : (
            <span class="epoch-scale__button epoch-scale__button--soon">
              <span class="epoch-scale__name">{epoch.name[lang]}</span>
              <span class="epoch-scale__years">{epochYearsText(epoch, lang)}</span>
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .epoch-scale {
    margin-block-start: var(--space-3);
    overflow-x: auto;
    padding-block-end: var(--space-2);
  }

  .epoch-scale__list {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Every epoch has a cell of the same width (the names wrap at the spaces; the strip scrolls sideways and fades at the edge). */
  .epoch-scale__item {
    display: flex;
    flex: 0 0 var(--epoch-scale-cell);
  }

  .epoch-scale__item--all {
    flex: 0 0 auto;
    min-width: 0;
  }

  .epoch-scale__button {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-1);
    min-height: var(--touch-target-large);
    padding: var(--space-2);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-sm);
    line-height: 1.25;
    text-align: start;
  }

  button.epoch-scale__button {
    cursor: pointer;
  }

  .epoch-scale__name {
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .epoch-scale__years {
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
  }

  button.epoch-scale__button[aria-pressed='true'] {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-surface);
  }

  /* An epoch pressed: in the primary colour of that epoch, as on the home page ("All" stays ink). */
  button.epoch-scale__button[data-epoca]:not([data-epoca='']):not([aria-pressed='true']):hover {
    border-color: var(--tone);
  }

  button.epoch-scale__button[data-epoca]:not([data-epoca=''])[aria-pressed='true'] {
    border-color: var(--tone);
    background: var(--tone);
    color: var(--color-on-accent);
  }

  button.epoch-scale__button[aria-pressed='true'] .epoch-scale__years {
    color: inherit;
  }

  /* An epoch that is not ready: pale, dashed, not a button. */
  .epoch-scale__button--soon {
    border-style: dashed;
    border-color: var(--epoch-line);
    background: transparent;
    color: var(--color-ink-muted);
  }

  .epoch-scale__item--all .epoch-scale__button {
    justify-content: center;
  }
</style>
