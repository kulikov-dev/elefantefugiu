---
// The epoch filter of the map page: the same strip as the epochs of the home page (TimelineStrip, the compact variant: a coloured axis with a dot for each epoch,
// the name and the years, arrows from 48rem up, a fade at the edges). "All epochs" comes first; the ready epochs are buttons that filter the map (the chosen one has a
// bold dot and an underlined name), the others are pale text. A ground for the year slider that may come later (the slider is not built).
import TimelineStrip from './TimelineStrip.astro';
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';
import { epochYearsText, type EpochData } from '../lib/epochs';

interface Props {
  lang: Lang;
  epochs: readonly EpochData[];
  /** Ids of the epochs that have a page (and stories). */
  readyIds: ReadonlySet<string>;
}

const { lang, epochs, readyIds } = Astro.props;
const sorted = [...epochs].sort((a, b) => a.order - b.order);
---
<nav class="epoch-scale">
  <TimelineStrip lang={lang} compact label={t(lang, 'map.timeline_label')}>
    <li class="timeline__item timeline__item--ready timeline__item--all">
      <button type="button" class="timeline__pick" data-epoca="" aria-pressed="true">
        <span class="timeline__name">{t(lang, 'map.all_epochs')}</span>
      </button>
    </li>
    {
      sorted.map((epoch) =>
        readyIds.has(epoch.id) ? (
          <li class="timeline__item timeline__item--ready" style={`--tone: var(--tone-${epoch.id}, var(--epoch-primary))`}>
            <button type="button" class="timeline__pick" data-epoca={epoch.id} aria-pressed="false">
              <span class="timeline__name">{epoch.name[lang]}</span>
              <span class="timeline__years">{epochYearsText(epoch, lang)}</span>
            </button>
          </li>
        ) : (
          <li class="timeline__item timeline__item--soon" title={epoch.intro?.[lang]?.trim() || undefined}>
            <span class="timeline__name">{epoch.name[lang]}</span>
            <span class="timeline__years">{epochYearsText(epoch, lang)}</span>
          </li>
        ),
      )
    }
  </TimelineStrip>
</nav>
