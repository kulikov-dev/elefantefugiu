---
// "Then and now" on an epoch page (docs/spec.md 5.2): three cards, each a figure of the epoch beside the same thing today. The data are in
// epochs.yaml (then_now); the numbers marked {n} are calculated (src/lib/then-now.ts). The mark "estimate" or "calculation" is shown on
// those cards only (a plain fact has none); under the block one sentence explains the marks that are used, and the sources are folded.
//
// One list. Below 768 px, with JavaScript (html[data-js], set in <head> before the first paint, so nothing moves), the second and third
// cards are hidden by CSS and a button under the first one shows them: it sets aria-expanded, goes away, and moves the focus to the second
// card (tabindex="-1"). Without JavaScript, and from 768 px, everything is shown and there is no button.
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';
import { isPublished, type EventData } from '../lib/events';
import type { EpochData } from '../lib/epochs';
import { thenNowNoteKinds } from '../lib/then-now';
import ThenNowCard from './ThenNowCard.astro';

interface Props {
  lang: Lang;
  epoch: EpochData;
  /** The stories of the site: a card leads to its story only when that story is published. */
  events: readonly EventData[];
}

const { lang, epoch, events } = Astro.props;
const cards = epoch.then_now ?? [];
const published = new Map(events.filter(isPublished).map((e) => [e.id, e]));
const storyOf = (card: (typeof cards)[number]) => (card.story ? published.get(card.story) : undefined);
const noteKinds = thenNowNoteKinds(cards);
const hidden = Math.max(0, cards.length - 1);
---
{
  cards.length > 0 && (
    <section class="then-now" aria-labelledby="then-now-title" data-then-now>
      <h2 id="then-now-title">{t(lang, 'epoch.then_now')}</h2>

      <ul class="then-now__list" id="then-now-list">
        {cards.map((card, i) => <ThenNowCard lang={lang} card={card} story={storyOf(card)} id={`then-now-${i + 1}`} />)}
      </ul>
      {
        hidden > 0 && (
          <button type="button" class="button button--secondary then-now__more" aria-expanded="false" aria-controls="then-now-list" data-then-now-more>
            {t(lang, 'epoch.then_now_more').replace('{n}', String(hidden))}
          </button>
        )
      }

      {noteKinds.length > 0 && <p class="then-now__note">{noteKinds.map((kind) => t(lang, `epoch.then_now_note_${kind}`)).join(' ')}</p>}
      <details class="then-now__sources">
        <summary>{t(lang, 'epoch.then_now_sources')}</summary>
        <ul>
          {
            cards.map((card) => (
              <li>
                <span class="then-now__src-for">{card.then_big[lang]} → {card.now_big[lang]}</span>
                {card.sources.map((source, i) => (
                  <>
                    {i > 0 ? '; ' : ' '}
                    <a href={source.url} rel="noopener">{source.title}</a>
                  </>
                ))}
              </li>
            ))
          }
        </ul>
      </details>
    </section>
  )
}

<style>
  .then-now {
    margin-block-start: var(--space-7);
  }

  .then-now h2 {
    font-size: var(--text-xl);
  }

  .then-now__list {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
    margin-block-start: var(--space-3);
    list-style: none;
  }

  /* The button is for a phone with JavaScript only. */
  .then-now__more {
    display: none;
    margin-block-start: var(--space-4);
  }

  @media (max-width: 47.99rem) {
    :global(html[data-js]) .then-now:not([data-expanded]) :global(.then-now__card:nth-child(n + 2)) {
      display: none;
    }

    :global(html[data-js]) .then-now:not([data-expanded]) .then-now__more {
      display: inline-flex;
    }
  }

  @media (min-width: 64rem) {
    .then-now__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .then-now__note {
    max-width: var(--measure);
    margin-block-start: var(--space-3);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .then-now__sources {
    margin-block-start: var(--space-2);
    font-size: var(--text-sm);
  }

  .then-now__sources summary {
    display: flex;
    align-items: center;
    min-height: var(--touch-target);
    color: var(--color-accent);
    font-weight: 600;
    cursor: pointer;
  }

  .then-now__sources ul {
    margin-block-start: var(--space-1);
    padding-inline-start: var(--space-4);
  }

  .then-now__sources li + li {
    margin-block-start: var(--space-1);
  }

  .then-now__src-for {
    font-weight: 600;
  }
</style>

<script>
  // The button shows the cards that a phone keeps under it: the section gets data-expanded (CSS shows them and hides the button),
  // aria-expanded says so, and the focus goes to the second card, the first one that was hidden.
  const button = document.querySelector<HTMLButtonElement>('[data-then-now-more]');
  const section = button?.closest<HTMLElement>('[data-then-now]');
  if (button && section) {
    button.addEventListener('click', () => {
      section.setAttribute('data-expanded', '');
      button.setAttribute('aria-expanded', 'true');
      const second = section.querySelector<HTMLElement>('.then-now__card:nth-child(2)');
      second?.focus();
    });
  }
</script>
