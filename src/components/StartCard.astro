---
// A card of "Where to start" on the home page: the hook is the large line (it is stronger than the title), beneath it the small
// title, "year · city" and the credibility label. A picture, when the story has one, goes on top; without one the card
// is simply shorter (nothing is reserved; the picture of the epoch fills in for a story without one). The whole card is the link (the title, stretched).
import TagLabel from './TagLabel.astro';
import ReadMark from './ReadMark.astro';
import Pic from './Pic.astro';
import type { PictureData } from '../lib/pictures';
import { claimStoryName } from '../lib/transitions';
import { START_CARD_QUALITY, START_CARD_SIZES, START_CARD_WIDTHS } from '../lib/start-card';
import { t } from '../i18n';
import { storyPath, withBase, type Lang } from '../i18n/routes';
import { formatYear, placeShort, textLangOf, type EventData } from '../lib/events';

interface Props {
  lang: Lang;
  /** A story. */
  event?: EventData | undefined;
  /** A page that is not a story (a pinned holiday page): a hook, a title that leads to `href`, an optional picture (an address inside the site). */
  page?: { href: string; title: string; hook: string; image?: string | undefined } | undefined;
  /** The picture on top: the story's own, or the epoch's when it has none (decided by the page: cardPicture). */
  picture?: PictureData | undefined;
  /** The first card of the page: its picture is on the first screen (the largest element of the page), so it loads at once and first. */
  first?: boolean;
}

const { lang, event, page, picture, first = false } = Astro.props;
// A blank card (the template the script copies, no id) has no address yet: the script puts it in.
const href = page ? page.href : event!.id ? storyPath(lang, event!.slug[lang]) : '';
const transitionName = event?.image ? claimStoryName(Astro.request, event.slug[lang]) : undefined;
---
<article class="start-card" id={event ? `c-${event.id}` : undefined} data-story={event?.id}>
  {
    page?.image && <img class="start-card__image" src={withBase(page.image)} alt="" loading={first ? 'eager' : 'lazy'} decoding="async" />
  }
  {
    picture && event && (
      <Pic
        picture={picture}
        lang={lang}
        class="start-card__image"
        widths={START_CARD_WIDTHS}
        sizes={START_CARD_SIZES}
        quality={START_CARD_QUALITY}
        loading={first ? 'eager' : 'lazy'}
        crop
        transitionName={transitionName}
      />
    )
  }
  <div class="start-card__body">
    <p class="start-card__hook" lang={event ? textLangOf(event, lang) : undefined}>{event ? event.hook[lang] : page!.hook}</p>
    <h3 class="start-card__title"><a href={href || undefined}>{event ? event.title[lang] : page!.title}</a></h3>
    {
      event && (
        <p class="start-card__meta">
          <span data-start-year-place>{formatYear(event, lang)} &middot; {placeShort(event.place, lang)}</span>
          <TagLabel lang={lang} label={event.label} />
          {event.sensitive && <span class="start-card__heavy">{t(lang, 'ui.heavy_topic')}</span>}
          <ReadMark lang={lang} />
        </p>
      )
    }
  </div>
</article>

<style>
  .start-card {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    overflow: hidden;
    border: var(--epoch-frame);
    border-radius: var(--radius-md);
    background: var(--epoch-surface);
  }

  .start-card:hover {
    border-color: var(--color-accent);
  }

  .start-card:focus-within {
    outline: var(--ring-width) solid var(--color-accent);
    outline-offset: var(--ring-offset-tight);
  }

  .start-card :global(.start-card__image) {
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    background: var(--epoch-line);
    filter: var(--image-filter);
  }

  .start-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
  }

  .start-card__hook {
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-style: italic;
    line-height: 1.3;
  }

  .start-card__title {
    margin-block-start: auto;
    padding-block-start: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .start-card__title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  /* The link is the title; it covers the whole card. */
  .start-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .start-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .start-card__meta :global(.tag) {
    padding-inline: 0;
    border-color: transparent;
    background: transparent;
  }

  .start-card__heavy {
    font-weight: 600;
  }
</style>
