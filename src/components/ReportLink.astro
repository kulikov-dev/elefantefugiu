---
// "Spotted an inaccuracy in this story? Write to us": a small text link to the report form with the address of the card.
import { t } from '../i18n';
import { pagePath, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  /** Absolute address of the card being reported. */
  cardUrl: string;
  /** The title of the story: the form shows it instead of the long address. */
  title?: string;
}

const { lang, cardUrl, title } = Astro.props;
const href = `${pagePath(lang, 'report')}?url=${encodeURIComponent(cardUrl)}${title ? `&title=${encodeURIComponent(title)}` : ''}`;
---
<p class="report-link"><a {href}>{t(lang, 'card.report_inline')}</a></p>

<style>
  .report-link {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .report-link a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
  }
</style>
