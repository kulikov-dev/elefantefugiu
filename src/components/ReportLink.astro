---
// "Found a mistake?": link to the report form with the address of the card.
import { t } from '../i18n';
import { pagePath, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  /** Absolute address of the card being reported. */
  cardUrl: string;
}

const { lang, cardUrl } = Astro.props;
const href = `${pagePath(lang, 'report')}?url=${encodeURIComponent(cardUrl)}`;
---
<a class="button button--secondary" {href}>{t(lang, 'ui.report_error')}</a>
