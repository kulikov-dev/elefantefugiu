---
import { LANGS, LANG_NAMES, pagePath, type Lang, type PageKey } from '../i18n/routes';

interface Props {
  lang: Lang;
  /** Page to keep when switching; without it the switch leads to the language home. */
  pageKey?: PageKey;
  /** Explicit path of the same page in each language (cards); wins over pageKey. */
  alternates?: Record<Lang, string>;
  /** Only these languages are links; the others are shown dimmed and are not active (the page exists in one language only). */
  activeLangs?: readonly Lang[];
}

/** The same in every language: a reader who landed on a page in a language they cannot read still finds the switch. */
const LABEL = 'Язык / Idioma / Language';

const { lang, pageKey = 'home', alternates, activeLangs } = Astro.props;
---
<details class="lang-switch" data-lang-switch>
  <summary class="lang-switch__current" aria-label={LABEL}>
    <svg class="lang-switch__globe" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
        <circle cx="8" cy="8" r="6.2" />
        <ellipse cx="8" cy="8" rx="2.6" ry="6.2" />
        <path d="M1.8 8h12.4" />
      </g>
    </svg>
    <span aria-hidden="true">{lang.toUpperCase()}</span>
    <svg class="lang-switch__chevron" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
      <path d="M3.5 6l4.5 4.5L12.5 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </summary>
  <ul class="lang-switch__list">
    {
      LANGS.map((target) => (
        <li>
          {activeLangs && !activeLangs.includes(target) ? (
            <span class="lang-switch__off" lang={target} aria-disabled="true">{LANG_NAMES[target]}</span>
          ) : (
          <a
            href={alternates ? alternates[target] : pagePath(target, pageKey)}
            lang={target}
            hreflang={target}
            aria-current={target === lang ? 'true' : undefined}
            data-set-lang={target}
          >
            <span>{LANG_NAMES[target]}</span>
            {target === lang && (
              <svg class="lang-switch__check" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
                <path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </a>
          )}
        </li>
      ))
    }
  </ul>
</details>

<script>
  import '../scripts/lang-carry';
</script>
