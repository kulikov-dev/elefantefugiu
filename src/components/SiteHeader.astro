---
import Logo from './Logo.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import FamilyToggle from './FamilyToggle.astro';
import ThemeButton from './ThemeButton.astro';
import { EPOCHS_ANCHOR, pagePath, type Lang, type PageKey } from '../i18n/routes';
import { t } from '../i18n';

interface Props {
  lang: Lang;
  pageKey?: PageKey;
  /** Base-aware path of the current page in each language (cards). Overrides pageKey for the language switch. */
  alternates?: Record<Lang, string>;
  /** The languages the switch leads to (a page that exists in one language only). */
  activeLangs?: readonly Lang[];
}

const { lang, pageKey, alternates, activeLangs } = Astro.props;

// The page "Games" and both games (Myth or fact, Which came first?) are the item "Games", as in the tab bar.
const current = pageKey === 'myths' || pageKey === 'order' || pageKey === 'games' ? 'games' : pageKey;
const items = [
  { label: t(lang, 'nav.epochs'), href: `${pagePath(lang, 'home')}#${EPOCHS_ANCHOR}`, key: undefined },
  { label: t(lang, 'nav.map'), href: pagePath(lang, 'map'), key: 'map' },
  { label: t(lang, 'nav.games'), href: pagePath(lang, 'games'), key: 'games' },
  { label: t(lang, 'nav.surprise'), href: pagePath(lang, 'surprise'), key: 'surprise' },
];
---
<header class="site-header">
  <div class="site-header__inner container">
    <a class="brand" href={pagePath(lang, 'home')} aria-label={t(lang, 'a11y.home')}>
      <Logo />
      <span>{t(lang, 'site.name')}</span>
    </a>
    <nav class="site-nav" aria-label={t(lang, 'a11y.main_nav')}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={item.key && item.key === current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="site-header__tools">
      <LanguageSwitch lang={lang} pageKey={pageKey} alternates={alternates} activeLangs={activeLangs} />
      <ThemeButton lang={lang} />
      <FamilyToggle lang={lang} />
    </div>
  </div>
</header>
