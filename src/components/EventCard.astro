---
// A card in a list. Two variants:
//   feed: the story layer opens in place (<details>, works without JavaScript), a link leads to the card page;
//   grid: a tile that links to the card page (thread pages).
import { t } from '../i18n';
import { storyPath, threadHref, type Lang } from '../i18n/routes';
import { formatYear, isFlashMoment, placeShort, textLangOf, yearRange, type EventData } from '../lib/events';
import type { ThreadData } from '../lib/epochs';
import AgeBadge from './AgeBadge.astro';
import TagLabel from './TagLabel.astro';
import ThreadChip from './ThreadChip.astro';
import Pic from './Pic.astro';
import ReadMark from './ReadMark.astro';
import type { PictureData } from '../lib/pictures';

interface Props {
  lang: Lang;
  event: EventData;
  variant: 'feed' | 'grid';
  threads: readonly ThreadData[];
  /** Only these threads have a page, so only they become links. */
  visibleThreadIds: ReadonlySet<string>;
  /** Thread chips are left out where the page itself is about one thread. */
  showThreads?: boolean;
  /** The year stands on the timeline scale beside the card (epoch page): the line then shows a full date only, and a bare year only in the grid view, which has no scale. */
  scaleYear?: boolean;
  /** The picture of the epoch, for a card that has no picture of its own. */
  fallback?: PictureData | undefined;
  /** The id of the epoch of the story, for a page where the cards of several epochs stand together (a thread): a stripe of its colour on the left (the name of the epoch is the heading of the section). */
  toneEpoch?: string | undefined;
  /** The page can show the cards as tiles (the grid view): the picture is then made wide enough for a tile, not only for the small thumbnail. */
  tiles?: boolean;
}

const { lang, event, variant, threads, visibleThreadIds, showThreads = true, scaleYear = false, toneEpoch, fallback, tiles = false } = Astro.props;
const picture = event.image ?? fallback;
// A thumbnail is 5.5 rem wide; a tile of the grid is as wide as its column.
const wide = variant === 'grid' || tiles;
// A full date ("14 August 1385") is more exact than the year; it stays on the line of the card whatever the layout.
const label = event.year_label?.[lang]?.trim();
const fullDate = label && label !== String(yearRange(event)[0]) ? label : undefined;
const yearText = formatYear(event, lang);
const href = storyPath(lang, event.slug[lang]);
const eventThreads = showThreads ? event.threads.map((id) => threads.find((th) => th.id === id)).filter((th) => th !== undefined) : [];
// Placeholder text is Latin filler: mark it so screen readers do not read it as Portuguese.
const textLang = textLangOf(event, lang);
---
<article
  class:list={['ecard', `ecard--${variant}`, `ecard--${event.level}`, { 'ecard--toned': toneEpoch }]}
  id={`c-${event.id}`}
  data-story={event.id}
  data-flash={isFlashMoment(event) ? '' : undefined}
  style={toneEpoch ? `--tone: var(--tone-${toneEpoch}, var(--epoch-primary))` : undefined}
>
  <div class="ecard__head">
    {
      picture && (
        <Pic
          picture={picture}
          lang={lang}
          class="ecard__thumb"
          widths={wide ? [320, 480, 640, 960] : [176, 264, 352]}
          sizes={wide ? '(min-width: 768px) 400px, 100vw' : '88px'}
          crop
        />
      )
    }
    <div class="ecard__titles">
      <p class="ecard__meta">
        {scaleYear && !fullDate ? <span class="ecard__year-only">{yearText} &middot; </span> : <span>{yearText} &middot; </span>}{placeShort(event.place, lang)}
      </p>
      <h3 class="ecard__title"><a href={href}>{event.title[lang]}</a></h3>
    </div>
  </div>

  <ul class="ecard__tags">
    <li><TagLabel lang={lang} label={event.label} /></li>
    {
      eventThreads.map((thread) => (
        <li>
          <ThreadChip
            lang={lang}
            name={thread.name}
            color={thread.color}
            description={thread.description[lang]}
            href={visibleThreadIds.has(thread.id) ? threadHref(lang, thread.slug[lang]) : undefined}
            quiet
          />
        </li>
      ))
    }
    {event.min_age !== 'all' && <li><AgeBadge lang={lang} age={event.min_age} /></li>}
    <li class="ecard__read"><ReadMark lang={lang} /></li>
    {
      event.sensitive && (
        <li>
          <span class="ecard__heavy">
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
              <path d="M10 2.5l8 14H2z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
              <path d="M10 8v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
              <circle cx="10" cy="14.2" r="1" fill="currentColor" />
            </svg>
            {t(lang, 'ui.heavy_topic')}
          </span>
        </li>
      )
    }
  </ul>

  {
    variant === 'feed' ? (
      <details class="ecard__layer" data-ecard={event.id}>
        <summary>
          <span class="ecard__hook" lang={textLang}>{event.hook[lang]}</span>
          <span class="visually-hidden"> ({t(lang, 'feed.expand_story')})</span>
          <svg class="ecard__chevron" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
            <path d="M3.5 6l4.5 4.5L12.5 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="ecard__story">
          <p lang={textLang}>{event.story[lang]}</p>
          <a class="button button--secondary" href={href}>{t(lang, 'ui.more')}</a>
        </div>
      </details>
    ) : (
      <p class="ecard__hook ecard__hook--plain" lang={textLang}>{event.hook[lang]}</p>
    )
  }
</article>

<style>
  .ecard {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border: var(--epoch-frame);
    border-radius: var(--radius-md);
    background: var(--epoch-surface);
    scroll-margin-block-start: var(--space-4);
  }

  /* A card with an epoch (thread pages): a stripe of the colour of the epoch on the left, the same width as the heavy bars. */
  .ecard--toned {
    border-inline-start: var(--border-heavy) solid var(--tone);
  }

  .ecard__head {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .ecard :global(.ecard__thumb) {
    flex: none;
    width: var(--size-thumb);
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-sm);
    background: var(--epoch-line);
  }

  .ecard__titles {
    min-width: 0;
  }

  .ecard__meta {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  /* A long title wraps inside the card instead of running out of it. */
  .ecard__title {
    font-size: var(--text-card-title);
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  /* Few pills: thread names are plain text with a dot; the credibility label and the age lose their fill and frame. */
  .ecard__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-4);
    list-style: none;
  }

  /* A bare year before the place only where there is no scale of years beside the card (the grid view). */
  :global(html:not([data-vista='grelha'])) .ecard__year-only {
    display: none;
  }

  /* Compact: the chips of a card are as tall as a small target, not a full touch target (the card itself is the large one). */
  .ecard__tags :global(.thread.thread--quiet),
  .ecard__tags :global(.tag),
  .ecard__tags :global(.age) {
    min-height: var(--chip-height-compact);
  }

  .ecard__tags :global(.tag),
  .ecard__tags :global(.age) {
    padding-inline: 0;
    border-color: transparent;
    background: transparent;
  }

  /* The "read" mark: the last place of the row, pushed to the end; it is always there (hidden), so nothing moves when it shows. */
  .ecard__read {
    margin-inline-start: auto;
  }

  .ecard__heavy {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--pad-chip-y) var(--pad-chip-x);
    border: 1px solid var(--color-heavy-border);
    border-radius: var(--radius-pill);
    background: var(--color-heavy-bg);
    color: var(--color-heavy-ink);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.5;
  }

  .ecard__hook {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--text-base);
    line-height: 1.35;
  }

  .ecard__hook--plain {
    max-width: var(--measure);
  }

  /* The hook is the opener of the story layer. */
  summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--chip-height-compact);
    padding-block: 0;
    cursor: pointer;
  }

  summary:focus-visible {
    outline-offset: var(--ring-offset);
  }

  .ecard__chevron {
    flex: none;
    margin-block-start: var(--space-1);
    color: var(--color-accent);
    transition: transform var(--transition);
  }

  details[open] .ecard__chevron {
    transform: rotate(180deg);
  }

  .ecard__story {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    max-width: var(--measure);
    padding-block-start: var(--space-2);
    border-block-start: 1px solid var(--epoch-line);
  }

  /* Grid tiles: picture on top, full width. */
  .ecard--grid {
    height: 100%;
  }

  .ecard--grid .ecard__head {
    flex-direction: column;
  }

  .ecard--grid :global(.ecard__thumb) {
    width: 100%;
    aspect-ratio: 1200 / 630;
  }
</style>

<script>
  // Opening a card in the feed puts #c-<id> in the address (replaceState: no extra history entries),
  // and a link with that hash opens the card. Without JavaScript the <details> still works.
  const cards = document.querySelectorAll<HTMLDetailsElement>('details[data-ecard]');

  if (cards.length > 0) {
    const openFromHash = () => {
      const match = location.hash.match(/^#c-(.+)$/);
      if (!match) return;
      const card = [...cards].find((d) => d.dataset.ecard === decodeURIComponent(match[1]!));
      if (card) card.open = true;
    };

    cards.forEach((card) => {
      card.addEventListener('toggle', () => {
        const hash = `#c-${card.dataset.ecard}`;
        let next = location.hash;
        if (card.open) next = hash;
        else if (location.hash === hash) next = '';
        if (next === location.hash) return;
        try {
          history.replaceState(history.state, '', location.pathname + location.search + next);
        } catch {
          // Some contexts forbid it; the card still opens.
        }
      });
    });

    window.addEventListener('hashchange', openFromHash);
    openFromHash();
  }
</script>
