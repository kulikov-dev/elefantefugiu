---
// "Bridge to today": the place that can be visited now. Order: the heading, the name (the name as written on the spot, small, only when it
// differs), the note (why to go there), the map, the address, then the button "Como chegar" and the links. "Como chegar" is a plain
// Google Maps link (the place's own link when the data has one, else directions to its coordinates; no API, no script; opens in a new tab); "Ver no mapa" leads to our own map page.
import { t } from '../i18n';
import { pagePath, type Lang } from '../i18n/routes';
import { bridgeDirectionsLink } from '../lib/directions';
import MiniMap from './MiniMap.astro';
import { mapLinkFor } from '../lib/map-data';
import type { LText } from '../lib/localize';

interface Props {
  lang: Lang;
  bridge: { name: string; title?: LText | undefined; address: string; lat: number; lon: number; maps_url?: string | undefined; url: string; note: LText };
  /** Id of the card: "See on the map" centres the map on it and opens its preview. */
  cardId: string;
  /** The marker of the big map for this story: a diamond for the main event of an epoch (importance 3), a circle otherwise. */
  kind: 'frame' | 'story';
  /** Language tag of the note when it differs from the page (placeholder filler is Latin). */
  textLang?: string | undefined;
}

const { lang, bridge, cardId, kind, textLang } = Astro.props;
const external = /^https?:\/\/\S+$/.test(bridge.url);
// Bold: the name in the language of the page (when the data has it); beneath it, small, the name as written on the spot.
const title = bridge.title?.[lang]?.trim() || bridge.name;
const portugueseName = title !== bridge.name ? bridge.name : undefined;
// The map page reads ?id= : it centres on that card and opens its preview.
const mapHref = mapLinkFor(pagePath(lang, 'map'), cardId);
---
<section class="bridge" aria-labelledby="bridge-title" data-bridge>
  <h2 id="bridge-title">{t(lang, 'ui.bridge')}</h2>
  <p class="bridge__name">{title}</p>
  {portugueseName && <p class="bridge__local" lang="pt">{portugueseName}</p>}
  <p class="bridge__note" lang={textLang}>{bridge.note[lang]}</p>
  <MiniMap lang={lang} cardId={cardId} point={bridge} name={title} kind={kind} />
  <address class="bridge__address">{bridge.address}</address>
  <p class="bridge__go">
    <a class="button" href={bridgeDirectionsLink(bridge)} target="_blank" rel="noopener" data-directions>
      {t(lang, 'ui.directions')}
    </a>
  </p>
  <ul class="bridge__links">
    <li><a href={mapHref}>{t(lang, 'ui.open_on_map')}</a></li>
    {external && <li><a href={bridge.url} rel="noopener">{t(lang, 'card.official_site')}</a></li>}
  </ul>
</section>

<style>
  .bridge {
    padding: var(--space-4);
    border: var(--epoch-frame);
    border-inline-start: var(--epoch-accent-bar);
    border-radius: var(--radius-md);
    background: var(--epoch-surface);
  }

  h2 {
    font-size: var(--text-xl);
  }

  .bridge__name {
    margin-block-start: var(--space-2);
    font-weight: var(--weight-strong);
  }

  /* The Portuguese name: small, so that the place can be found by its sign. */
  .bridge__local {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .bridge__address {
    margin-block-start: var(--space-2);
    font-style: normal;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .bridge__note {
    margin-block-start: var(--space-2);
    max-width: var(--measure);
  }

  /* One main action, "How to get there"; the map and the official site are plain links. */
  .bridge__go {
    margin-block-start: var(--space-3);
  }

  .bridge__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    list-style: none;
  }

  .bridge__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
  }
</style>
