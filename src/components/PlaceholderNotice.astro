---
// Prominent mark for cards with `placeholder: true` ("Test text").
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---
<p class="placeholder-notice" role="note">
  <strong>{t(lang, 'card.placeholder_title')}.</strong>{' '}{t(lang, 'card.placeholder_note')}
</p>

<style>
  .placeholder-notice {
    max-width: var(--measure);
    padding: var(--space-3) var(--space-4);
    border: var(--border-medium) dashed var(--color-notice-border);
    border-radius: var(--radius-md);
    background: var(--color-notice-bg);
    color: var(--color-notice-ink);
  }
</style>
