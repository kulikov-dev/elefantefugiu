---
// Footer: the full choice of theme (system, light, dark) as a radio group, for readers who did not find the header icon.
// Shown only with JavaScript; the choice is the same one the header button cycles (src/scripts/theme.ts).
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const options = [
  { value: 'system', label: t(lang, 'theme.system') },
  { value: 'light', label: t(lang, 'theme.light') },
  { value: 'dark', label: t(lang, 'theme.dark') },
] as const;
---
<div class="theme-choice" role="radiogroup" aria-label={t(lang, 'theme.label')} data-theme-choice>
  <span class="theme-choice__label" aria-hidden="true">{t(lang, 'theme.label')}</span>
  <div class="theme-choice__options">
    {
      options.map((option) => (
        <label class="theme-choice__option" data-value={option.value}>
          <input type="radio" name="theme" value={option.value} checked={option.value === 'system'} />
          <span>{option.label}</span>
        </label>
      ))
    }
  </div>
</div>
