---
// The map block: map, marker preview, "In this area" list. Shared by the map page and (later) epoch pages.
// Without JavaScript the block stays hidden; the page then shows its plain list of cards.
// Leaflet and its styles are loaded by an island script only when the block scrolls into view.
import '../styles/map.css';
import { pluralForms, t } from '../i18n';
import { LOCALES, type Lang } from '../i18n/routes';
import type { Bounds } from '../lib/markers';
import { safeJson, type MapCardInfo } from '../lib/map-cards';
import { MAINLAND_VIEW } from '../lib/map-data';
import type { TileConfig } from '../lib/tiles';

interface Props {
  lang: Lang;
  cards: MapCardInfo[];
  /** Thread id to name and colour, for the preview. */
  threads: Record<string, { name: string; color: string }>;
  /** Known filter values (used to read the address). */
  known: { threads: string[]; epochs: string[] };
  maxBounds: Bounds;
  view: Bounds;
  /** The whole country: the target of the "All of Portugal" button (a reset of the view). */
  home?: Bounds;
  tile: TileConfig;
  /** The map page also shows a place for the epoch timeline: a named slot under the map (the legend comes first). */
  /** 'page': the block owns ?fio= ?epoca= ?id= in the address. 'embedded': a parent page drives it with events. */
  mode?: 'page' | 'embedded';
}

const { lang, cards, threads, known, maxBounds, view, home = MAINLAND_VIEW, tile, mode = 'page' } = Astro.props;
const hasOverseas = cards.some((c) => c.overseas);

/** {one, few, other} of a plural key as `cluster_one`, `cluster_few`, ... */
const prefixed = (base: string, forms: Record<string, string>) => Object.fromEntries(Object.entries(forms).map(([k, v]) => [`${base}_${k}`, v]));

const config = {
  mode,
  cards,
  threads,
  known,
  maxBounds,
  view,
  home,
  tile: { url: tile.url, urlDark: tile.urlDark, attribution: tile.attribution },
  pluralLocale: LOCALES[lang],
  strings: {
    frame: t(lang, 'map.marker_frame'),
    story: t(lang, 'map.marker_story'),
    ...prefixed('cluster', pluralForms(lang, 'map.cluster')),
    ...prefixed('in_area', pluralForms(lang, 'map.in_area')),
    ...prefixed('overseas', pluralForms(lang, 'map.overseas')),
    zoom_in: t(lang, 'map.zoom_in'),
    zoom_out: t(lang, 'map.zoom_out'),
    locate: t(lang, 'map.locate'),
    locating: t(lang, 'map.locating'),
    geo_denied: t(lang, 'map.geo_denied'),
    geo_unavailable: t(lang, 'map.geo_unavailable'),
    geo_unsupported: t(lang, 'map.geo_unsupported'),
    geo_far: t(lang, 'map.geo_far'),
    here: t(lang, 'map.here'),
    home: t(lang, 'map.home'),
    world: t(lang, 'map.world'),
    tools_label: t(lang, 'map.tools_label'),
    dist_m: t(lang, 'map.dist_m'),
    dist_km: t(lang, 'map.dist_km'),
    dist_here: t(lang, 'map.dist_here'),
    list_open: t(lang, 'map.list_open'),
    list_close: t(lang, 'map.list_close'),
    thread_label: t(lang, 'card.tags'),
  },
};
---
<section class="map" data-map data-mode={mode} data-sheet="closed" aria-label={t(lang, 'map.map_label')} hidden>
  <script type="application/json" data-map-config set:html={safeJson(config)} />

  <div class="map__stage">
    <div class="map__canvas" data-map-canvas></div>
    <!-- The waiting state: a breathing tile of the epoch's pattern. It shows only when the map is still not ready after
         --wait-delay (CSS), so a fast connection never sees it. -->
    <div class="map__loading" data-map-loading role="status">
      <span class="map__wait-tile" aria-hidden="true"></span>
      <span class="map__wait-text">{t(lang, 'map.loading')}</span>
    </div>
    <p class="map__unavailable" data-map-unavailable hidden role="status">{t(lang, 'map.unavailable')}</p>

    <div class="map__actions">
      <button type="button" class="button button--secondary map__more" data-more hidden>{t(lang, 'ui.show_more')}</button>
    </div>

    <button type="button" class="button button--secondary map__overseas" data-overseas hidden>{t(lang, 'map.world')}</button>
    <p class="map__message" data-map-message role="status" hidden></p>

    <div class="map__preview" data-map-preview role="region" aria-labelledby="map-preview-title" tabindex="-1" hidden>
      <button type="button" class="map__preview-close" data-preview-close aria-label={t(lang, 'map.preview_close')}>
        <span aria-hidden="true">&times;</span>
      </button>
      <p class="map__preview-today">{t(lang, 'map.today_here')}</p>
      <p class="map__preview-bridge" data-preview-bridge-name></p>
      <p class="map__preview-address" data-preview-bridge-address></p>
      <h2 class="map__preview-title" id="map-preview-title" data-preview-title></h2>
      <ul class="map__preview-threads" data-preview-threads aria-label={t(lang, 'card.tags')}></ul>
      <p class="map__preview-hook" data-preview-hook></p>
      <div class="map__preview-actions">
        <a class="button" data-preview-open href="#">{t(lang, 'map.preview_open')}</a>
        <a class="button button--secondary" data-preview-directions href="#" target="_blank" rel="noopener">{t(lang, 'ui.directions')}</a>
      </div>
    </div>
  </div>


  <aside class="map__list" data-map-list aria-labelledby="map-list-title">
    <div class="map__list-head">
      <h2 class="map__list-title" id="map-list-title" tabindex="-1">
        {t(lang, 'map.list_title')}
        <span class="map__list-count" data-list-count aria-hidden="true"></span>
      </h2>
      <button type="button" class="map__sheet-toggle" data-sheet-toggle aria-expanded="false" aria-controls="map-list-body">
        {t(lang, 'map.list_open')}
      </button>
    </div>
    <div class="map__list-body" id="map-list-body" data-list-body>
      <ol class="map__items" data-list-items></ol>
      <p class="map__empty" data-list-empty hidden>{t(lang, 'map.list_empty')}</p>
    </div>
  </aside>

  <p class="visually-hidden" role="status" data-map-status></p>
</section>

<!-- Under the map, outside the block (the list sheet of a phone sits over the bottom of the block): the legend and, on the map page, the epoch timeline. -->
<div class="map-under" data-map-js hidden>
  <ul class="map__legend" aria-label={t(lang, 'map.legend_label')}>
    <li><span class="legend__mark legend__mark--frame" aria-hidden="true"></span>{t(lang, 'map.legend_frame')}</li>
    <li><span class="legend__mark legend__mark--story" aria-hidden="true"></span>{t(lang, 'map.legend_story')}</li>
    <li><span class="legend__mark legend__mark--cluster" aria-hidden="true"><span>3</span></span>{t(lang, 'map.legend_cluster')}</li>
    {hasOverseas && <li><span class="legend__mark legend__mark--place" aria-hidden="true"></span>{t(lang, 'map.legend_place')}</li>}
    <li data-legend-here hidden><span class="legend__mark legend__mark--here" aria-hidden="true"></span>{t(lang, 'map.legend_here')}</li>
  </ul>

  <slot name="under" />
</div>

<script>
  import '../scripts/map-loader';
</script>
