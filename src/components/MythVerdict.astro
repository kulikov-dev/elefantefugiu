---
// The verdict of a claim of "Myth or fact": a label in the style of the credibility labels (TagLabel): text plus a shape, never colour alone. Myth is terracotta, fact green, partly ochre (tokens `--color-verdict-*`, contrast checked in check-contrast.mjs); each has its own shape.
// The styles of `.verdict` are global (src/styles/layout.css): "Which came first?" makes the same label in the browser (src/scripts/answer-parts.ts).
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';
import type { MythVerdict } from '../data/schemas';
import { verdictIcon } from '../lib/verdict';

interface Props {
  lang: Lang;
  verdict: MythVerdict;
}

const { lang, verdict } = Astro.props;
---
<span class={`verdict verdict--${verdict}`}><Fragment set:html={verdictIcon(verdict)} />{t(lang, `myths.${verdict}`)}</span>
