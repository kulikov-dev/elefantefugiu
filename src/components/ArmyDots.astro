---
// "One against five" (docs/spec.md section 6): groups of dots in one scale, one dot is `unit_per_dot` people.
// Two groups. Filled dots are the number that is certain (`solid`), outlined dots the rest up to the lowest estimate (`min`);
// the highest estimate (`max`) is only in the text. One line under the drawing: the scale, the ratio, "sources differ".
// Colours of the two groups are the epoch's own (--epoch-primary, --epoch-alt). No script: the drawing is static.
import { plural, t } from '../i18n';
import baseCss from '../styles/viz-base.css?inline';
import ownCss from '../styles/viz-dots.css?inline';
import type { Lang } from '../i18n/routes';
import type { ArmyDotsData } from '../data/schemas';
import type { Localized } from '../lib/localize';
import { formatNumber, groupRatio, layoutDots, roundRatio, DOT_RADIUS } from '../lib/viz';

interface Props {
  lang: Lang;
  data: Localized<ArmyDotsData>;
  /** Language tag of the texts from the data when it differs from the page (placeholder filler is Latin). */
  textLang?: string | undefined;
}

const { lang, data, textLang } = Astro.props;
const unit = data.groups[0]!.unit_per_dot;
const { big, ratio } = groupRatio(data.groups);
const ratioInt = roundRatio(ratio);
const ratioText = plural(lang, 'viz.army_ratio', ratioInt, formatNumber(ratioInt, lang)).replace('{who}', big.ratio_label[lang]);
const scaleText = plural(lang, 'viz.army_scale', unit, formatNumber(unit, lang));
const summary = `${scaleText} ${ratioText} ${data.estimate_note[lang]}`;
const title = data.title?.[lang] ?? t(lang, 'viz.army_title');
// The description read by screen readers: every group with its note, then the line under the drawing.
const desc = [...data.groups.map((g) => `${g.label[lang]}: ${g.note[lang]}`), summary].join(' ');
---
<section class="viz" aria-labelledby="viz-title" data-interactive="army_dots" data-nosnippet>
  <!-- Styles travel with the component: only pages that render it get them (a <style> block of a component would join the stylesheet of every card page). -->
  <style is:inline set:html={baseCss + ownCss}></style>
  <h2 id="viz-title">{title}</h2>
  {data.placeholder && <p class="notice viz__test">{t(lang, 'viz.test_numbers')}</p>}
  <figure class="viz__figure" role="group" aria-label={title} aria-describedby="viz-desc">
    <p id="viz-desc" class="visually-hidden" lang={textLang}>{desc}</p>
    {
      data.groups.map((g, i) => {
        const layout = layoutDots(g);
        return (
          <div class={`dots__group dots__group--${i === 0 ? 'a' : 'b'}`} data-group={g.id} aria-hidden="true">
            <p class="dots__label" lang={textLang}>
              <strong>{g.label[lang]}</strong> {g.note[lang]}
            </p>
            <svg class="viz__svg" viewBox={`0 0 ${layout.width} ${layout.height}`} focusable="false">
              {layout.dots.map((dot) => (
                <circle class={`dot dot--${dot.kind}`} cx={dot.x} cy={dot.y} r={DOT_RADIUS} />
              ))}
            </svg>
          </div>
        );
      })
    }
    <figcaption class="viz__summary" lang={textLang} aria-hidden="true">{summary}</figcaption>
  </figure>
</section>
