---
// Previous / next links (cards in an epoch, neighbouring epochs). An item without href is a
// "coming soon" placeholder: plain text, not focusable. Between epochs the elephant may walk along the "next" link (mascot).
import Mascot from './Mascot.astro';
import type { Pose } from '../lib/mascot';
interface Item {
  /** Small line above the title, with the arrow. */
  dir: string;
  title: string;
  href?: string;
  /** Extra line for items that are not available yet. */
  note?: string;
  rel?: 'prev' | 'next';
}

interface Props {
  label: string;
  prev?: Item | null;
  next?: Item | null;
  /** A pose of the elephant that walks in above the "next" link; the page decides whether the mascot is allowed there. */
  mascot?: Pose | undefined;
}

const { label, prev, next, mascot } = Astro.props;
---
{
  (prev || next) && (
    <nav class:list={['pager', { 'pager--mascot': Boolean(mascot && next?.href) }]} aria-label={label}>
      {[prev, next].map((item, i) =>
        item ? (
          item.href ? (
            <a class:list={['pager__link', { 'pager__link--next': i === 1 }]} href={item.href} rel={item.rel}>
              {i === 1 && mascot && <Mascot pose={mascot} size="small" enter />}
              <span class="pager__dir">{item.dir}</span>
              <span class="pager__title">{item.title}</span>
            </a>
          ) : (
            <p class:list={['pager__link', 'pager__link--soon', { 'pager__link--next': i === 1 }]}>
              <span class="pager__dir">{item.dir}</span>
              <span class="pager__title">{item.title}</span>
              {item.note && <span class="pager__note">{item.note}</span>}
            </p>
          )
        ) : (
          <span />
        ),
      )}
    </nav>
  )
}

<style>
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--epoch-line);
  }

  .pager__link {
    display: flex;
    flex-direction: column;
    min-height: var(--touch-target-large);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--epoch-surface);
    text-decoration: none;
  }

  .pager__link--next {
    position: relative;
    text-align: end;
  }

  /* The elephant stands on the top edge of the "next" link; the nav leaves it room above. */
  .pager--mascot {
    padding-block-start: calc(var(--size-mascot-small) + var(--space-2));
  }

  .pager__link--next :global(.mascot) {
    position: absolute;
    inset-block-end: 100%;
    inset-inline-end: var(--space-3);
  }

  .pager__link--soon {
    border-style: dashed;
    color: var(--color-ink-muted);
  }

  .pager__dir,
  .pager__note {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .pager__title {
    font-weight: 600;
  }
</style>
