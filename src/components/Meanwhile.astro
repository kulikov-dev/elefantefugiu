---
// "Meanwhile": one well-known fact from elsewhere near the year of the story, after the text, before "I liked it" and "More" (src/lib/meanwhile.ts).
// The line of the page's own language (Russia, England / the USA, Brazil), else the world one. No line, no block. Works without JS.
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';
import { meanwhileYearText, type MeanwhileLine } from '../lib/meanwhile';

interface Props {
  lang: Lang;
  lines: MeanwhileLine[];
  /** Language tag of the texts when it differs from the page. */
  textLang?: string;
}

const { lang, lines, textLang } = Astro.props;
---
{
  lines.length > 0 && (
    <section class="meanwhile" aria-labelledby="meanwhile-title" data-meanwhile>
      <h2 class="meanwhile__title" id="meanwhile-title">{t(lang, 'card.meanwhile_title')}</h2>
      <ul class="meanwhile__list">
        {
          lines.map((line) => (
            <li data-scope={line.scope}>
              <span class="meanwhile__year">{line.label ?? meanwhileYearText(lang, line.year)}</span>
              <span class="meanwhile__text" lang={textLang}>{line.text}</span>
            </li>
          ))
        }
      </ul>
    </section>
  )
}

<style>
  .meanwhile {
    max-width: var(--measure);
  }

  /* A service label, small capitals like the other labels of the card, not a heading of the same weight as "The story". */
  .meanwhile .meanwhile__title {
    color: var(--color-ink-muted);
    font-family: var(--font-label);
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
    letter-spacing: var(--letter-label);
    text-transform: uppercase;
  }

  .meanwhile__list {
    margin-block-start: var(--space-1);
    list-style: none;
  }

  /* A row: the year of the event in a column as wide as the year (like the year in the feed of an epoch), then the text, a step smaller than the story. */
  .meanwhile__list > li {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: var(--space-3);
    font-size: var(--text-sm);
    font-style: normal;
  }

  .meanwhile__list > li + li {
    margin-block-start: var(--space-2);
  }

  .meanwhile__year {
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .meanwhile__text {
    overflow-wrap: anywhere;
  }
</style>
