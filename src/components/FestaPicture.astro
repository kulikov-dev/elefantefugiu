---
// The azulejo picture of a holiday (`image` of src/data/festas.yaml, a file of src/assets/festas/) in the header of its page, with a small caption and the note
// that an AI made it (the rule of the stories). The same pipeline as the pictures of the stories: WebP in several widths (srcset), width and height of the
// source, lazy unless the page says otherwise, so nothing shifts. The alt is the caption without the note.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  /** `image` of the holiday: a path inside src/assets/ (the other extension is tried too, as for the preview picture). */
  image: string;
  caption: string;
}

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/festas/*.{jpg,png}', { eager: true });

const { lang, image, caption } = Astro.props;
const other = image.endsWith('.jpg') ? image.replace(/\.jpg$/, '.png') : image.replace(/\.png$/, '.jpg');
const found = files[`../assets/${image}`] ?? files[`../assets/${other}`];
if (!found) throw new Error(`The picture "${image}" of a holiday is not in src/assets/`);
---
<figure class="festa-pic">
  <Image
    src={found.default}
    alt={caption}
    widths={[360, 480, 720, 960]}
    sizes="(min-width: 900px) 480px, calc(100vw - 32px)"
    format="webp"
    quality={80}
    loading="lazy"
    decoding="async"
    class="festa-pic__img"
  />
  <figcaption class="festa-pic__caption">{caption} {t(lang, 'festa.image_ai')}</figcaption>
</figure>
