---
// Shown before the story layer for cards with `sensitive: true`.
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---
<p class="heavy" role="note">
  <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
    <path d="M10 2.5l8 14H2z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
    <path d="M10 8v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    <circle cx="10" cy="14.2" r="1" fill="currentColor" />
  </svg>
  <span><strong>{t(lang, 'ui.heavy_topic')}.</strong> {t(lang, 'card.heavy_topic_note')}</span>
</p>

<style>
  .heavy {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    max-width: var(--measure);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-heavy-border);
    border-inline-start-width: var(--border-heavy);
    border-radius: var(--radius-md);
    background: var(--color-heavy-bg);
    color: var(--color-heavy-ink);
  }

  svg {
    flex: none;
    margin-block-start: var(--space-1);
  }
</style>
