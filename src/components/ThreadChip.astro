---
// A thread (theme) name with its colour dot. A link when the thread has a page, otherwise plain text.
// With `count` it shows the number of stories (the number is hidden from screen readers; they get the words).
import { plural } from '../i18n';
import type { Lang } from '../i18n/routes';
import { countVariants, type FamilyMode } from '../lib/family';
import type { LText } from '../lib/localize';

interface Props {
  lang: Lang;
  name: LText;
  color: string;
  /** Address of the thread page; leave out for threads that are hidden (too few cards). */
  href?: string;
  /** A number, or the three numbers of family mode (off, all, 12); the markup then carries one variant per distinct number. */
  count?: number | Record<FamilyMode, number>;
  /** Renders a filter button (script only) instead of a link; the value is the thread id, empty for "all". */
  filter?: string;
  /** Without the pill: the dot and the name only (cards in a list, where pills would pile up). */
  quiet?: boolean;
}

const { lang, name, color, href, count, filter, quiet = false } = Astro.props;
const isButton = filter !== undefined;
const Tag = isButton ? 'button' : href ? 'a' : 'span';
const variants = count === undefined ? [] : typeof count === 'number' ? [{ modes: ['off', 'all', '12'], value: count }] : countVariants(count);
---
<Tag
  class:list={['thread', { 'thread--link': Boolean(href) || isButton, 'thread--button': isButton, 'thread--quiet': quiet }]}
  style={`--thread-color: ${color}`}
  href={isButton ? undefined : href}
  type={isButton ? 'button' : undefined}
  aria-pressed={isButton ? 'false' : undefined}
  data-fio={isButton ? filter : undefined}
>
  <span class="thread__dot" aria-hidden="true"></span>
  {name[lang]}
  {
    variants.map((variant) => (
      <span class="fv" data-modes={variant.modes.join(' ')}>
        <span class="thread__count" aria-hidden="true">{variant.value}</span>
        <span class="visually-hidden">: {plural(lang, 'plural.stories', variant.value)}</span>
      </span>
    ))
  }
</Tag>

<style>
  .thread {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--pad-chip-y) var(--pad-chip-x);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--epoch-surface);
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
  }

  /* Links get a full-size touch target. */
  .thread--link {
    min-height: var(--touch-target);
    padding-inline: var(--pad-chip-x-wide);
  }

  .thread--link:hover {
    border-color: var(--thread-color);
    background: var(--color-surface-hover);
  }

  .thread--quiet,
  .thread--quiet:hover {
    padding-inline: 0;
    border-color: transparent;
    background: transparent;
  }

  .thread--quiet:hover {
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .thread--button {
    cursor: pointer;
  }

  .thread--button[aria-pressed='true'] {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .thread--button[aria-pressed='true'] .thread__count {
    background: var(--epoch-surface);
    color: var(--color-ink);
  }

  .thread__dot {
    width: var(--size-dot);
    height: var(--size-dot);
    border-radius: 50%;
    background: var(--thread-color);
  }

  .thread__count {
    min-width: var(--count-min-width);
    padding: 0 var(--pad-count);
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-surface);
    font-size: var(--text-sm);
    text-align: center;
  }
</style>
