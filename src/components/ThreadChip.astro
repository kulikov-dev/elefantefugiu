---
// A thread (theme) name with its colour dot. A link when the thread has a page, otherwise plain text.
// With `count` it shows the number of stories (the number is hidden from screen readers; they get the words).
import { plural } from '../i18n';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  name: { pt: string; en: string };
  color: string;
  /** Address of the thread page; leave out for threads that are hidden (too few cards). */
  href?: string;
  count?: number;
  /** Renders a filter button (script only) instead of a link; the value is the thread id, empty for "all". */
  filter?: string;
}

const { lang, name, color, href, count, filter } = Astro.props;
const isButton = filter !== undefined;
const Tag = isButton ? 'button' : href ? 'a' : 'span';
---
<Tag
  class:list={['thread', { 'thread--link': Boolean(href) || isButton, 'thread--button': isButton }]}
  style={`--thread-color: ${color}`}
  href={isButton ? undefined : href}
  type={isButton ? 'button' : undefined}
  aria-pressed={isButton ? 'false' : undefined}
  data-fio={isButton ? filter : undefined}
>
  <span class="thread__dot" aria-hidden="true"></span>
  {name[lang]}
  {
    count !== undefined && (
      <>
        <span class="thread__count" aria-hidden="true">{count}</span>
        <span class="visually-hidden">: {plural(lang, 'plural.stories', count)}</span>
      </>
    )
  }
</Tag>

<style>
  .thread {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.15rem 0.7rem 0.15rem 0.55rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
  }

  /* Links get a full-size touch target. */
  .thread--link {
    min-height: 2.75rem;
    padding-inline: 0.85rem;
  }

  .thread--link:hover {
    border-color: var(--thread-color);
    background: #f1f5f9;
  }

  .thread--button {
    font-family: inherit;
    cursor: pointer;
  }

  .thread--button[aria-pressed='true'] {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .thread--button[aria-pressed='true'] .thread__count {
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .thread__dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--thread-color);
  }

  .thread__count {
    min-width: 1.4rem;
    padding: 0 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-surface);
    font-size: var(--text-sm);
    text-align: center;
  }
</style>
