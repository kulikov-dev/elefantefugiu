---
// One picture of a card or an epoch, made by Astro: WebP in several widths (srcset), explicit width and height (those of the
// source: a small picture is never stretched), lazy unless the page says it is on the first screen. The crop of a card
// (object-position) comes from the data; the CSS of the place decides how the picture fills its box.
import { Image } from 'astro:assets';
import { pictureSource } from '../lib/picture-assets';
import type { Lang } from '../i18n/routes';
import type { PictureData } from '../lib/pictures';
import { STORY_IMAGE_CLASS } from '../lib/transitions';

interface Props {
  picture: PictureData;
  lang: Lang;
  widths: number[];
  sizes: string;
  /** "eager" only for the picture of the first screen (the story page). */
  loading?: 'lazy' | 'eager';
  class?: string;
  /** A picture inside a link that already has a name is decorative: its alt is empty. */
  decorative?: boolean;
  /** Use the crop point of the data (object-position). */
  crop?: boolean;
  /** WebP quality; teasers of other stories further down the page are lighter than the picture of the story itself. */
  quality?: number;
  /** view-transition-name of the picture of a story (src/lib/transitions.ts); the same name is on the main picture of the story page. */
  transitionName?: string | undefined;
}

const { picture, lang, widths, sizes, loading = 'lazy', class: className, decorative = false, crop = false, quality = 80, transitionName } = Astro.props;
const source = pictureSource(picture.file);
const style = [crop && picture.focus ? `object-position: ${picture.focus}` : '', transitionName ? `view-transition-name: ${transitionName}; view-transition-class: ${STORY_IMAGE_CLASS}` : ''].filter(Boolean).join('; ') || undefined;
---
<Image
  src={source}
  alt={decorative ? '' : picture.alt[lang]}
  widths={widths}
  sizes={sizes}
  format="webp"
  quality={quality}
  loading={loading}
  decoding="async"
  fetchpriority={loading === 'eager' ? 'high' : undefined}
  class={className}
  style={style}
/>
