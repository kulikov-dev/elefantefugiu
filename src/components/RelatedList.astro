---
// "Nearby": a short list of other cards.
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';
import ReadMark from './ReadMark.astro';
import NewMark from './NewMark.astro';

interface Props {
  lang: Lang;
  /** Heading id; must differ between the variants of one page. */
  headingId?: string;
  items: { id: string; title: string; href: string; meta: string; minAge: string; sensitive: boolean; published: string; epoch: string }[];
}

const { lang, items, headingId = 'related-title' } = Astro.props;
---
{
  items.length > 0 && (
    <section class="related" aria-labelledby={headingId}>
      <h2 id={headingId}>{t(lang, 'ui.nearby')}</h2>
      <ul>
        {
          items.map((item) => (
            <li data-min-age={item.minAge} data-sensitive={String(item.sensitive)} data-story={item.id} data-published={item.published} data-epoch={item.epoch}>
              <a href={item.href}>{item.title}</a>
              <span class="related__meta">{item.meta}</span>
              <span class="related__slot"><ReadMark lang={lang} /><NewMark lang={lang} /></span>
            </li>
          ))
        }
      </ul>
    </section>
  )
}

<style>
  h2 {
    font-size: var(--text-xl);
  }

  ul {
    margin-block-start: var(--space-2);
    list-style: none;
    border-block-start: 1px solid var(--epoch-line);
  }

  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-wrap) var(--space-4);
    padding-block: var(--space-3);
    border-block-end: 1px solid var(--epoch-line);
  }

  a {
    font-weight: 600;
  }

  /* The "read" tick and the mark "New" take the same place (a grid cell), so a row never changes its height. */
  .related__slot {
    display: inline-grid;
    margin-inline-start: auto;
  }

  .related__slot > :global(*) {
    grid-area: 1 / 1;
    justify-self: end;
  }

  .related__meta {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }
</style>
