---
// "Nearby": a short list of other cards.
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  /** Heading id; must differ between the variants of one page. */
  headingId?: string;
  items: { title: string; href: string; meta: string; minAge: string; sensitive: boolean }[];
}

const { lang, items, headingId = 'related-title' } = Astro.props;
---
{
  items.length > 0 && (
    <section class="related" aria-labelledby={headingId}>
      <h2 id={headingId}>{t(lang, 'ui.nearby')}</h2>
      <ul>
        {
          items.map((item) => (
            <li data-min-age={item.minAge} data-sensitive={String(item.sensitive)}>
              <a href={item.href}>{item.title}</a>
              <span class="related__meta">{item.meta}</span>
            </li>
          ))
        }
      </ul>
    </section>
  )
}

<style>
  h2 {
    font-size: var(--text-xl);
  }

  ul {
    margin-block-start: var(--space-2);
    list-style: none;
    border-block-start: 1px solid var(--epoch-line);
  }

  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 var(--space-4);
    padding-block: var(--space-3);
    border-block-end: 1px solid var(--epoch-line);
  }

  a {
    font-weight: 600;
  }

  .related__meta {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }
</style>
