---
// "Cut a slice": the bolo-rei of the page of Christmas. The cake is a button (a click, Enter or Space cuts the next slice), a speech bubble over the cut slice
// tells what it held, the hint with a little knife stands until the first cut, the line under the cake after the eighth. The whole cake is in the markup
// (the same drawing as on the home page, src/lib/bolo-rei.mjs), so without JavaScript it is a whole cake and the button stays switched off.
// The rules and the state are in src/lib/bolo-rei.mjs, the page is src/scripts/bolo-rei.ts.
import { cake } from '../lib/bolo-rei.mjs';
import type { FestaText } from '../data/schemas';

interface Props {
  text: NonNullable<FestaText['bolo']>;
}

const { text } = Astro.props;
const drawing = cake();
---
<div class="bolo" data-bolo={JSON.stringify(text)}>
  <div class="bolo__stage">
    <button class="bolo__cake" type="button" aria-label={text.aria} disabled>
      <svg class="festa-art" viewBox="0 0 400 240" aria-hidden="true" focusable="false"><Fragment set:html={drawing} /></svg>
    </button>
    <div class="bolo__bubble" role="status" aria-live="polite" hidden></div>
  </div>
  <p class="bolo__hint" hidden>
    <svg class="bolo__knife" viewBox="0 0 26 12" aria-hidden="true" focusable="false">
      <path d="M1 6 L15 2 L15 10 Z" fill="var(--festa-shell)" stroke="var(--festa-ink)" stroke-width="1.4" stroke-linejoin="round"></path>
      <rect x="15" y="3.5" width="10" height="5" rx="2" fill="var(--festa-ink)"></rect>
    </svg>
    {text.hint}
  </p>
  <p class="bolo__done" aria-live="polite"><span class="bolo__done-text"></span> <button class="bolo__again" type="button" hidden>{text.again}</button></p>
</div>
<script>
  import '../scripts/bolo-rei';
</script>
