---
// Age label: 12+ (or 16+, kept for the data). Cards for everyone carry no label (the data keeps min_age: all; callers skip the badge).
// 12+ has a tooltip and a hidden sentence with the reason; the data has no field for a reason, so it is the same sentence for every
// card (a card-specific reason would be added to the event schema).
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  age: '12' | '16';
}

const { lang, age } = Astro.props;
const reason = age === '12' ? t(lang, 'card.age_reason_12') : undefined;
---
<span class={`age age--${age}`} title={reason}>
  <span class="visually-hidden">{t(lang, 'card.age_prefix')} </span>
  {age}+
  {reason && <span class="visually-hidden"> ({reason})</span>}
</span>

<style>
  /* The same shape as the credibility label (TagLabel): a pill with a thin frame; the number carries the difference. */
  .age {
    display: inline-flex;
    align-items: center;
    padding: var(--pad-chip-y) var(--pad-chip-x);
    border: 1px solid var(--color-ink-muted);
    border-radius: var(--radius-pill);
    background: var(--epoch-surface);
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.5;
  }
</style>
