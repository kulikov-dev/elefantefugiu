---
// The three layers of a card: 1 hook, 2 story, 3 "More" (a <details>, works without JavaScript).
// A small script mirrors the layer state in the address hash: #historia, #detalhes.
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  hook: string;
  /** Language tag of the texts when it differs from the page (placeholder filler is Latin). */
  textLang?: string;
  /** The side column holds only the mini-map, which exists from 1024 px: on a phone the column is not there at all. */
  asideWideOnly?: boolean;
}

const { lang, hook, textLang, asideWideOnly = false } = Astro.props;
// The side column (a picture of the story, or the mini-map) exists only when something is put into it.
const hasAside = Astro.slots.has('aside');
---
<div class="layers" data-card-layers>
  <div class:list={['layers__top', { 'layers__top--aside': hasAside }]}>
    <div class="layers__main">
      <p class="hook" lang={textLang}>{hook}</p>

      <section id="historia" class="story" aria-labelledby="historia-title">
        <h2 id="historia-title">{t(lang, 'card.story_heading')}</h2>
        <div class="prose" lang={textLang}>
          <slot name="story" />
        </div>
      </section>

      <slot name="after" />
    </div>
    {
      hasAside && (
        <aside class:list={['layers__aside', { 'layers__aside--wide-only': asideWideOnly }]}>
          <slot name="aside" />
        </aside>
      )
    }
  </div>

  <slot name="below" />

  <details id="detalhes" class="more">
    <summary>
      <span>{t(lang, 'card.more_toggle')}</span>
      <svg class="more__chevron" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
        <path d="M3.5 6l4.5 4.5L12.5 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </summary>
    <div class="more__body">
      <slot name="more" />
    </div>
  </details>
</div>

<style>
  .layers > :global(* + *),
  .layers__main > :global(* + *) {
    margin-block-start: var(--space-5);
  }

  /* From 1024 px a side column to the right of the hook and the story, instead of an empty half of the page. On a phone the
     column (a picture) comes first, as the picture of a story always did. */
  .layers__top--aside {
    display: grid;
    gap: var(--space-5);
  }

  .layers__aside {
    grid-row: 1;
  }

  .layers__aside--wide-only {
    display: none;
  }

  @media (min-width: 64rem) {
    .layers__top--aside {
      grid-template-columns: minmax(0, 1fr) var(--card-aside-width);
      align-items: start;
    }

    .layers__aside--wide-only {
      display: block;
    }

    .layers__aside {
      grid-column: 2;
      grid-row: 1;
    }

    .layers__main {
      grid-column: 1;
      grid-row: 1;
    }
  }

  .hook {
    max-width: var(--measure);
    padding-inline-start: var(--space-4);
    border-inline-start: var(--epoch-accent-bar);
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-style: italic;
    line-height: 1.35;
  }

  .story h2 {
    margin-block-end: var(--space-2);
  }

  .more {
    border: var(--epoch-frame);
    border-radius: var(--radius-md);
    background: var(--epoch-surface);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--touch-target-large);
    padding: var(--space-2) var(--space-4);
    color: var(--color-accent);
    font-weight: 700;
    cursor: pointer;
  }

  summary:focus-visible {
    outline-offset: calc(var(--ring-width) * -1);
  }

  /* The state of the layer: the chevron turns up while "More" is open. */
  .more__chevron {
    flex: none;
    transition: transform var(--transition);
  }

  .more[open] .more__chevron {
    transform: rotate(180deg);
  }

  .more[open] > summary {
    border-block-end: 1px solid var(--epoch-line);
  }

  .more__body {
    padding: var(--space-4);
  }

  /* Slotted content carries the page's scope, not this component's, hence :global. */
  .more__body > :global(* + *) {
    margin-block-start: var(--space-5);
  }

  /* Wide screens (from about 1100 px): "Bridge to today" moves to a side column of the open layer. */
  @media (min-width: 68.75rem) {
    .more__body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--card-aside-width);
      column-gap: var(--space-5);
      align-items: start;
    }

    .more__body > :global(*) {
      grid-column: 1;
    }

    .more__body > :global(.bridge) {
      grid-column: 2;
      grid-row: 1 / span 4;
      margin-block-start: 0;
      position: sticky;
      inset-block-start: var(--space-4);
    }
  }
</style>

<script>
  // Layer state lives in the hash so a link can open a layer:
  //   #detalhes  -> "More" is open;   #historia (or no hash) -> only the story is shown.
  // The story is always open on a card page, so #historia is also a plain anchor to it.
  const more = document.getElementById('detalhes') as HTMLDetailsElement | null;

  if (more) {
    const apply = () => {
      if (location.hash === '#detalhes') more.open = true;
      else if (location.hash === '#historia') more.open = false;
    };

    // Keep the address in step with the layer; replaceState so the Back button is not filled with toggles.
    more.addEventListener('toggle', () => {
      let hash = location.hash;
      if (more.open) hash = '#detalhes';
      else if (hash === '#detalhes') hash = '';
      if (hash === location.hash) return;
      try {
        history.replaceState(history.state, '', location.pathname + location.search + hash);
      } catch {
        // Some contexts (for example file://) forbid it; the layer still works.
      }
    });

    window.addEventListener('hashchange', apply);
    apply();
  }
</script>
