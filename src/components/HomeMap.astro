---
// The small map on the home page: all the stories as points, the zoom buttons and nothing else. Without JavaScript only the
// caption stays: "13 places where it happened" and the link to the map page. The map code (Leaflet) is fetched only when the
// block comes near the screen (src/scripts/home-map-loader.ts), so it costs the first screen nothing.
import '../styles/home-map.css';
import { plural, t } from '../i18n';
import { pagePath, type Lang } from '../i18n/routes';
import { ageInfoOf, countByMode, countVariants, familyAttrs } from '../lib/family';
import { HOME_MAP_VIEW, mapMaxBounds } from '../lib/map-data';
import { safeJson } from '../lib/map-cards';
import type { TileConfig } from '../lib/tiles';
import type { EventData } from '../lib/events';
import { storyPath } from '../i18n/routes';

interface Props {
  lang: Lang;
  events: readonly EventData[];
  tile: TileConfig;
}

const { lang, events, tile } = Astro.props;
const counts = countByMode(events.map(ageInfoOf));
const config = {
  cards: events.map((e) => ({
    id: e.id,
    lat: e.bridge.lat,
    lon: e.bridge.lon,
    title: e.title[lang],
    href: storyPath(lang, e.slug[lang]),
    minAge: familyAttrs(e)['data-min-age'],
    sensitive: familyAttrs(e)['data-sensitive'] === 'true',
  })),
  maxBounds: mapMaxBounds(events.map((e) => e.bridge)),
  home: HOME_MAP_VIEW,
  tile: { url: tile.url, urlDark: tile.urlDark, attribution: tile.attribution },
  strings: { zoom_in: t(lang, 'map.zoom_in'), zoom_out: t(lang, 'map.zoom_out') },
};
---
<div class="home-map" data-home-map>
  <script type="application/json" data-home-map-config set:html={safeJson(config)} />
  <div class="home-map__canvas" data-home-map-canvas role="region" aria-label={t(lang, 'home.map_label')}></div>
  <p class="home-map__caption">
    <span class="home-map__count">
      {countVariants(counts).map((v) => <span class="fv" data-modes={v.modes.join(' ')}>{plural(lang, 'plural.places', v.value)}</span>)}
    </span>
    <a href={pagePath(lang, 'map')}>{t(lang, 'home.open_map')}</a>
  </p>
</div>

<script>
  import '../scripts/home-map-loader';
</script>
