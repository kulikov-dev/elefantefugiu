---
// A picture with its caption, on a card page. Two kinds:
//   main:   the picture of the story (right column from 1024 px, above the hook on a phone); whole, never wider than its own size;
//   detail: the second picture inside "More" (a document, a map, a portrait): the width of the text column, never cropped.
// The caption is in the language of the page; below it the author, the licence (a link for CC BY and CC BY-SA) and the source.
// A picture made by an AI says so in its caption, so only the caption is shown, no extra badge.
import Pic from './Pic.astro';
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';
import { authorText, sourceName, type PictureData } from '../lib/pictures';

interface Props {
  lang: Lang;
  picture: PictureData;
  kind: 'main' | 'detail';
  /** view-transition-name of the main picture: the name the picture of this story has in the lists (src/lib/transitions.ts). */
  transitionName?: string | undefined;
}

const { lang, picture, kind, transitionName } = Astro.props;
// The main picture fills the column beside the text from 1024 px: the row (container minus the text measure and the gap) up to
// 511 px at the widest, 100vw - 641 px on the way there; below 1024 px it fills the width of the page. The detail picture fills the text column.
const widths = kind === 'main' ? [320, 480, 680, 768, 960] : [480, 720, 1080, 1440];
// "Public domain" is said in the language of the page; the Creative Commons names are the same everywhere.
const license = picture.license === 'Public domain' ? t(lang, 'card.license_public_domain') : picture.license;
// 511 = --container (72 rem) minus the page padding (2 x --space-4), the text column (--measure, 65ch = 585 px) and the grid gap
// (--space-5); 641 = 585 + 24 + 32 (the same three, with the page padding of one 1024 px row). Change a token: change these two.
// Below 1024 px the main picture fills the text column (the page width less 2 x 16 px of padding and the 1 px border of the figure), 766 px at
// the widest (48 rem of the story column); the detail picture sits in the opened "More" (page width less 68 px), 720 px at the widest.
const sizes = kind === 'main' ? '(min-width: 1024px) min(511px, calc(100vw - 641px)), min(766px, calc(100vw - 34px))' : 'min(720px, calc(100vw - 68px))';
---
<figure class={`figure figure--${kind}`}>
  <Pic picture={picture} lang={lang} widths={widths} sizes={sizes} loading={kind === 'main' ? 'eager' : 'lazy'} class="figure__img" transitionName={kind === 'main' ? transitionName : undefined} />
  <figcaption>
    <span class="figure__caption">{picture.caption[lang]}</span>
    {
      !picture.ai && (
        <span class="figure__credit">
          {t(lang, 'card.image_credit')}: {authorText(picture, lang)} &middot; {t(lang, 'card.image_license')}:{' '}
          {picture.license_url ? <a href={picture.license_url} rel="license noopener">{license}</a> : license}
          {picture.source_url && (
            <>
              {' '}&middot; {t(lang, 'card.image_source')}: <a href={picture.source_url} rel="noopener">{sourceName(picture.source_url)}</a>
            </>
          )}
        </span>
      )
    }
  </figcaption>
</figure>

<style>
  .figure {
    max-width: var(--container-story);
    border: var(--epoch-frame);
    border-radius: var(--radius-md);
    background: var(--epoch-surface);
    overflow: hidden;
  }

  .figure :global(.figure__img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    background: var(--epoch-line);
  }

  /* The main picture fills its column (the file is larger than any column, so nothing is stretched). */
  .figure--main :global(.figure__img) {
    width: 100%;
  }

  /* The detail picture is a document, a map or a portrait: it is shown whole and centred, as tall as the token allows. */
  .figure--detail :global(.figure__img) {
    max-height: var(--detail-image-max-height);
    margin-inline: auto;
    object-fit: contain;
  }

  .figure figcaption {
    padding: var(--space-2) var(--space-3);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .figure__caption {
    display: block;
    color: var(--color-ink);
    font-size: var(--text-sm);
  }

  .figure__credit {
    display: block;
    margin-block-start: var(--space-1);
    font-size: var(--text-xs);
    overflow-wrap: anywhere;
  }
</style>
