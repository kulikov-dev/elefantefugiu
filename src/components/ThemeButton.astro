---
// Header button that cycles the theme: system, light, dark (docs/visual-direction.md section 2). The only theme control: the label
// for screen readers and the tooltip (title) both name the current mode.
// Shown only with JavaScript (CSS on html[data-js]); the icon follows html[data-theme], set before the first paint.
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---
<button type="button" class="theme-button" data-theme-toggle data-template={t(lang, 'theme.button')} aria-label={t(lang, 'theme.button').replace('{value}', t(lang, 'theme.system'))} title={t(lang, 'theme.button').replace('{value}', t(lang, 'theme.system'))}>
  <svg class="theme-button__icon theme-button__icon--system" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2" />
    <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" />
  </svg>
  <svg class="theme-button__icon theme-button__icon--light" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4.5" fill="currentColor" />
    <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
  </svg>
  <svg class="theme-button__icon theme-button__icon--dark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" fill="currentColor" />
  </svg>
  <span class="visually-hidden" role="status" data-theme-status data-template={t(lang, 'theme.status')}></span>
  <span hidden data-theme-name="system">{t(lang, 'theme.system')}</span>
  <span hidden data-theme-name="light">{t(lang, 'theme.light')}</span>
  <span hidden data-theme-name="dark">{t(lang, 'theme.dark')}</span>
</button>

<script>
  import '../scripts/theme';
</script>
