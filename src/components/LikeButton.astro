---
// "I liked it": a small text button under the text of a story, before "More", on the right edge of the text column (src/components/CardLayers.astro puts it there;
// src/scripts/like.ts, rules in src/lib/like.ts). No frame: an action like a link, in the colour of the links of the epoch, with a heart of 20 px drawn like the
// other icons of the site (a stroke, round ends). It starts hidden and the script shows it, so without JavaScript there is no button. A press sends one anonymous
// event to GoatCounter; the heart is then filled and the words are "Thanks!". Both pairs "heart + words" are in the page, one above the other in one grid cell: the
// button is as wide as the longer pair, the visible pair is pushed to the right edge with the heart right against its words, and pressing changes nothing in the
// size. There is no number on the page.
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  /** The id of the story: the same in every language, so the pages of a story add up in the counter. */
  id: string;
  /** The title of the story for the counter. */
  title: string;
}

const { lang, id, title } = Astro.props;
const heart = 'M10 16.6s-6.4-3.9-6.4-8.5a3.5 3.5 0 0 1 6.4-1.9 3.5 3.5 0 0 1 6.4 1.9c0 4.6-6.4 8.5-6.4 8.5z';
---
<button class="like" type="button" data-like={id} data-title={title} aria-pressed="false" hidden>
  <span class="like__pair like__ask">
    <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
      <path d={heart} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
    </svg>
    <span>{t(lang, 'ui.like')}</span>
  </span>
  <span class="like__pair like__thanks">
    <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
      <path d={heart} fill="currentColor" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
    </svg>
    <span>{t(lang, 'ui.like_thanks')}</span>
  </span>
</button>
<script>
  import '../scripts/like';
</script>

<style>
  .like {
    display: inline-grid;
    align-items: center;
    min-height: var(--touch-target);
    padding-inline: var(--space-2);
    border: 0;
    background: none;
    color: var(--color-accent);
    font: inherit;
    font-size: var(--text-base);
    white-space: nowrap;
    cursor: pointer;
  }

  .like:hover {
    color: var(--color-accent-strong);
    text-decoration: underline;
  }

  .like[hidden] {
    display: none;
  }

  /* The two pairs share one cell: the button keeps the width of the longer one, pressed or not; the visible pair sits on the right edge, the heart against its words. */
  .like__pair {
    display: inline-flex;
    grid-area: 1 / 1;
    justify-self: end;
    align-items: center;
    gap: var(--like-gap);
  }

  .like svg {
    flex: none;
  }

  .like[aria-pressed='false'] .like__thanks,
  .like[aria-pressed='true'] .like__ask {
    visibility: hidden;
  }
</style>
