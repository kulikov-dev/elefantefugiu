---
// Credibility label: documented / legend / debated. Never conveyed by colour alone: text plus a shape icon.
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  label: 'documented' | 'legend' | 'debated';
}

const { lang, label } = Astro.props;
---
<span class={`tag tag--${label}`}>
  <svg class="tag__icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
    {
      label === 'documented' ? (
        <>
          <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M5 8.3l2.2 2.2L11.2 5.8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </>
      ) : label === 'legend' ? (
        <path d="M8 1.5l1.6 4.9 4.9 1.6-4.9 1.6L8 14.5l-1.6-4.9L1.5 8l4.9-1.6z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
      ) : (
        <>
          <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M6.2 6.3a1.9 1.9 0 1 1 2.7 1.7c-.6.3-.9.7-.9 1.4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <circle cx="8" cy="11.6" r=".9" fill="currentColor" />
        </>
      )
    }
  </svg>
  {t(lang, `ui.label_${label}`)}
</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0.15rem 0.6rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.5;
  }

  .tag__icon {
    flex: none;
  }

  /* Text on tinted background: contrast above 7:1 for each pair. */
  .tag--documented {
    background: #e6f4ea;
    color: #14532d;
  }

  .tag--legend {
    background: #fdf0d5;
    color: #5c3b00;
  }

  .tag--debated {
    background: #f1e6f6;
    color: #522463;
  }
</style>
