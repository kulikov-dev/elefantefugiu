---
// "Next": a large card after the story that leads to the next story of the epoch, so that a reader who has just finished
// wants the following one. The hook of the next story is the invitation (large), its title is small beneath it.
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  href: string;
  hook: string;
  title: string;
  /** Language tag of the hook when it differs from the page (placeholder filler is Latin). */
  textLang?: string | undefined;
}

const { lang, href, hook, title, textLang } = Astro.props;
---
<a class="next-story" {href} rel="next">
  <span class="next-story__label">{t(lang, 'card.next_story')} <span aria-hidden="true">&rarr;</span></span>
  <span class="next-story__hook" lang={textLang}>{hook}</span>
  <span class="next-story__title">&mdash; {title}</span>
</a>

<style>
  .next-story {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: var(--measure);
    padding: var(--space-4);
    border: var(--epoch-frame);
    border-inline-start: var(--epoch-accent-bar);
    border-radius: var(--radius-md);
    background: var(--epoch-surface);
    color: var(--color-ink);
    text-decoration: none;
  }

  .next-story:hover {
    background: var(--color-surface-hover);
  }

  .next-story__label {
    color: var(--epoch-primary);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--letter-label);
  }

  .next-story__hook {
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-style: italic;
    line-height: 1.35;
  }

  .next-story__title {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }
</style>
