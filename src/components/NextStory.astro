---
// "Next": a large card after the story that leads to the next story of the epoch (at the end of an epoch, to the first story of the next one), so that a reader who has just finished
// wants the following one. The hook of the next story is the invitation (large), its title is small beneath it.
import { t } from '../i18n';
import type { Lang } from '../i18n/routes';
import Pic from './Pic.astro';
import type { PictureData } from '../lib/pictures';

interface Props {
  lang: Lang;
  href: string;
  hook: string;
  title: string;
  /** Language tag of the hook when it differs from the page (placeholder filler is Latin). */
  textLang?: string | undefined;
  /** The picture of the next story (or of its epoch): a reserved strip on top, cropped to its focus point. */
  picture?: PictureData | undefined;
  /** The label above the hook; "Next" by default, "Next era: <name>" at the end of an epoch. */
  label?: string | undefined;
}

const { lang, href, hook, title, textLang, picture, label } = Astro.props;
---
<a class="next-story" {href} rel="next">
  {
    picture && (
      <Pic picture={picture} lang={lang} class="next-story__image" widths={[240, 320, 400]} sizes="(min-width: 768px) 400px, 100vw" quality={70} decorative crop />
    )
  }
  <span class="next-story__body">
    <span class="next-story__label">{label ?? t(lang, 'card.next_story')} <span aria-hidden="true">&rarr;</span></span>
    <span class="next-story__hook" lang={textLang}>{hook}</span>
    <span class="next-story__title">&mdash; {title}</span>
  </span>
</a>

<style>
  .next-story {
    display: flex;
    flex-direction: column;
    max-width: var(--measure);
    overflow: hidden;
    border: var(--epoch-frame);
    border-inline-start: var(--epoch-accent-bar);
    border-radius: var(--radius-md);
    background: var(--epoch-surface);
    color: var(--color-ink);
    text-decoration: none;
  }

  .next-story__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
  }

  .next-story :global(.next-story__image) {
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 420;
    object-fit: cover;
    background: var(--epoch-line);
    filter: var(--image-filter);
  }

  .next-story:hover {
    background: var(--color-surface-hover);
  }

  .next-story__label {
    color: var(--epoch-primary);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--letter-label);
  }

  .next-story__hook {
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-style: italic;
    line-height: 1.35;
  }

  .next-story__title {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }
</style>
