---
import { pagePath, withBase, type Lang } from '../i18n/routes';
import { t } from '../i18n';
import { TELEGRAM_TEXT, TELEGRAM_URL } from '../lib/social';

const CONTENT_LICENSE = { pt: 'https://creativecommons.org/licenses/by-nc/4.0/deed.pt', en: 'https://creativecommons.org/licenses/by-nc/4.0/', ru: 'https://creativecommons.org/licenses/by-nc/4.0/deed.ru' } as const;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// "Texts and illustrations: {content}, ... Code: {code}." with the two names as links (the sentence is the translation's, the links are the site's).
const licenseParts = t(lang, 'footer.licenses').split(/(\{content\}|\{code\})/);

const links = [
  { label: t(lang, 'footer.about'), href: pagePath(lang, 'about') },
  { label: t(lang, 'footer.method'), href: pagePath(lang, 'method') },
  { label: t(lang, 'footer.report'), href: pagePath(lang, 'report') },
  { label: t(lang, 'footer.share'), href: pagePath(lang, 'share') },
  { label: t(lang, 'footer.games'), href: pagePath(lang, 'games') },
  { label: t(lang, 'footer.legal'), href: pagePath(lang, 'legal') },
  // The feed of the stories in this language (src/pages/[lang]/rss.xml.ts); the word is the same in every language.
  { label: 'RSS', href: withBase(`${lang}/rss.xml`) },
  // The Telegram channel is in Russian only: its link is on the Russian pages and nowhere else (scripts/check-telegram.mjs).
  ...(lang === 'ru' ? [{ label: TELEGRAM_TEXT.footer, href: TELEGRAM_URL, external: true }] : []),
];
---
<footer class="site-footer">
  <div class="container">
    <nav aria-label={t(lang, 'a11y.footer_nav')}>
      <ul class="site-footer__links">
        {links.map((link) => <li><a href={link.href} rel={'external' in link ? 'noopener' : undefined}>{link.label}</a></li>)}
      </ul>
    </nav>
    <p>
      {licenseParts.map((part) => (part === '{content}' ? <a href={CONTENT_LICENSE[lang]} rel="license noopener">CC BY-NC 4.0</a> : part === '{code}' ? 'MIT' : part))}
    </p>
    <p><a href={`${pagePath(lang, 'legal')}#cookies`}>{t(lang, 'footer.privacy')}</a></p>
    <p class="no-js-only">{t(lang, 'family.footer_hint')}</p>
  </div>
</footer>
