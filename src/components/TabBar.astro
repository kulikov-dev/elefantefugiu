---
import { EPOCHS_ANCHOR, pagePath, type Lang } from '../i18n/routes';
import { t } from '../i18n';

interface Props {
  lang: Lang;
  /** The tab of the section the page belongs to; none for the pages outside the five sections (a thread, a holiday, About, 404). */
  active?: 'home' | 'epochs' | 'map' | 'games' | 'surprise';
}

const { lang, active } = Astro.props;

// One simple line icon per tab (24 px grid, 1.75 stroke, round ends), drawn here: no library.
const tabs = [
  { key: 'home', href: pagePath(lang, 'home'), icon: 'M4 11.5 12 5l8 6.5M6.5 10v9h11v-9M10 19v-5h4v5' },
  { key: 'epochs', href: `${pagePath(lang, 'home')}#${EPOCHS_ANCHOR}`, icon: 'M5 10a2 2 0 1 0 0 4a2 2 0 1 0 0-4ZM12 10a2 2 0 1 0 0 4a2 2 0 1 0 0-4ZM19 10a2 2 0 1 0 0 4a2 2 0 1 0 0-4ZM7 12h3M14 12h3' },
  { key: 'map', href: pagePath(lang, 'map'), icon: 'M12 20s6-5.2 6-10a6 6 0 1 0-12 0c0 4.800 6 10 6 10ZM12 11.500a1.800 1.800 0 1 0 0-3.600 1.800 1.800 0 0 0 0 3.600Z' },
  { key: 'games', href: pagePath(lang, 'games'), icon: 'M12 3.500a8.500 8.500 0 1 0 0 17 8.500 8.500 0 0 0 0-17ZM9.500 9.500a2.600 2.600 0 1 1 3.800 2.300c-.9.500-1.300 1-1.300 1.900M12 16.800v.1' },
  { key: 'surprise', href: pagePath(lang, 'surprise'), icon: 'M12 3.500l2.100 5.400 5.400 2.100-5.400 2.100L12 18.500l-2.100-5.400L4.500 11l5.400-2.100Z' },
] as const;
---
<nav class="tabbar" aria-label={t(lang, 'a11y.tabbar')}>
  <ul>
    {
      tabs.map((tab) => (
        <li>
          <a href={tab.href} aria-current={tab.key === active ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d={tab.icon} />
            </svg>
            <span>{t(lang, `tabbar.${tab.key}`)}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
