---
// The invitation to the Telegram channel at the end of a story on the Russian pages (the channel is in Russian; the other languages do not show it). A plain link to
// t.me: no widget, no Telegram script, nothing loaded from Telegram until the reader follows the link.
import { TELEGRAM_TEXT, TELEGRAM_URL } from '../lib/social';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

void Astro.props.lang; // the block is Russian: the language is passed so the call site says where it belongs
---
<p class="telegram">
  <a href={TELEGRAM_URL} rel="noopener">
    <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
      <path d="M17.2 3.3 2.7 8.9c-.7.3-.7.8-.1 1l3.7 1.2 1.4 4.3c.2.5.3.7.7.7.4 0 .6-.2.8-.4l1.8-1.8 3.7 2.7c.7.4 1.2.2 1.4-.6l2.4-11.4c.3-1-.4-1.5-1.1-1.3zM7.2 10.9l7.4-4.6c.3-.2.6-.1.4.1l-6.1 5.5-.2 2.4z" fill="currentColor" />
    </svg>
    <span>{TELEGRAM_TEXT.block}</span>
  </a>
</p>

<style>
  .telegram {
    max-width: var(--measure);
  }

  .telegram a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    font-weight: 600;
  }

  .telegram svg {
    flex: none;
  }
</style>
