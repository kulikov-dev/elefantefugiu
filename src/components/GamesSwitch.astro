---
// The two games of the site side by side, at the top of both pages: "Myth or fact" | "Which came first?". The current one is marked with aria-current.
import { pagePath, type Lang } from '../i18n/routes';
import { t } from '../i18n';

interface Props {
  lang: Lang;
  active: 'myths' | 'order';
}

const { lang, active } = Astro.props;
const games = ['myths', 'order'] as const;
---
<nav class="games-switch" aria-label={t(lang, 'a11y.games')}>
  <ul>
    {
      games.map((key) => (
        <li>
          <a href={pagePath(lang, key)} aria-current={key === active ? 'page' : undefined}>{t(lang, `pages.${key}.title`)}</a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .games-switch ul {
    display: flex;
    width: max-content;
    max-width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    list-style: none;
  }

  .games-switch a {
    display: flex;
    align-items: center;
    min-height: var(--touch-target);
    padding-inline: var(--space-4);
    color: var(--color-ink);
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: var(--letter-label);
    text-decoration: none;
    text-transform: uppercase;
  }

  .games-switch a[aria-current='page'] {
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .games-switch a:not([aria-current]):hover {
    color: var(--color-accent);
  }
</style>
