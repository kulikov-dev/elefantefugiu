---
import { THEME_COLOR } from '../lib/theme';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { LANGS, pagePath, withBase, type Lang, type PageKey } from '../i18n/routes';
import { t } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  /** Page key keeps the language switch on the same page; omit for pages without a pair (404). */
  pageKey?: PageKey;
  /** Base-aware path of this page in each language. For pages that are not in ROUTES (cards). Overrides pageKey. */
  alternates?: Record<Lang, string>;
  /** Meta description; defaults to the site description. */
  description?: string;
  /** Open Graph / Twitter preview. Without `title` the page title is used. */
  preview?: {
    title?: string;
    type?: 'website' | 'article';
    /** Path inside public/ (no base). */
    image?: string;
    imageAlt?: string;
  };
  noindex?: boolean;
}

const { lang, title, pageKey, alternates: alternatesProp, description: descriptionProp, preview, noindex = false } = Astro.props;
const siteName = t(lang, 'site.name');
const fullTitle = pageKey === 'home' ? `${siteName} · ${t(lang, 'site.tagline')}` : `${title} · ${siteName}`;
const description = descriptionProp ?? t(lang, 'site.description');

const paths: Record<Lang, string> | undefined =
  alternatesProp ?? (pageKey ? { pt: pagePath('pt', pageKey), en: pagePath('en', pageKey) } : undefined);
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = paths ? absolute(paths[lang]) : undefined;
const image = preview?.image ? absolute(withBase(preview.image)) : undefined;
const OG_LOCALE: Record<Lang, string> = { pt: 'pt_PT', en: 'en_GB' };
const otherLang = LANGS.find((l) => l !== lang)!;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={THEME_COLOR} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    {canonical && <link rel="canonical" href={canonical} />}
    {paths && LANGS.map((target) => <link rel="alternate" hreflang={target} href={absolute(paths[target])} />)}
    {paths && <link rel="alternate" hreflang="x-default" href={absolute(paths.pt)} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={preview?.type ?? 'website'} />
    <meta property="og:title" content={preview?.title ?? fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {paths && <meta property="og:locale:alternate" content={OG_LOCALE[otherLang]} />}
    {image && <meta property="og:image" content={image} />}
    {image && preview?.imageAlt && <meta property="og:image:alt" content={preview.imageAlt} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={preview?.title ?? fullTitle} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    {image && preview?.imageAlt && <meta name="twitter:image:alt" content={preview.imageAlt} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'a11y.skip_to_content')}</a>
    <SiteHeader lang={lang} pageKey={pageKey} alternates={alternatesProp} />
    <main id="main" tabindex="-1">
      <div class="container page">
        <slot />
      </div>
    </main>
    <SiteFooter lang={lang} />
    <script is:inline>
      // Remember the chosen language for the root redirect. Storage may be unavailable.
      document.addEventListener('click', function (event) {
        var link = event.target instanceof Element ? event.target.closest('a[data-set-lang]') : null;
        if (!link) return;
        try {
          localStorage.setItem('lang', link.getAttribute('data-set-lang'));
        } catch (error) {}
      });
    </script>
  </body>
</html>
