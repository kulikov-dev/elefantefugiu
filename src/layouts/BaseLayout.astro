---
import { THEME_COLORS } from '../lib/theme';
import '../styles/global.css';
import FaviconLinks from '../components/FaviconLinks.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { LANGS, LOCALES, altPaths, pagePath, withBase, type Lang, type PageKey } from '../i18n/routes';
import { t } from '../i18n';
import { headScript } from '../lib/head-script';
import { azulejoRule } from '../lib/azulejo';
import { DEFAULT_PREVIEW, HOME_PREVIEW, ogImagePath } from '../lib/og';
import { ANALYTICS_CONFIG_SCRIPT, GOATCOUNTER_ENDPOINT, GOATCOUNTER_SCRIPT, analyticsEnabled } from '../lib/analytics';
import playfairLatin from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url';
import playfairCyrillic from '@fontsource-variable/playfair-display/files/playfair-display-cyrillic-wght-normal.woff2?url';
import serifLatin from '@fontsource/source-serif-4/files/source-serif-4-latin-400-normal.woff2?url';
import serifLatinItalic from '@fontsource/source-serif-4/files/source-serif-4-latin-400-italic.woff2?url';
import serifCyrillic from '@fontsource/source-serif-4/files/source-serif-4-cyrillic-400-normal.woff2?url';
import serifCyrillicItalic from '@fontsource/source-serif-4/files/source-serif-4-cyrillic-400-italic.woff2?url';
import oswaldLatin from '@fontsource/oswald/files/oswald-latin-600-normal.woff2?url';
import oswaldCyrillic from '@fontsource/oswald/files/oswald-cyrillic-600-normal.woff2?url';
import bussola from '../assets/azulejo/bussola.svg?url';
import canto from '../assets/azulejo/canto.svg?url';
import estrela from '../assets/azulejo/estrela.svg?url';
import no from '../assets/azulejo/no.svg?url';
import noV from '../assets/azulejo/no-v.svg?url';
import pegada from '../assets/azulejo/pegada.svg?url';
import pegadaV from '../assets/azulejo/pegada-v.svg?url';
import onda from '../assets/azulejo/onda.svg?url';
import ondaV from '../assets/azulejo/onda-v.svg?url';
import rombo from '../assets/azulejo/rombo.svg?url';
import rosa from '../assets/azulejo/rosa.svg?url';
import tapete from '../assets/azulejo/tapete.svg?url';
import xadrez from '../assets/azulejo/xadrez.svg?url';
import xadrezV from '../assets/azulejo/xadrez-v.svg?url';
import { loadSite } from '../lib/site-data';
import JsonLd from '../components/JsonLd.astro';
import { graph, type Node } from '../lib/schema';
import { schemaContext } from '../lib/schema-site';
import { speculationRules } from '../lib/transitions';
import { ageInfoOf, isVisibleInMode } from '../lib/family';

interface Props {
  lang: Lang;
  title: string;
  /** Page key keeps the language switch on the same page; omit for pages without a pair (404). */
  pageKey?: PageKey;
  /** Base-aware path of this page in each language. For pages that are not in ROUTES (cards). Overrides pageKey. */
  alternates?: Record<Lang, string>;
  /** Languages in which this page is really written; hreflang is given for those only (a card not ready in Russian leaves ru out). */
  readyLangs?: readonly Lang[];
  /** The page stands in for a language it is not written in (the Russian page of a card with English text): no hreflang at all. */
  stand_in?: boolean;
  /** Meta description; defaults to the site description. */
  description?: string;
  /** Open Graph / Twitter preview. Without `title` the page title is used. */
  preview?: {
    title?: string;
    type?: 'website' | 'article';
    /** Path inside public/ (no base): a provisional picture of an epoch that has no real one yet. */
    image?: string;
    /** Address of a picture made by Astro (src/lib/picture-assets.ts previewImageUrl), with the base path already in it. */
    imageUrl?: string;
    imageAlt?: string;
  };
  noindex?: boolean;
  /** The schema.org nodes of the page itself (src/lib/schema.ts); WebSite and Organization are added here. Pages with noindex get no markup. */
  schema?: Node[];
  /** Page visits are counted (GoatCounter, src/lib/analytics.ts). Off for the 404 page: it is not a page of the site. */
  count?: boolean;
  /** The 404 page: header, skip link and footer are given in every language; src/scripts/notfound.ts keeps the one of the address. Without JavaScript the default language shows. */
  allLangs?: boolean;
  /** Epoch id: puts <html data-epoch> so the palette of that epoch applies (epoch pages and the cards of the epoch). */
  epoch?: string;
}

const { lang, title, pageKey, alternates: alternatesProp, readyLangs = LANGS, stand_in = false, description: descriptionProp, preview, noindex = false, schema, epoch, count = true, allLangs = false } = Astro.props;
const chrome = allLangs ? LANGS : [lang];
// Fonts of the first screen are fetched together with the stylesheet, not after it (a browser finds a font only when the CSS is parsed and the
// text that uses it is laid out: 250-300 ms later on a phone). The Russian pages: their Cyrillic faces arrive late and the tags and the hook
// re-wrap (a layout jump of 0.17 on a phone); a Russian page also draws Latin letters (the name of the site, names of places), so the Latin
// faces of the heading and the label follow. The Portuguese and English pages: the three faces that make the first screen, the heading
// (Playfair), the text (Source Serif 400) and the labels and tabs (Oswald 600); the italic and bold faces stay late (they only swap in).
const fontFiles = lang === 'ru' ? [playfairCyrillic, serifCyrillic, serifCyrillicItalic, oswaldCyrillic, playfairLatin, oswaldLatin] : [playfairLatin, serifLatin, oswaldLatin];
const counting = count && analyticsEnabled(String(Astro.site ?? ''));
const siteName = t(lang, 'site.name');
const fullTitle = pageKey === 'home' ? `${siteName} · ${t(lang, 'site.tagline')}` : `${title} · ${siteName}`;
// The service pages have a description of their own (pages.<key>.description); every other page without one uses the site description.
const DESCRIBED_PAGES = ['about', 'method', 'legal', 'report', 'map', 'surprise'];
const pageDescription = pageKey && DESCRIBED_PAGES.includes(pageKey) ? t(lang, `pages.${pageKey}.description`) : undefined;
const description = descriptionProp ?? pageDescription ?? t(lang, 'site.description');

const paths: Record<Lang, string> | undefined =
  alternatesProp ?? (pageKey ? altPaths((l) => pagePath(l, pageKey)) : undefined);
// hreflang: the ready languages, and only when the page itself is written in its language.
const hreflangs = stand_in ? [] : LANGS.filter((l) => readyLangs.includes(l));
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = paths ? absolute(paths[lang]) : undefined;
// A page without a picture of its own (About, Method, Legal, Map, ...) gets the plain site picture; cards, epochs, threads and the home page pass theirs.
const previewPath = preview?.image ?? DEFAULT_PREVIEW;
const image = preview?.imageUrl ? absolute(preview.imageUrl) : absolute(withBase(ogImagePath(previewPath)));
// What the preview picture shows, for og:image:alt and twitter:image:alt: the page gives it when it has a picture of its own (a card, an epoch);
// the pictures of the site that have no picture of their own are three: the home page (the mascot), a thread (its pattern), the rest (the pattern).
const previewAlt =
  preview?.imageAlt ??
  (preview?.imageUrl
    ? undefined
    : previewPath === HOME_PREVIEW
      ? t(lang, 'site.preview_alt_home')
      : previewPath === DEFAULT_PREVIEW
        ? t(lang, 'site.preview_alt_page')
        : /^images\/og\/fio-/.test(previewPath)
          ? t(lang, 'site.preview_alt_thread')
          : undefined);
// Thread ids the head script may put on <html data-fio> (the epoch page filter reads them before the first paint).
const { threads: allThreads, events: allEvents } = await loadSite();
// "New since your last visit": the day of the earliest story of every epoch for each family mode, so a page can tell a new epoch (all its stories are
// new) from an epoch with some new stories (src/scripts/new-marks.ts).
const epochFirsts: Record<string, Record<string, string>> = {};
for (const e of allEvents) {
  for (const mode of ['off', 'all', '12'] as const) {
    if (!isVisibleInMode(ageInfoOf(e), mode)) continue;
    const byMode = (epochFirsts[e.epoch] ??= {});
    if (byMode[mode] === undefined || e.published < byMode[mode]) byMode[mode] = e.published;
  }
}
const azulejoCss = azulejoRule({ bussola, canto, estrela, no, 'no-v': noV, onda, 'onda-v': ondaV, pegada, 'pegada-v': pegadaV, rombo, rosa, tapete, xadrez, 'xadrez-v': xadrezV }, epoch);
// Structured data: on every indexable page (not on noindex pages and not on the 404 page).
const jsonLd = noindex || allLangs ? undefined : graph(schemaContext(lang, Astro.site), schema ?? []);
// Prefetch (never prerender) of the internal pages a reader points at or touches; see src/lib/transitions.ts. The base path is the one of the site.
const speculation = JSON.stringify(speculationRules(withBase().slice(0, -1)));
const OG_LOCALE = (l: Lang) => LOCALES[l].replace('-', '_');
---
<!doctype html>
<html lang={lang} data-epoch={epoch}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={THEME_COLORS.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={THEME_COLORS.dark} media="(prefers-color-scheme: dark)" />
    <!-- Before the first paint: data-js, data-family, data-theme, data-vista, data-fio on <html> (no flash of the wrong state).
         After the theme-color tags: with an explicit theme it sets them. -->
    <script is:inline set:html={headScript(allThreads.map((th) => th.id))} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <FaviconLinks />
    <!-- The fonts of the first screen are fetched with the stylesheet, not after it, so the lines of the title and the tags do not break
         differently when a font arrives. The same files the @font-face rules of fonts.css name. -->
    {fontFiles.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    {canonical && <link rel="canonical" href={canonical} />}
    {paths && hreflangs.map((target) => <link rel="alternate" hreflang={target} href={absolute(paths[target])} />)}
    {paths && hreflangs.length > 0 && <link rel="alternate" hreflang="x-default" href={absolute(paths.pt)} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={preview?.type ?? 'website'} />
    <meta property="og:title" content={preview?.title ?? fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={OG_LOCALE(lang)} />
    {paths && hreflangs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE(l)} />)}
    {image && <meta property="og:image" content={image} />}
    {image && previewAlt && <meta property="og:image:alt" content={previewAlt} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={preview?.title ?? fullTitle} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    {image && previewAlt && <meta name="twitter:image:alt" content={previewAlt} />}
    <!-- Azulejo masks: the pattern of this epoch and the corner (addresses come from the imports, so the base path holds). -->
    <style is:inline set:html={azulejoCss} />
    {jsonLd && <JsonLd data={jsonLd} />}
    <slot name="head" />
    <script type="speculationrules" is:inline set:html={speculation} />
    {counting && <script is:inline set:html={ANALYTICS_CONFIG_SCRIPT} />}
    {counting && <script is:inline async data-goatcounter={GOATCOUNTER_ENDPOINT} src={withBase(GOATCOUNTER_SCRIPT)}></script>}
  </head>
  <body>
    {
      chrome.map((l) => (
        <div class="lang-block" data-notfound-lang={allLangs ? l : undefined} lang={allLangs ? l : undefined} hidden={allLangs && l !== lang}>
          <a class="skip-link" href="#main">{t(l, 'a11y.skip_to_content')}</a>
          <SiteHeader lang={l} pageKey={pageKey} alternates={alternatesProp} />
        </div>
      ))
    }
    <main id="main" tabindex="-1">
      <div class="container page">
        <slot />
      </div>
    </main>
    {
      chrome.map((l) => (
        <div class="lang-block" data-notfound-lang={allLangs ? l : undefined} lang={allLangs ? l : undefined} hidden={allLangs && l !== lang}>
          <SiteFooter lang={l} />
        </div>
      ))
    }
    <script>import '../scripts/email';</script>
    <script>import '../scripts/scroll-fade';</script>
    <script>import '../scripts/read-marks';</script>
    <script type="application/json" data-epoch-firsts set:html={JSON.stringify(epochFirsts)} />
    <script>import '../scripts/new-marks';</script>
    <slot name="end" />
    {epoch && <script>import '../scripts/last-epoch';</script>}
    <script is:inline>
      // Remember the chosen language for the root redirect. Storage may be unavailable.
      document.addEventListener('click', function (event) {
        var link = event.target instanceof Element ? event.target.closest('a[data-set-lang]') : null;
        if (!link) return;
        try {
          localStorage.setItem('lang', link.getAttribute('data-set-lang'));
        } catch (error) {}
      });
    </script>
  </body>
</html>
