---
// The cabinet of rarities: /pt/gabinete/, /en/cabinet/, /ru/kabinet/ (docs/spec.md "Кабинет редкостей"). A shelf for every epoch that has rarities (the board in the colour of the epoch,
// the tiles in the middle, the captions under the board like the labels of a museum); a found rarity is its thumbnail in a frame, a missing one a dashed silhouette; the tin of
// sardines on top. What is found is in this browser only (localStorage `cabinet.v1`): the page is built the same for everyone and src/scripts/cabinet.ts fills it in.
// While the cabinet is closed (src/lib/cabinet-config.mjs) the page is built too, but noindex and linked from nowhere; the preview of the owner shows a note on top.
import BaseLayout from '../layouts/BaseLayout.astro';
import { GAME_OG, gamePicture } from '../lib/games-images';
import { pagePath, withBase, type Lang } from '../i18n/routes';
import { section, t } from '../i18n';
import { epochHasContent } from '../lib/epochs';
import { CABINET_SHELF_SIZE } from '../data/schemas';
import { tinHtml } from '../lib/cabinet-art';
import { SARDINES } from '../lib/cabinet';
import { cabinetItems, partyHref } from '../lib/cabinet-data';
import { pageNodes } from '../lib/schema';
import { schemaContext } from '../lib/schema-site';
import { loadSite } from '../lib/site-data';
import '../styles/cabinet.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const site = await loadSite();
const title = t(lang, 'pages.cabinet.title');

// The shelves: the epochs that have rarities on the site, in the order of the epochs; the tiles by their place on the shelf.
const shelves = site.epochs
  .filter((epoch) => epochHasContent(epoch, site.events))
  .map((epoch) => ({ epoch, items: site.cabinet.filter((i) => i.item.epoch === epoch.id).sort((a, b) => a.item.shelf - b.item.shelf).slice(0, CABINET_SHELF_SIZE) }))
  .filter((shelf) => shelf.items.length > 0);
const all = shelves.flatMap((s) => s.items);
const data = cabinetItems(site, lang);
const strings = section(lang, 'cabinet');
// The line of the finished cabinet leads to the holiday of the sardines when its page exists in this language.
const party = partyHref(lang);
const fill = (text: string, vars: Record<string, string | number>): string => Object.entries(vars).reduce((s, [k, v]) => s.replaceAll(`{${k}}`, String(v)), text);

// The preview picture of the page is the picture of its card in the hub of the games (docs/images/cabinet/hub.jpg).
const collage = gamePicture('cabinet')?.og;
const schemaCtx = schemaContext(lang, Astro.site);
const schema = pageNodes(schemaCtx, { url: schemaCtx.abs(pagePath(lang, 'cabinet')), name: title, description: t(lang, 'pages.cabinet.description'), type: 'WebPage' });
---
<BaseLayout
  lang={lang}
  pageKey="cabinet"
  title={title}
  description={t(lang, 'pages.cabinet.description')}
  noindex={!site.cabinetOpen}
  schema={schema}
  preview={{ title: t(lang, 'games.cabinet_og_title'), description: t(lang, 'games.cabinet_og_description'), ...(collage ? { imageUrl: withBase(collage), imageSize: GAME_OG, imageAlt: t(lang, 'games.cabinet_og_title') } : {}) }}
>
  <article class="cabinet" data-cabinet-page data-total={all.length} data-sardines={SARDINES}>
    <p class="cabinet__preview" data-preview-note hidden>{strings.preview}</p>
    <div class="cabinet__head">
      <h1>{title}</h1>
      <p data-found-line>{fill(strings.found!, { n: 0, m: all.length })}</p>
      <button class="cabinet__tin" type="button" data-tin aria-label={fill(strings.tin_label!, { n: 0 })} aria-describedby="cabinet-tin-tip">
        <span data-tin-art set:html={tinHtml(0)} />
        <span class="cabinet__tin-count" data-tin-count>{fill(strings.tin_count!, { n: 0 })}</span>
      </button>
      <span id="cabinet-tin-tip" class="visually-hidden">{strings.tin_tip}</span>
    </div>
    <p class="cabinet__lead">{strings.lead}</p>
    <div class="cabinet__party" data-party>
      <svg data-bunting role="img" aria-label={strings.party_garland}></svg>
      <p class="cabinet__party-title">{strings.party_title}</p>
      <p>{strings.party_text}{party && <> <a href={party}>{strings.party_link}</a></>}</p>
    </div>
    <p class="cabinet__no-js">{strings.no_js}</p>
    <div class="cabinet__shelves" data-shelves>
      {
        shelves.map(({ epoch, items }) => (
          <section class="shelf" data-shelf style={`--ep: var(--tone-${epoch.id}); --n: ${items.length}`} aria-labelledby={`shelf-${epoch.id}`}>
            <div class="shelf__in">
              <h2 id={`shelf-${epoch.id}`}>
                {epoch.name[lang]}
                <span data-shelf-count data-of={items.length}>{fill(strings.shelf_count!, { n: 0, m: items.length })}</span>
              </h2>
              <div class="shelf__objs">
                {items.map(({ item, age }) => (
                  <button class="cab-obj" type="button" data-item={item.id} data-min-age={String(age.minAge)} data-sensitive={String(age.sensitive)} aria-label={strings.unknown_label} aria-haspopup="dialog">
                    {data[item.id]!.image ? <img src={data[item.id]!.image!} alt="" loading="lazy" /> : <svg class="cab-obj__stub" viewBox="0 0 64 64" aria-hidden="true"><rect x="12" y="12" width="40" height="40" /><path d="M12 32h40M32 12v40" /><circle cx="32" cy="32" r="8" /></svg>}
                  </button>
                ))}
              </div>
              <div class="shelf__board"></div>
              <div class="shelf__labels">
                {items.map(({ item }) => <span data-label={item.id} data-unknown>{strings.unknown}</span>)}
              </div>
            </div>
          </section>
        ))
      }
    </div>
    <p class="cabinet__empty" data-empty hidden>{strings.empty}</p>
    <p class="cabinet__soon">{strings.soon}</p>
    <script type="application/json" data-cabinet-data set:html={JSON.stringify({ strings, items: data, partyHref: party }).replace(/</g, '\\u003c')} />
  </article>
</BaseLayout>
