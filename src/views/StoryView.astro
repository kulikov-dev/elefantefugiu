---
// Card page (event or story): /pt/historia/{slug} and /en/story/{slug} (docs/spec.md sections 2 and 5.3).
// Rendered by src/pages/[lang]/[segment]/[slug].astro, which owns the routes.
import BaseLayout from '../layouts/BaseLayout.astro';
import AgeBadge from '../components/AgeBadge.astro';
import BridgeBlock from '../components/BridgeBlock.astro';
import ArmyDots from '../components/ArmyDots.astro';
import CardLayers from '../components/CardLayers.astro';
import ShipScale from '../components/ShipScale.astro';
import HeavyTopicBanner from '../components/HeavyTopicBanner.astro';
import MiniMap from '../components/MiniMap.astro';
import NextStory from '../components/NextStory.astro';
import PagerNav from '../components/PagerNav.astro';
import PlaceholderNotice from '../components/PlaceholderNotice.astro';
import RelatedList from '../components/RelatedList.astro';
import ReportLink from '../components/ReportLink.astro';
import ShareButton from '../components/ShareButton.astro';
import SourceList from '../components/SourceList.astro';
import TagLabel from '../components/TagLabel.astro';
import ThreadChip from '../components/ThreadChip.astro';
import { LANGS, LOCALES, altPaths, epochHref, pagePath, storyPath, threadHref, withBase, type Lang } from '../i18n/routes';
import { t } from '../i18n';
import { cardNeighbours, firstSentence, formatDate, formatYear, isFlashMoment, isRuStandIn, nearbyCards, textLangOf, type EventData } from '../lib/events';
import { distanceParts } from '../lib/distance';
import { epochHasContent } from '../lib/epochs';
import { ageInfoOf, familyAttrs, gateReason, groupVariants, hiddenModes, isVisibleInMode } from '../lib/family';
import { loadSite } from '../lib/site-data';

interface Props {
  lang: Lang;
  event: EventData;
}

const { lang, event } = Astro.props;

const site = await loadSite();
const all = site.events;
const epoch = site.epochs.find((e) => e.id === event.epoch);
if (!epoch) throw new Error(`Event "${event.id}" has an unknown epoch "${event.epoch}"`);
// The epoch crumb is a link only when the epoch has a page.
const epochLink = epochHasContent(epoch, all) ? epochHref(lang, epoch.slug[lang]) : undefined;

const title = event.title[lang];
const alternates = altPaths((l) => storyPath(l, event.slug[l]));
const cardUrl = new URL(alternates[lang], Astro.site).href;
const description = firstSentence(event.story[lang]);

// Preview picture: own image, else the epoch fallback. Sensitive cards never use their own image in previews.
const useOwnImage = Boolean(event.image) && !event.sensitive;
const previewImage = useOwnImage ? event.image!.src : epoch.fallback_image;
const previewImageAlt = useOwnImage ? event.image!.alt[lang] : undefined;

// Family mode: "Nearby" and previous / next never lead to a card the mode hides, so each is computed for the three
// modes and the markup holds one block per distinct result (CSS shows the block of the current mode).
const allowedIn = (mode: Parameters<typeof isVisibleInMode>[1]) => (e: EventData) => isVisibleInMode(ageInfoOf(e), mode);
// "Nearby": distance to each story, "800 m" under a kilometre (to 10 m), else kilometres with one decimal.
const numberFormat = new Intl.NumberFormat(LOCALES[lang], { maximumFractionDigits: 1 });
const distanceText = (km: number): string => {
  const d = distanceParts(km);
  if (d.kind === 'here') return t(lang, 'card.nearby_same');
  return t(lang, d.kind === 'm' ? 'card.nearby_m' : 'card.nearby_km').replace('{n}', numberFormat.format(d.n));
};
const relatedVariants = groupVariants(
  (mode) =>
    nearbyCards(event, all, { allowed: allowedIn(mode) }).map(({ event: e, km }) => ({
      id: e.id,
      title: e.title[lang],
      href: storyPath(lang, e.slug[lang]),
      meta: `${formatYear(e, lang)} · ${distanceText(km)}`,
      minAge: familyAttrs(e)['data-min-age'],
      sensitive: familyAttrs(e)['data-sensitive'] === 'true',
    })),
  (items) => items.map((i) => i.id).join('|'),
);
const pagerVariants = groupVariants(
  (mode) => cardNeighbours(event, all, allowedIn(mode)),
  ({ prev, next }) => `${prev?.id ?? ''}|${next?.id ?? ''}`,
);

// Intermediate screen: the modes that hide this card, and the text of each (age and/or heavy topic).
const gateModes = hiddenModes(ageInfoOf(event));
const gateVariants = groupVariants(
  (mode) => {
    const reason = gateReason(ageInfoOf(event), mode);
    const parts = [reason.age === '12' ? t(lang, 'gate.age_12') : reason.age === '16' ? t(lang, 'gate.age_16') : '', reason.heavy ? t(lang, 'gate.heavy') : ''];
    return parts.some(Boolean) ? `${parts.filter(Boolean).join(' ')} ${t(lang, 'gate.question')}` : '';
  },
  (text) => text,
).filter((v) => v.value !== '');
const backHref = epochLink ?? pagePath(lang, 'home');

const eventThreads = event.threads.map((id) => site.threads.find((th) => th.id === id)).filter((th) => th !== undefined);
// Placeholder text is Latin filler: mark it, so screen readers do not read it as Portuguese.
const textLang = textLangOf(event, lang);
const standIn = isRuStandIn(event, lang);
// hreflang names the languages the card is written in; a card without Russian leaves ru out.
const readyLangs = LANGS.filter((l) => l !== 'ru' || event.ru_ready);
---
<BaseLayout
  lang={lang}
  title={title}
  alternates={alternates}
  description={description}
  preview={{ title: event.hook[lang], type: 'article', image: previewImage, imageAlt: previewImageAlt }}
  noindex={event.placeholder || standIn}
  readyLangs={readyLangs}
  stand_in={standIn}
  epoch={epoch.id}
>
  <article class="card" data-flash={isFlashMoment(event) ? '' : undefined} data-gate-modes={gateModes.length > 0 ? gateModes.join(' ') : undefined}>
    <nav class="crumbs" aria-label={t(lang, 'card.breadcrumb')}>
      <ol>
        <li>{epochLink ? <a href={epochLink}>{epoch.name[lang]}</a> : <span class="crumbs__text">{epoch.name[lang]}</span>}</li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>

    {standIn && <p class="notice" role="note" data-not-translated>{t(lang, 'card.not_translated')}</p>}
    {event.placeholder && <PlaceholderNotice lang={lang} />}

    <header class="card__header">
      <h1>{title}</h1>
      <p class="card__meta">
        <span>{formatYear(event, lang)}</span>
        <span aria-hidden="true"> &middot; </span>
        <span>{event.place.name}</span>
      </p>
      <ul class="tags gated" aria-label={t(lang, 'card.tags')}>
        <li><TagLabel lang={lang} label={event.label} /></li>
        {
          eventThreads.map((thread) => (
            <li>
              <ThreadChip
                lang={lang}
                name={thread.name}
                color={thread.color}
                href={site.visibleThreadIds.has(thread.id) ? threadHref(lang, thread.slug[lang]) : undefined}
              />
            </li>
          ))
        }
        {event.min_age !== 'all' && <li><AgeBadge lang={lang} age={event.min_age} /></li>}
      </ul>
      {event.sensitive && <div class="gated"><HeavyTopicBanner lang={lang} /></div>}
    </header>

    {
      gateVariants.length > 0 && (
        <section class="gate" aria-labelledby="gate-text" data-gate>
          <p class="gate__text" id="gate-text">
            {gateVariants.map((v) => <span class="fv" data-modes={v.modes.join(' ')}>{v.value}</span>)}
          </p>
          <div class="gate__actions">
            <button type="button" class="button" data-gate-open>{t(lang, 'gate.open')}</button>
            <a class="button button--secondary" href={backHref} data-gate-back>{t(lang, 'gate.back')}</a>
          </div>
        </section>
      )
    }

    <div class="azulejo-rule" aria-hidden="true"></div>

    <div class="gated card__rest">

    <CardLayers lang={lang} hook={event.hook[lang]} textLang={textLang} asideWideOnly={!event.image}>
      <Fragment slot="aside">
        {
          event.image ? (
            <figure class="figure">
              <img
                src={withBase(event.image.src)}
                alt={event.image.alt[lang]}
                width="1200"
                height="630"
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                {event.image.caption && <span class="figure__caption">{event.image.caption[lang]}</span>}
                <span class="figure__credit">
                  {t(lang, 'card.image_credit')}: {event.image.credit} &middot; {t(lang, 'card.image_license')}: {event.image.license}
                </span>
              </figcaption>
            </figure>
          ) : (
            <MiniMap lang={lang} cardId={event.id} point={event.bridge} name={event.bridge.title?.[lang]?.trim() || event.bridge.name} />
          )
        }
      </Fragment>
      <Fragment slot="below">
        {event.image && <MiniMap lang={lang} cardId={event.id} point={event.bridge} name={event.bridge.title?.[lang]?.trim() || event.bridge.name} />}
      </Fragment>
      <p slot="story">{event.story[lang]}</p>
      <Fragment slot="after">
        {
          pagerVariants
            .filter((variant) => variant.value.next)
            .map(({ modes, value: { next } }) => (
              <div class="fv fv--block" data-modes={modes.join(' ')}>
                <NextStory lang={lang} href={storyPath(lang, next!.slug[lang])} hook={next!.hook[lang]} title={next!.title[lang]} textLang={textLangOf(next!, lang)} />
              </div>
            ))
        }
      </Fragment>
      <Fragment slot="more">
        <section aria-labelledby="context-title">
          <h2 id="context-title">{t(lang, 'card.context')}</h2>
          <div class="prose" lang={textLang}>
            <p>{event.more[lang]}</p>
          </div>
        </section>
        {event.interactive?.type === 'army_dots' && <ArmyDots lang={lang} data={event.interactive.data} textLang={textLang} />}
        {event.interactive?.type === 'ship_scale' && <ShipScale lang={lang} data={event.interactive.data} textLang={textLang} />}
        <BridgeBlock lang={lang} bridge={event.bridge} cardId={event.id} textLang={textLang} />
        {event.sources.length > 0 && <SourceList lang={lang} sources={event.sources} />}
        <ReportLink lang={lang} cardUrl={cardUrl} />
        {
          event.reviewed_on && (
            <p class="checked">
              {t(lang, 'ui.checked_on')}{' '}
              <time datetime={event.reviewed_on.toISOString().slice(0, 10)}>{formatDate(event.reviewed_on, lang)}</time>
            </p>
          )
        }
      </Fragment>
    </CardLayers>

    {
      relatedVariants
        .filter((variant) => variant.value.length > 0)
        .map((variant, i) => (
        <div class="fv fv--block" data-modes={variant.modes.join(' ')}>
          <RelatedList lang={lang} items={variant.value} headingId={`related-title-${i + 1}`} />
        </div>
      ))
    }

    <div class="actions">
      <ShareButton lang={lang} url={cardUrl} title={title} />
    </div>

    {
      pagerVariants.map(({ modes, value: { prev, next } }) => (
        <div class="fv fv--block" data-modes={modes.join(' ')}>
          <PagerNav
            label={t(lang, 'card.epoch_nav')}
            prev={prev ? { dir: `\u2190 ${t(lang, 'card.prev')}`, title: prev.title[lang], href: storyPath(lang, prev.slug[lang]), rel: 'prev' } : null}
            next={next ? { dir: `${t(lang, 'card.next')} \u2192`, title: next.title[lang], href: storyPath(lang, next.slug[lang]), rel: 'next' } : null}
          />
        </div>
      ))
    }
    </div>
  </article>
</BaseLayout>

<script>
  import '../scripts/gate';
</script>

<style>
  /* :global because the children include roots of other components, which do not carry this page's scope. */
  .card > :global(* + *),
  .card__rest > :global(* + *) {
    margin-block-start: var(--space-5);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    list-style: none;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .crumbs li + li::before {
    content: '\203a' / '';
    margin-inline-end: var(--space-2);
  }

  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
  }

  .crumbs [aria-current='page'],
  .crumbs__text {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
  }

  .card__header > :global(* + *) {
    margin-block-start: var(--space-3);
  }

  /* One scale for the headings inside the card (story, context, the interactive, bridge, sources, nearby). */
  .card :global(h2) {
    font-size: var(--text-xl);
  }

  .card__header h1 {
    font-size: var(--text-2xl);
  }

  .card__meta {
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
  }

  /* One row: the credibility label first, then the age and the thread chips, all on one centre line and as tall as a touch target. */
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
  }

  .tags :global(.thread),
  .tags :global(.tag),
  .tags :global(.age) {
    min-height: var(--touch-target);
  }

  /* The label is a square-cornered stamp with its own tint; the thread chips are outlined pills. */
  .tags :global(.tag) {
    padding-inline: var(--pad-chip-x-wide);
    border-radius: var(--radius-sm);
  }

  .figure {
    max-width: var(--container-story);
    border: var(--epoch-frame);
    border-radius: var(--radius-md);
    background: var(--epoch-surface);
    overflow: hidden;
  }

  .figure img {
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    background: var(--epoch-line);
  }

  .figure figcaption {
    padding: var(--space-2) var(--space-3);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .figure__caption {
    display: block;
    color: var(--color-ink);
    font-size: var(--text-base);
  }

  .figure__credit {
    display: block;
  }

  .checked {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
</style>
