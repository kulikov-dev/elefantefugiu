---
// Card page (event or story): /pt/historia/{slug} and /en/story/{slug} (docs/spec.md sections 2 and 5.3).
// Rendered by src/pages/[lang]/[segment]/[slug].astro, which owns the routes.
import BaseLayout from '../layouts/BaseLayout.astro';
import AgeBadge from '../components/AgeBadge.astro';
import BridgeBlock from '../components/BridgeBlock.astro';
import ArmyDots from '../components/ArmyDots.astro';
import CardLayers from '../components/CardLayers.astro';
import Figure from '../components/Figure.astro';
import RouteMap from '../components/RouteMap.astro';
import ShipScale from '../components/ShipScale.astro';
import HeavyTopicBanner from '../components/HeavyTopicBanner.astro';
import Meanwhile from '../components/Meanwhile.astro';
import NextStory from '../components/NextStory.astro';
import { claimStoryName } from '../lib/transitions';
import StoryLinks from '../components/StoryLinks.astro';
import PlaceholderNotice from '../components/PlaceholderNotice.astro';
import RelatedList from '../components/RelatedList.astro';
import ReportLink from '../components/ReportLink.astro';
import ShareButton from '../components/ShareButton.astro';
import LikeButton from '../components/LikeButton.astro';
import FollowBlock from '../components/FollowBlock.astro';
import SourceList from '../components/SourceList.astro';
import TagLabel from '../components/TagLabel.astro';
import ThreadChip from '../components/ThreadChip.astro';
import { EPOCHS_ANCHOR, LANGS, LOCALES, altPaths, epochHref, pagePath, storyPath, threadHref, type Lang } from '../i18n/routes';
import { t } from '../i18n';
import { cardNeighbours, formatYear, isFlashMoment, isRuStandIn, nearbyCards, textLangOf, yearRange, type EventData } from '../lib/events';
import { distanceParts } from '../lib/distance';
import { meanwhileFor } from '../lib/meanwhile';
import { epochFeed, epochHasContent, nextEpochEntry } from '../lib/epochs';
import { ageInfoOf, familyAttrs, gateReason, groupVariants, hiddenModes, isVisibleInMode } from '../lib/family';
import { loadSite } from '../lib/site-data';
import { mythPool } from '../lib/myths-pool';
import { previewImageUrl } from '../lib/picture-assets';
import { OG_CARD, storyCardPath } from '../lib/og-cards';
import { ogDescription, ogTitle } from '../lib/og-text';
import { storySeoDescription, storySeoTitle } from '../lib/seo';
import { cardPicture } from '../lib/pictures';
import { DEFAULT_PREVIEW, ogImagePath } from '../lib/og';
import { moreParagraphs, storyParagraphs } from '../lib/paragraphs';
import { storyNodes } from '../lib/schema';
import { searchAttrs } from '../lib/search-index';
import { schemaContext } from '../lib/schema-site';
import { withBase } from '../i18n/routes';
import { GLOSSARY } from '../lib/glossary-data';
import { inlineMatchers, isGlossaryLang, markParagraph, renderMark } from '../lib/glossary';
import { itemsOfHost, renderWords, wrapWords } from '../lib/cabinet';
import '../styles/cabinet.css';

interface Props {
  lang: Lang;
  event: EventData;
}

const { lang, event } = Astro.props;
// A story of the cabinet of rarities (src/lib/publication.mjs, isListed): its own page, in no list, noindex; no previous, next or read mark.
const isCabinet = Boolean(event.cabinet);

const site = await loadSite();
const hasMyths = mythPool(site.events).length > 0;
const all = site.events;
const epoch = site.epochs.find((e) => e.id === event.epoch);
if (!epoch) throw new Error(`Event "${event.id}" has an unknown epoch "${event.epoch}"`);
// The epoch crumb is a link only when the epoch has a page.
const epochLink = epochHasContent(epoch, all) ? epochHref(lang, epoch.slug[lang]) : undefined;

const title = event.title[lang];
const alternates = altPaths((l) => storyPath(l, event.slug[l]));
const cardUrl = new URL(alternates[lang], Astro.site).href;
// What search results show (the template or the story's own `seo`); the link preview keeps the hook; the schema.org description is the meta description (check:schema).
const seoTitle = storySeoTitle(event, lang);
const seoDescription = storySeoDescription(event, lang, epoch.name[lang]);

// Preview picture (link previews): the main picture of the story, else the picture of the epoch (also for a heavy topic: its pictures are
// documents and strict azulejo, not the playful ones). An epoch that has only a provisional picture (a path inside public/) gives that.
const previewPic = cardPicture(event, epoch);
// The card made for the story (scripts/make-og.mjs: the picture in a frame of the azulejo of the epoch, with the name of the site and of the epoch) goes first;
// without one (dev server, a build without make-og) the picture itself, cropped to 1200 x 630, as before.
const card = storyCardPath(event.id, lang);
const plainUrl = previewPic ? await previewImageUrl(previewPic) : undefined;
const previewUrl = card ? withBase(card) : plainUrl;
const previewImage = previewPic ? undefined : typeof epoch.fallback_image === 'string' ? epoch.fallback_image : undefined;
const previewImageAlt = previewPic && previewPic === event.image ? previewPic.alt[lang] : undefined;

// Structured data: built from the fields of the story; the picture is the one of the link preview (og:image).
const schemaCtx = schemaContext(lang, Astro.site);
// Article.image stays the illustration (the card is for og:image and twitter:image only).
const schemaImage = schemaCtx.abs(plainUrl ?? withBase(ogImagePath(previewImage ?? DEFAULT_PREVIEW)));
const schema = storyNodes(schemaCtx, {
  url: cardUrl,
  title,
  description: seoDescription,
  image: schemaImage,
  story: { year: event.year },
  bridge: { name: event.bridge.title?.[lang] ?? event.bridge.name, address: event.bridge.address, lat: event.bridge.lat, lon: event.bridge.lon },
  published: event.published,
  updated: event.updated,
  sourceUrls: event.sources.map((s) => s.url).filter((u) => /^https?:\/\//.test(u)), // a printed book has no address
  epoch: epochLink ? { name: epoch.name[lang], url: new URL(epochLink, Astro.site).href } : undefined,
});

// Family mode: "Nearby" and previous / next never lead to a card the mode hides, so each is computed for the three
// modes and the markup holds one block per distinct result (CSS shows the block of the current mode).
const allowedIn = (mode: Parameters<typeof isVisibleInMode>[1]) => (e: EventData) => isVisibleInMode(ageInfoOf(e), mode);
// "Nearby": distance to each story, "800 m" under a kilometre (to 10 m), else kilometres with one decimal.
const numberFormat = new Intl.NumberFormat(LOCALES[lang], { maximumFractionDigits: 1 });
const distanceText = (km: number): string => {
  const d = distanceParts(km);
  if (d.kind === 'here') return t(lang, 'card.nearby_same');
  return t(lang, d.kind === 'm' ? 'card.nearby_m' : 'card.nearby_km').replace('{n}', numberFormat.format(d.n));
};
const relatedVariants = groupVariants(
  (mode) =>
    nearbyCards(event, all, { allowed: allowedIn(mode) }).map(({ event: e, km }) => ({
      id: e.id,
      title: e.title[lang],
      href: storyPath(lang, e.slug[lang]),
      meta: `${formatYear(e, lang)} · ${distanceText(km)}`,
      minAge: familyAttrs(e)['data-min-age'],
      sensitive: familyAttrs(e)['data-sensitive'] === 'true',
      published: e.published,
      epoch: e.epoch,
    })),
  (items) => items.map((i) => i.id).join('|'),
);
// The line of small links at the foot: the previous story and the epoch; on the last story of the last epoch (no next story, no big "Next" card)
// also "Next: <the first story of the first epoch>", so that the reading does not stop.
const footerVariants = groupVariants(
  (mode) => {
    const allowed = allowedIn(mode);
    const { prev, next } = cardNeighbours(event, all, allowed);
    const noNext = !next && !nextEpochEntry(epoch, site.epochs, all, allowed);
    const first = noNext ? nextEpochEntry({ ...epoch, order: -Infinity }, site.epochs, all, allowed)?.story : undefined;
    return { prev, wrap: first && first.id !== event.id ? first : null };
  },
  ({ prev, wrap }) => `${prev?.id ?? ''}|${wrap?.id ?? ''}`,
);

// "Next": the next story of the epoch; on the last story of an epoch the first story of the next epoch with a page ("Next era: <name>");
// on the last story of the last such epoch a link to all eras. Each is computed per mode like the previous / next links above.
const continueVariants = groupVariants(
  (mode) => {
    const { next } = cardNeighbours(event, all, allowedIn(mode));
    return { next, nextEpoch: next ? null : nextEpochEntry(epoch, site.epochs, all, allowedIn(mode)) };
  },
  ({ next, nextEpoch }) => `${next?.id ?? ''}|${nextEpoch?.story.id ?? ''}`,
);

// Intermediate screen: the modes that hide this card, and the text of each (age and/or heavy topic).
const gateModes = hiddenModes(ageInfoOf(event));
const gateVariants = groupVariants(
  (mode) => {
    const reason = gateReason(ageInfoOf(event), mode);
    const parts = [reason.age === '12' ? t(lang, 'gate.age_12') : reason.age === '16' ? t(lang, 'gate.age_16') : '', reason.heavy ? t(lang, 'gate.heavy') : ''];
    return parts.some(Boolean) ? `${parts.filter(Boolean).join(' ')} ${t(lang, 'gate.question')}` : '';
  },
  (text) => text,
).filter((v) => v.value !== '');
const backHref = epochLink ?? pagePath(lang, 'home');
// The line about a finished panel (src/scripts/read-marks.ts shows it): only for an epoch with a panel. The stories of the epoch with their age data, so the script counts what the mode shows.
const pannoStories = epoch.panno && epochLink ? JSON.stringify(epochFeed(epoch, all).map((e) => ({ id: e.id, ...ageInfoOf(e) }))) : undefined;

const eventThreads = event.threads.map((id) => site.threads.find((th) => th.id === id)).filter((th) => th !== undefined);
// Placeholder text is Latin filler: mark it, so screen readers do not read it as Portuguese.
const textLang = textLangOf(event, lang);
const standIn = isRuStandIn(event, lang);
// The glossary (docs/spec.md "Словарик"): in the story and in "More" the first mention of a word the glossary marks gets a dotted underline and a tooltip.
// Only ru and en are marked; a Russian page that shows the English text (stand-in) is marked as English; the Latin filler of a placeholder is not marked.
const textL = standIn ? 'en' : lang;
const glossaryLang = !event.placeholder && isGlossaryLang(textL) ? textL : undefined;
const glossaryMatchers = glossaryLang ? inlineMatchers(GLOSSARY, glossaryLang) : [];
const seenWords = new Set<string>();
const glossaryHref = glossaryLang ? pagePath(glossaryLang, 'glossary') : '';
const marked = (paragraph: string): string =>
  markParagraph(paragraph, glossaryMatchers, seenWords, (term, matched) => renderMark(term, matched, glossaryLang!, glossaryHref, t(glossaryLang!, 'glossary.all')));
// In the order of the page: the story first, then "More" (a word is marked once, where it comes first).
// The words of the cabinet of rarities hidden in this story (src/lib/cabinet.ts): wrapped before the glossary, turned into spans after it. A story of the cabinet itself hides none.
const storyParts = storyParagraphs(event.story[lang]);
const moreParts = moreParagraphs(event.more[lang]);
const hidden = event.placeholder || isCabinet ? [] : itemsOfHost(site.cabinet, event.id);
const wrapped = wrapWords([...storyParts, ...moreParts], hidden.map(({ item }) => ({ id: item.id, phrase: item.phrase[textL], occurrence: item.occurrence?.[textL] })));
const storyHtml = wrapped.slice(0, storyParts.length).map((p) => renderWords(marked(p)));
const moreHtml = wrapped.slice(storyParts.length).map((p) => renderWords(marked(p)));
// The search index (Pagefind, scripts/make-search.mjs) takes the hook, the story and "More" of a page that search engines may take too, with the metadata the results show.
const indexed = !event.placeholder && !standIn && !isCabinet;
const pf = indexed ? { 'data-pagefind-body': '' } : {};
// The title, the year and the place weigh more than the text: a query that names a place finds its stories first.
const pfWeight = (weight: number) => (indexed ? { 'data-pagefind-body': '', 'data-pagefind-weight': String(weight) } : {});
// "Meanwhile": the line of the page's language, then the world; none on a heavy story. A Russian line is hidden on a card that is shown in English under /ru/ (stand-in).
// A line of the same year as a story from tens of thousands of years ago or more (the prologue) wears the caption of the story ("about 150 million years ago"), not a year number.
const ancient = yearRange(event)[0] <= -10000;
const meanwhileLines = (event.sensitive ? [] : meanwhileFor(event.meanwhile, lang).filter((line) => !(standIn && line.scope === 'ru'))).map((line) => (ancient && line.year === yearRange(event)[0] ? { ...line, label: formatYear(event, lang) } : line));
// hreflang names the languages the card is written in; a card without Russian leaves ru out.
const readyLangs = LANGS.filter((l) => l !== 'ru' || event.ru_ready);
---
<BaseLayout
  lang={lang}
  title={title}
  seoTitle={seoTitle}
  alternates={alternates}
  description={seoDescription}
  preview={{ title: ogTitle(event.title[lang]), description: ogDescription(event.hook[lang]), type: 'article', image: previewImage, imageUrl: previewUrl, imageSize: card ? OG_CARD : undefined, imageAlt: previewImageAlt }}
  noindex={event.placeholder || standIn || isCabinet}
  schema={schema}
  readyLangs={readyLangs}
  stand_in={standIn}
  epoch={epoch.id}
>
  <article class="card" {...(indexed ? searchAttrs(event, lang) : {})} data-flash={isFlashMoment(event) ? '' : undefined} data-gate-modes={gateModes.length > 0 ? gateModes.join(' ') : undefined}>
    {isCabinet && <p class="cab-ribbon">{t(lang, 'cabinet.ribbon')}</p>}
    <nav class="crumbs" aria-label={t(lang, 'card.breadcrumb')}>
      <ol>
        <li>{epochLink ? <a href={epochLink}>{epoch.name[lang]}</a> : <span class="crumbs__text">{epoch.name[lang]}</span>}</li>
        <li aria-current="page"><span class="crumbs__text">{title}</span></li>
      </ol>
    </nav>

    {standIn && <p class="notice" role="note" data-not-translated>{t(lang, 'card.not_translated')}</p>}
    {event.placeholder && <PlaceholderNotice lang={lang} />}

    <header class="card__header">
      <h1 {...pfWeight(10)}>{title}</h1>
      <p class="card__meta" {...pfWeight(6)}>
        <span>{formatYear(event, lang)}</span>
        <span aria-hidden="true"> &middot; </span>
        <span>{event.place.name[lang]}</span>
      </p>
      <ul class="tags gated" aria-label={t(lang, 'card.tags')}>
        <li><TagLabel lang={lang} label={event.label} /></li>
        {
          eventThreads.map((thread) => (
            <li>
              <ThreadChip
                lang={lang}
                name={thread.name}
                color={thread.color}
                description={thread.description[lang]}
                href={site.visibleThreadIds.has(thread.id) ? threadHref(lang, thread.slug[lang]) : undefined}
              />
            </li>
          ))
        }
        {event.min_age !== 'all' && <li><AgeBadge lang={lang} age={event.min_age} /></li>}
      </ul>
      {event.sensitive && <div class="gated"><HeavyTopicBanner lang={lang} /></div>}
    </header>

    {
      gateVariants.length > 0 && (
        <section class="gate" aria-labelledby="gate-text" data-gate>
          <p class="gate__text" id="gate-text">
            {gateVariants.map((v) => <span class="fv" data-modes={v.modes.join(' ')}>{v.value}</span>)}
          </p>
          <div class="gate__actions">
            <button type="button" class="button" data-gate-open>{t(lang, 'gate.open')}</button>
            <a class="button button--secondary" href={backHref} data-gate-back>{t(lang, 'gate.back')}</a>
          </div>
        </section>
      )
    }

    <div class="azulejo-rule" aria-hidden="true"></div>

    <div class="gated card__rest">

    <CardLayers lang={lang} hook={event.hook[lang]} textLang={textLang} hasAside={Boolean(event.image)} hasRoute={Boolean(event.route)} storyId={isCabinet ? undefined : event.id} indexed={indexed}>
      <Fragment slot="aside">{event.image && <Figure lang={lang} picture={event.image} kind="main" transitionName={claimStoryName(Astro.request, event.slug[lang])} />}</Fragment>
      <Fragment slot="story">{storyHtml.map((html) => <p set:html={html} />)}</Fragment>
      <Fragment slot="route">{event.route && <RouteMap lang={lang} route={event.route} id={event.id} textLang={textLang} />}</Fragment>
      <Fragment slot="meanwhile"><Meanwhile lang={lang} lines={meanwhileLines} textLang={textLang} /></Fragment>
      <Fragment slot="like"><LikeButton lang={lang} id={event.id} title={event.title.pt} /></Fragment>
      <Fragment slot="after">
        {!isCabinet && pannoStories && <p class="story-panno" data-story-panno data-epoch-id={epoch.id} data-stories={pannoStories} hidden><a href={epochLink}>{t(lang, 'panno.story_line').replace('{name}', epoch.name[lang])}</a></p>}
        {
          (isCabinet ? [] : continueVariants).map(({ modes, value: { next, nextEpoch } }) => {
            const target = next ?? nextEpoch?.story;
            const targetEpoch = nextEpoch?.epoch ?? epoch;
            return (
              <div class="fv fv--block" data-modes={modes.join(' ')}>
                {target ? (
                  <NextStory
                    lang={lang}
                    href={storyPath(lang, target.slug[lang])}
                    hook={target.hook[lang]}
                    title={target.title[lang]}
                    textLang={textLangOf(target, lang)}
                    picture={cardPicture(target, site.epochs.find((ep) => ep.id === target.epoch) ?? targetEpoch)}
                    label={nextEpoch ? t(lang, 'card.next_epoch').replace('{name}', nextEpoch.epoch.name[lang]) : undefined}
                  />
                ) : (
                  <p class="all-eras">
                    <a class="button button--secondary" href={`${pagePath(lang, 'home')}#${EPOCHS_ANCHOR}`}>{t(lang, 'card.all_epochs')}</a>
                  </p>
                )}
              </div>
            );
          })
        }
      </Fragment>
      <Fragment slot="more">
        <section aria-labelledby="context-title">
          <h2 id="context-title">{t(lang, 'card.context')}</h2>
          <div class="prose" lang={textLang} {...pf}>
            {moreHtml.map((html) => <p set:html={html} />)}
          </div>
        </section>
        {event.detail_image && <Figure lang={lang} picture={event.detail_image} kind="detail" />}
        {event.interactive?.type === 'army_dots' && <ArmyDots lang={lang} data={event.interactive.data} textLang={textLang} />}
        {event.interactive?.type === 'ship_scale' && <ShipScale lang={lang} data={event.interactive.data} textLang={textLang} />}
        <BridgeBlock lang={lang} bridge={event.bridge} cardId={event.id} kind={event.importance === 3 ? 'frame' : 'story'} textLang={textLang} />
        {event.sources.length > 0 && <SourceList lang={lang} sources={event.sources} />}
      </Fragment>
    </CardLayers>

    {
      relatedVariants
        .filter((variant) => variant.value.length > 0)
        .map((variant, i) => (
        <div class="fv fv--block" data-modes={variant.modes.join(' ')}>
          <RelatedList lang={lang} items={variant.value} headingId={`related-title-${i + 1}`} />
        </div>
      ))
    }

    <div class="actions">
      <ShareButton lang={lang} url={cardUrl} title={title} />
      <ReportLink lang={lang} cardUrl={cardUrl} title={title} />
    </div>

    {
      (isCabinet ? [] : footerVariants).map(({ modes, value: { prev, wrap } }) => (
        <div class="fv fv--block" data-modes={modes.join(' ')}>
          <StoryLinks
            lang={lang}
            prev={prev ? { title: prev.title[lang], href: storyPath(lang, prev.slug[lang]) } : null}
            epoch={epochLink ? { name: epoch.name[lang], href: epochLink } : undefined}
            wrap={wrap ? { title: wrap.title[lang], href: storyPath(lang, wrap.slug[lang]) } : null}
          />
        </div>
      ))
    }

    {isCabinet && <p class="cab-back" data-cab-back>{site.cabinetOpen && <a href={pagePath(lang, 'cabinet')}>{t(lang, 'cabinet.back')}</a>}</p>}

    {/* One small line that leads to the game "Myth or fact" (the link in the footer stays). */}
    {hasMyths && <p class="story-myths"><a href={pagePath(lang, 'myths')}>{t(lang, 'ui.story_myths')}</a></p>}

    {/* E-mail once a month and, in Russian, the Telegram channel: one block, shown by the script to a reader who has read another story. */}
    <FollowBlock lang={lang} story={event.id} />
    </div>
  </article>
</BaseLayout>

<script>
  import '../scripts/gate';
  import '../scripts/glossary';
</script>

<style>
  /* The glossary (src/lib/glossary.ts, src/scripts/glossary.ts): the word is a plain-looking button with a dotted underline; the tooltip opens under it.
     With JavaScript the state is data-open on .gl; without it hover and focus open the tooltip. */
  .card :global(.gl) {
    position: relative;
    display: inline;
  }

  .card :global(.gl__term) {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: help;
    font: inherit;
    text-decoration: underline dotted;
    text-decoration-thickness: 1px;
    text-underline-offset: var(--underline-offset);
    white-space: nowrap;
  }

  .card :global(.gl__tip) {
    position: absolute;
    z-index: var(--z-glossary);
    top: 100%;
    left: 0;
    /* Closed it takes no room at all: a hidden box 20 rem wide at a word near the right edge still widened the page (and the fixed tab bar with it). */
    display: none;
    width: var(--glossary-tip-width);
    padding-block-start: var(--space-1);
    transform: translateX(var(--gl-shift, 0));
    font-size: var(--text-sm);
    font-style: normal;
    font-weight: normal;
    line-height: var(--leading-body);
    text-align: start;
    white-space: normal;
  }

  .card :global(.gl--up .gl__tip) {
    top: auto;
    bottom: 100%;
    padding-block: 0 var(--space-1);
  }

  .card :global(.gl__box) {
    display: block;
    padding: var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-raised);
    color: var(--color-text);
  }

  .card :global(.gl__text) {
    display: block;
  }

  .card :global(.gl__all) {
    display: inline-block;
    margin-block-start: var(--space-2);
    color: var(--color-accent-strong);
  }

  .card :global(.gl[data-open] .gl__tip),
  :global(html:not([data-js])) .card :global(.gl:hover .gl__tip),
  :global(html:not([data-js])) .card :global(.gl:focus-within .gl__tip) {
    display: block;
  }

  .story-myths {
    font-size: var(--text-sm);
  }

  .story-panno {
    font-size: var(--text-sm);
  }

  .story-panno a,
  .story-myths a {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--color-ink-muted);
  }

  /* :global because the children include roots of other components, which do not carry this page's scope. */
  .card > :global(* + *),
  .card__rest > :global(* + *) {
    margin-block-start: var(--space-5);
  }

  /* One line, always: a long name is cut with an ellipsis instead of wrapping, so the web font arriving later (a different text width)
     cannot turn one line into two and push the whole card down. */
  .crumbs ol {
    display: flex;
    flex-wrap: nowrap;
    gap: 0 var(--space-2);
    list-style: none;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .crumbs li {
    display: flex;
    min-width: 0;
    flex: 0 1 auto;
  }

  .crumbs li:last-child {
    flex: 1 1 0;
  }

  .crumbs li + li::before {
    content: '\203a' / '';
    flex: none;
    margin-inline-end: var(--space-2);
    line-height: var(--touch-target);
  }

  .crumbs a,
  .crumbs__text {
    min-width: 0;
    overflow: hidden;
    line-height: var(--touch-target);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card__header > :global(* + *) {
    margin-block-start: var(--space-3);
  }

  /* One scale for the headings inside the card (story, context, the interactive, bridge, sources, nearby). */
  .card :global(h2) {
    font-size: var(--text-xl);
  }

  .card__header h1 {
    font-size: var(--text-2xl);
  }

  .card__meta {
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
  }

  /* One row: the credibility label first, then the age and the thread chips, all on one centre line and as tall as a touch target. */
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
