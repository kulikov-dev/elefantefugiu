---
// Home page: /pt/, /en/, /ru/ (docs/spec.md section 5.1). It tells a story at once instead of explaining the project:
// the story the name comes from, "Where to start" (three stories), one line with the number of places and the link to the map, the epochs
// (the time strip), the threads (five rows).
// Everything is built from the data; it reads without JavaScript (the "left off" band needs a script).
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeMapLine from '../components/HomeMapLine.astro';
import Mascot from '../components/Mascot.astro';
import StartCard from '../components/StartCard.astro';
import { EPOCHS_ANCHOR, epochHref, pagePath, storyPath, threadHref, withBase, type Lang } from '../i18n/routes';
import { plural, pluralForms, t } from '../i18n';
import { epochHasTestText, epochYearsText, threadSections } from '../lib/epochs';
import { epochTiles, firstMvpEpoch, homeStartStory } from '../lib/home';
import { ageInfoOf, countByMode, countVariants, familyAttrs, groupVariants, isVisibleInMode, zeroModes } from '../lib/family';
import { loadSite } from '../lib/site-data';
import { cardPicture } from '../lib/pictures';
import type { EventData } from '../lib/events';
import { buildToday } from '../lib/publication.mjs';
import { startFile, startFileHref, toStart } from '../lib/start-data';
import { builtFesta, festaText, FESTAS } from '../lib/festas-data';
import FestaHero from '../components/FestaHero.astro';
import { pinsFor } from '../lib/start-pins';
import { setKey, startSet, withFallback } from '../lib/start-set';
import { HOME_PREVIEW } from '../lib/og';
import { OG_CARD, festaCardPath, festaCardSize, homeCardPath } from '../lib/og-cards';
import TimelineStrip from '../components/TimelineStrip.astro';
import { liveMyths } from '../lib/myths';
import { MYTHS } from '../lib/myths-data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const site = await loadSite();

// "Myth or fact": the invitation after "Where to start" (only when there is a claim to play).
const mythIds = liveMyths(MYTHS, site.events).map((m) => m.id);
const mythCount = mythIds.length;
const mythStrings = { continue: t(lang, 'home.myths_continue'), band_low: t(lang, 'myths.band_low'), band_mid: t(lang, 'myths.band_mid'), band_high: t(lang, 'myths.band_high'),again: t(lang, 'home.myths_again') };
const hasMyths = mythCount > 0;
const firstEpoch = firstMvpEpoch(site.epochs, site.events);
const tiles = epochTiles(site.epochs, site.events);
const ready = tiles.filter((tile) => tile.available);
const soonCount = tiles.length - ready.length;
// The main button opens the story the name comes from; without it, the first epoch.
const startStory = homeStartStory(site.events);
// The card of the home page (scripts/make-og.mjs: the picture of the story the site begins with); without one the standing elephant.
const homeCard = homeCardPath(lang);
// In the window of a holiday (by the day of the build) the home page shares the picture of the holiday instead (scripts/make-festa-og.mjs).
const builtDay = builtFesta();
const festaNow = builtDay?.inWindow ? FESTAS.find((f) => f.id === builtDay.id && f.enabled) : undefined;
const festaCard = festaNow && festaText(festaNow, lang) ? festaCardPath(festaNow.id) : undefined;
const startHref = startStory ? storyPath(lang, startStory.slug[lang]) : firstEpoch ? epochHref(lang, firstEpoch.slug[lang]) : pagePath(lang, 'map');
// Family mode: counters carry three numbers (off, all, 12) and a chip with a zero counter is hidden in that mode.
const threadCounts = new Map(site.visibleThreads.map((th) => [th.id, countByMode(site.events.filter((e) => e.threads.includes(th.id)).map(ageInfoOf))]));
// One dot per story of a thread in the order of time, in the colour of its epoch; the names of the epochs (each once) go to the label of the row of dots.
// Family mode: the row is made for each distinct result of the three modes, so the dots and the label speak of the stories that the mode shows.
const threadEras = new Map(
  site.visibleThreads.map((th) => {
    const dots = threadSections(th, site.epochs, site.events).flatMap(({ epoch, events }) => events.map((event) => ({ epoch, event })));
    const variants = groupVariants(
      (mode) => {
        const shown = dots.filter(({ event }) => isVisibleInMode(ageInfoOf(event), mode));
        return { shown, names: [...new Set(shown.map(({ epoch }) => epoch.name[lang]))] };
      },
      (v) => v.shown.map(({ event }) => event.id).join(),
    ).filter((variant) => variant.value.shown.length > 0);
    return [th.id, variants];
  }),
);
const hideIn = (modes: string[]) => (modes.length > 0 ? modes.join(' ') : undefined);

// "Where to start": the three cards of the day (src/lib/start-set.ts), counted for the day of the build and with nothing read; the script
// (src/scripts/start-set.ts) counts again in the browser with the read marks, the family mode and the day in Lisbon, and swaps the cards if the result differs.
// featured.yaml stays as the stand-in set for a pool too small to give three cards.
const today = buildToday();
const startStories = site.events.map(toStart);
const builtYear = Number(today.slice(0, 4));
const fallbackIds = site.featured.map((e) => e.id);
const startRefs = withFallback(startSet({ today, stories: startStories, read: new Set(), pins: pinsFor(startStories, builtYear) }), fallbackIds);
const eventById = new Map(site.events.map((e) => [e.id, e]));
const shown = startRefs.map((ref) => ({ ref, event: ref.target.type === 'story' ? eventById.get(ref.target.id) : undefined })).filter((x) => x.ref.target.type === 'page' || x.event);
const hasCaption = shown.some((x) => x.ref.label);
// The data of the cards for the script is a file of its own (src/lib/start-data.ts); the page only names it.
const startUrl = startFileHref(lang, (await startFile(site, lang)).hash);
// Blank cards for the script to copy (a copy keeps the scoped styles of the component).
const blank = { pt: '', en: '', ru: '' };
const stubEvent = (label: 'documented' | 'legend' | 'debated') =>
  ({ id: '', slug: blank, title: blank, hook: blank, label, sensitive: true, year: 0, place: { name: blank, short: blank, lat: 0, lon: 0 }, placeholder: false, ru_ready: true }) as unknown as EventData;

// Test text must stay out of search results until it is real.
const noindex = shown.some((x) => x.event?.placeholder) || ready.some((tile) => epochHasTestText(tile.epoch));

// "Left off": the epochs with a page, by id, for the script that knows the last epoch of the reader.
const continueTargets = Object.fromEntries(ready.map((tile) => [tile.epoch.id, { href: epochHref(lang, tile.epoch.slug[lang]), name: tile.epoch.name[lang] }]));
// "New since your last visit" (src/scripts/new-marks.ts): the stories with the day they were published and their age data, so the script counts
// only what the family mode shows.
const newData = site.events.map((e) => ({ id: e.id, epoch: e.epoch, published: e.published, ...ageInfoOf(e) }));
---
<BaseLayout lang={lang} pageKey="home" title={t(lang, 'site.name')} noindex={noindex} description={t(lang, 'site.home_preview_description')} preview={
    festaCard
      ? { title: t(lang, 'site.home_preview_title'), description: t(lang, 'site.home_preview_description'), image: HOME_PREVIEW, imageUrl: withBase(festaCard), imageSize: festaCardSize(festaCard), imageAlt: festaText(festaNow!, lang)!.art_title }
      : { title: t(lang, 'site.home_preview_title'), description: t(lang, 'site.home_preview_description'), image: HOME_PREVIEW, imageUrl: homeCard ? withBase(homeCard) : undefined, imageSize: homeCard ? OG_CARD : undefined, imageAlt: homeCard ? startStory?.image?.alt[lang] : undefined }
  }>
  <div class="home">
    <!-- A thin band above the first screen, only for a reader who has been in an epoch before (the script shows it). -->
    <a
      class="continue-band"
      href={firstEpoch ? epochHref(lang, firstEpoch.slug[lang]) : '#'}
      data-continue
      data-template={t(lang, 'home.continue')}
      data-targets={JSON.stringify(continueTargets)}
      hidden
    >{t(lang, 'home.continue').replace('{name}', firstEpoch?.name[lang] ?? '')}</a>

    <!-- "Since your last visit: N new stories" with the epochs (the script fills and shows it; nothing when N is 0, on a first visit, without storage). -->
    <p
      class="new-line"
      data-new-line
      data-template={t(lang, 'home.new_since')}
      data-forms={JSON.stringify(pluralForms(lang, 'plural.new_stories'))}
      data-epoch-forms={JSON.stringify(pluralForms(lang, 'plural.new_plus'))}
      data-era-forms={JSON.stringify(pluralForms(lang, 'plural.new_epochs'))}
      data-era-text={t(lang, 'home.new_era')}
      data-targets={JSON.stringify(continueTargets)}
      hidden
    ></p>
    <script type="application/json" data-new-data set:html={JSON.stringify(newData)} />

    <section class="hero" aria-labelledby="home-title">
      <div class="hero__text">
        <h1 id="home-title">{t(lang, 'home.hook_title')}</h1>
        <p class="hero__intro">{t(lang, 'home.intro')}</p>
        <p class="hero__how">{t(lang, 'home.how')}</p>
        <p class="hero__actions">
          <a class="button" href={startHref}>{t(lang, 'home.cta_read')}</a>
          <a class="hero__link" href={pagePath(lang, 'surprise')}>{t(lang, 'ui.surprise')}</a>
          <a class="hero__link" href={pagePath(lang, 'map')}>{t(lang, 'home.open_map')}</a>
        </p>
      </div>
      <div class="hero__picture">
        <Mascot pose="run" size="hero" />
      </div>
    </section>

    <!-- The block of a holiday, after the hero and before the showcase (the 3 days before it and its day): hidden until the head script turns it on, so the page does not shift. -->
    <FestaHero lang={lang} />

    {
      shown.length > 0 && (
        <section aria-labelledby="showcase-title" data-showcase data-start-key={setKey(startRefs)} data-start-url={startUrl}>
          <h2 id="showcase-title">{t(lang, 'home.showcase_heading')}</h2>
          <ul class:list={['showcase', { 'showcase--captioned': hasCaption }]} data-start-list>
            {shown.map(({ ref, event }, index) => (
              <li {...(event ? familyAttrs(event) : {})}>
                {hasCaption && <p class="showcase__caption">{ref.label?.[lang]}</p>}
                {
                  event ? (
                    <StartCard lang={lang} event={event} first={index === 0} picture={cardPicture(event, site.epochs.find((ep) => ep.id === event.epoch) ?? {})} />
                  ) : (
                    ref.target.type === 'page' && <StartCard lang={lang} first={index === 0} page={{ href: ref.target.href, title: ref.target.title[lang], hook: ref.target.hook[lang], image: ref.target.image }} />
                  )
                }
              </li>
            ))}
          </ul>
          <!-- Blank cards (one per label, and one for a page) that the script fills when it swaps the cards. -->
          {
            (['documented', 'legend', 'debated'] as const).map((label) => (
              <template data-start-template={label}>
                <li>
                  <p class="showcase__caption"></p>
                  <StartCard lang={lang} event={stubEvent(label)} />
                </li>
              </template>
            ))
          }
          <template data-start-template="page">
            <li>
              <p class="showcase__caption"></p>
              <StartCard lang={lang} page={{ href: '', title: '', hook: '' }} />
            </li>
          </template>
        </section>
      )
    }

    {
      hasMyths && (
        <section class="home-myths" aria-labelledby="myths-title" data-home-myths data-ids={JSON.stringify(mythIds)} data-strings={JSON.stringify(mythStrings)}>
          <h2 id="myths-title">{t(lang, 'home.myths_title')}</h2>
          <p>{t(lang, 'home.myths_line').replace('{stories}', plural(lang, 'plural.stories', mythCount))}</p>
          <ol class="squares" aria-hidden="true" data-tiles>{Array.from({ length: mythCount }, () => <li class="sq sq--empty" />)}</ol>
          <p class="home-myths__result" data-result hidden></p>
          <p><a class="button" href={pagePath(lang, 'myths')} data-play>{t(lang, 'home.myths_play')}</a></p>
        </section>
      )
    }

    {site.events.length > 0 && <HomeMapLine lang={lang} events={site.events} />}

    <section id={EPOCHS_ANCHOR} aria-labelledby="epocas-title">
      <h2 id="epocas-title">{t(lang, 'home.epochs_heading')}</h2>
      <!-- All the epochs in order: the ready ones stand out (a link, the theme phrase, the number of stories), the others are pale with "soon". -->
      <TimelineStrip lang={lang} labelledby="epocas-title" label={t(lang, 'home.timeline_label')}>
          {
            tiles.map(({ epoch, available, counts }) =>
              available ? (
                <li class="timeline__item timeline__item--ready" style={`--tone: var(--tone-${epoch.id}, var(--epoch-primary))`}>
                  <a href={epochHref(lang, epoch.slug[lang])}>
                    <span class="timeline__name">{epoch.name[lang]}</span>
                    <span class="timeline__years">{epochYearsText(epoch, lang)}</span>
                    {epoch.theme && <span class="timeline__theme">{epoch.theme[lang]}</span>}
                    <span class="timeline__count">
                      {countVariants(counts).map((v) => <span class="fv" data-modes={v.modes.join(' ')}>{plural(lang, 'plural.stories', v.value)}</span>)}
                      <span class="timeline__new" data-new-epoch={epoch.id} hidden></span>
                    </span>
                  </a>
                </li>
              ) : (
                <li class="timeline__item timeline__item--soon" title={epoch.intro?.[lang]?.trim() || undefined}>
                  <span class="timeline__name">{epoch.name[lang]}</span>
                  <span class="timeline__years">{epochYearsText(epoch, lang)}</span>
                  <span class="timeline__soon">{t(lang, 'ui.soon')}</span>
                </li>
              ),
            )
          }
      </TimelineStrip>
      {soonCount > 0 && <p class="timeline__more">{plural(lang, 'plural.epochs_more', soonCount)}</p>}
    </section>

    {
      site.visibleThreads.length > 0 && (
        <section aria-labelledby="threads-title">
          <h2 id="threads-title">{t(lang, 'home.threads_heading')}</h2>
          <p>{t(lang, 'home.threads_intro')}</p>
          <ul class="thread-list">
            {site.visibleThreads.map((thread) => (
              <li data-hide-in={hideIn(zeroModes(threadCounts.get(thread.id)!))}>
                <a class="thread-row" href={threadHref(lang, thread.slug[lang])} style={`--thread-color: ${thread.color}`}>
                  <span class="thread-row__dot" aria-hidden="true"></span>
                  <span class="thread-row__name">{thread.name[lang]}</span>
                  <span class="thread-row__count">
                    {countVariants(threadCounts.get(thread.id)!).map((v) => <span class="fv" data-modes={v.modes.join(' ')}>{plural(lang, 'plural.stories', v.value)}</span>)}
                  </span>
                  <span class="thread-row__text">{thread.description[lang]}</span>
                  {
                    threadEras.get(thread.id)!.map((v) => (
                      <span class="fv" data-modes={v.modes.join(' ')}>
                        <span class="thread-row__eras" role="img" aria-label={`${t(lang, 'home.epochs_heading')}: ${v.value.names.join(', ')}`}>
                          {v.value.shown.map(({ epoch }) => <span class="thread-row__era" style={`--tone: var(--tone-${epoch.id}, var(--epoch-primary))`}></span>)}
                        </span>
                      </span>
                    ))
                  }
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<script>
  import '../scripts/last-epoch';
  import '../scripts/home-myths';
  import '../scripts/start-set';
</script>

<style>
  .home > :global(* + *) {
    margin-block-start: var(--space-6);
  }

  .home :global(h2) {
    margin-block-end: var(--space-3);
  }

  /* ---- the band "Continue where you left off: ..." ---- */
  .continue-band {
    display: block;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--epoch-line);
    border-radius: var(--radius-md);
    background: var(--color-accent-tint);
    color: var(--color-ink);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .continue-band:hover {
    border-color: var(--color-accent);
  }

  .continue-band[hidden] {
    display: none;
  }

  .home > .continue-band + * {
    margin-block-start: var(--space-4);
  }

  /* ---- first screen: the story on the left, the elephant on the right (above the text on a phone, smaller) ---- */
  .hero {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }

  .hero__picture {
    order: -1;
    justify-self: start;
  }

  .hero h1 {
    font-size: var(--text-hero);
    line-height: 1.1;
  }

  .hero__intro {
    max-width: var(--measure);
    margin-block-start: var(--space-3);
    font-size: var(--text-lg);
  }

  .home-myths > * + * {
    margin-block-start: var(--space-3);
  }

  .hero__how {
    max-width: var(--measure);
    margin-block-start: var(--space-2);
    color: var(--color-ink-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-4);
    margin-block-start: var(--space-4);
  }

  .hero__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-6);
    }

    .hero__picture {
      order: 0;
      justify-self: end;
    }
  }

  /* ---- where to start ---- */
  /* The cards share the whole width (auto-fit: no empty column on the right) and are as tall as the tallest, so the small titles line up. */
  .showcase > :global(li) {
    display: flex;
    flex-direction: column;
  }

  /* The line above a pinned card ("On this day in 1877"). When any card has one, every item keeps the line's place, so the cards start at the same height. */
  .showcase__caption {
    min-height: 1lh;
    margin-block-end: var(--space-1);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .showcase:not(.showcase--captioned) .showcase__caption {
    display: none;
  }

  .showcase {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--grid-home-tile-min)), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline__theme {
    font-family: var(--font-body);
    font-style: italic;
  }

  .timeline__count {
    color: var(--color-ink-muted);
  }

  /* "+N new" after the number of stories of an epoch (the script shows it). */
  .timeline__new {
    color: var(--color-accent-strong);
    font-weight: 700;
    white-space: nowrap;
  }

  .timeline__new::before {
    content: ' · ';
    font-weight: 400;
  }

  /* ---- the line "Since your last visit: N new stories" ---- */
  .new-line {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--epoch-line);
    border-radius: var(--radius-md);
    background: var(--color-accent-tint);
    font-size: var(--text-sm);
  }

  .timeline__soon {
    font-size: var(--text-sm);
    font-style: italic;
  }

  .timeline__more {
    margin-block-start: var(--space-2);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  /* ---- the threads: five rows, a colour dot, the name, the number of stories and a line about the thread ---- */
  .thread-list {
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--epoch-line);
  }

  .thread-list > li {
    border-block-end: 1px solid var(--epoch-line);
  }

  .thread-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      'dot name count'
      '. text text'
      '. eras eras';
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-3);
    color: var(--color-ink);
    text-decoration: none;
  }

  .thread-row:hover .thread-row__name {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .thread-row:focus-visible {
    outline-offset: var(--ring-offset-tight);
  }

  .thread-row__dot {
    grid-area: dot;
    /* On the first line of the name, not in the middle of the row (on a wide screen the line about the thread can take two lines). */
    align-self: start;
    margin-block-start: calc((1lh - var(--size-dot-lg)) / 2);
    width: var(--size-dot-lg);
    height: var(--size-dot-lg);
    border-radius: 50%;
    background: var(--thread-color);
  }

  .thread-row__name {
    grid-area: name;
    font-weight: 700;
  }

  .thread-row__count {
    grid-area: count;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .thread-row__text {
    grid-area: text;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  /* Under the name: a dot for every story of the thread, in the order of time, in the colour of its epoch (decorative: the label of the row names the epochs). */
  .thread-row__eras {
    grid-area: eras;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-block-start: var(--space-1);
  }

  .thread-row__era {
    flex: none;
    width: var(--size-dot-tone);
    height: var(--size-dot-tone);
    border-radius: 50%;
    background: var(--tone);
  }

  /* A wide screen: the line about the thread stands beside the name instead of under it, and the dots sit right under the name in its column. The line
     about the thread spans both rows, and the extra height of a long line goes to the second row (1fr), below the dots, not between the name and them. */
  @media (min-width: 48rem) {
    .thread-row {
      grid-template-columns: auto minmax(var(--thread-name-min), var(--thread-name-max)) var(--thread-count-width) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'dot name count text'
        '. eras . text';
      gap: 0 var(--space-3);
    }

    .thread-row__eras {
      align-self: start;
      margin-block-start: calc(var(--space-3) / 2);
    }
  }
</style>
