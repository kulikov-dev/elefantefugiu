---
// Home page: /pt/, /en/, /ru/ (docs/spec.md section 5.1). It tells a story at once instead of explaining the project:
// the story the name comes from, "Where to start" (three stories), the map of all the places, the epochs, the threads.
// Everything is built from the data; it reads without JavaScript (the map and the "left off" band need a script).
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeMap from '../components/HomeMap.astro';
import Mascot from '../components/Mascot.astro';
import StartCard from '../components/StartCard.astro';
import ThreadChip from '../components/ThreadChip.astro';
import { EPOCHS_ANCHOR, epochHref, pagePath, storyPath, threadHref, type Lang } from '../i18n/routes';
import { plural, t } from '../i18n';
import { epochYearsText } from '../lib/epochs';
import { epochTiles, firstMvpEpoch, homeStartStory } from '../lib/home';
import { ageInfoOf, countByMode, countVariants, familyAttrs, zeroModes } from '../lib/family';
import { tileConfig } from '../lib/tiles';
import { loadSite } from '../lib/site-data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const site = await loadSite();

const firstEpoch = firstMvpEpoch(site.epochs, site.events);
const tiles = epochTiles(site.epochs, site.events);
const ready = tiles.filter((tile) => tile.available);
const soonCount = tiles.length - ready.length;
// The main button opens the story the name comes from; without it, the first epoch.
const startStory = homeStartStory(site.events);
const startHref = startStory ? storyPath(lang, startStory.slug[lang]) : firstEpoch ? epochHref(lang, firstEpoch.slug[lang]) : pagePath(lang, 'map');
// Family mode: counters carry three numbers (off, all, 12) and a chip with a zero counter is hidden in that mode.
const threadCounts = new Map(site.visibleThreads.map((th) => [th.id, countByMode(site.events.filter((e) => e.threads.includes(th.id)).map(ageInfoOf))]));
const hideIn = (modes: string[]) => (modes.length > 0 ? modes.join(' ') : undefined);

// Test text must stay out of search results until it is real.
const noindex = site.featured.some((e) => e.placeholder) || ready.some((tile) => tile.epoch.placeholder);

// "Left off": the epochs with a page, by id, for the script that knows the last epoch of the reader.
const continueTargets = Object.fromEntries(ready.map((tile) => [tile.epoch.id, { href: epochHref(lang, tile.epoch.slug[lang]), name: tile.epoch.name[lang] }]));
---
<BaseLayout lang={lang} pageKey="home" title={t(lang, 'site.name')} noindex={noindex}>
  <div class="home">
    <!-- A thin band above the first screen, only for a reader who has been in an epoch before (the script shows it). -->
    <a
      class="continue-band"
      href={firstEpoch ? epochHref(lang, firstEpoch.slug[lang]) : '#'}
      data-continue
      data-template={t(lang, 'home.continue')}
      data-targets={JSON.stringify(continueTargets)}
      hidden
    >{t(lang, 'home.continue').replace('{name}', firstEpoch?.name[lang] ?? '')}</a>

    <section class="hero" aria-labelledby="home-title">
      <div class="hero__text">
        <h1 id="home-title">{t(lang, 'home.hook_title')}</h1>
        <p class="hero__intro">{t(lang, 'home.intro')}</p>
        <p class="hero__actions">
          <a class="button" href={startHref}>{t(lang, 'home.cta_read')}</a>
          <a class="hero__link" href={pagePath(lang, 'surprise')}>{t(lang, 'ui.surprise')}</a>
          <a class="hero__link" href={pagePath(lang, 'map')}>{t(lang, 'home.open_map')}</a>
        </p>
      </div>
      <div class="hero__picture">
        <Mascot pose="run" size="hero" />
      </div>
    </section>

    {
      site.featured.length > 0 && (
        <section aria-labelledby="showcase-title" data-showcase>
          <h2 id="showcase-title">{t(lang, 'home.showcase_heading')}</h2>
          <ul class="showcase">
            {site.featured.map((event) => (
              <li {...familyAttrs(event)}>
                <StartCard lang={lang} event={event} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {site.events.length > 0 && <HomeMap lang={lang} events={site.events} tile={tileConfig(process.env)} />}

    <section id={EPOCHS_ANCHOR} aria-labelledby="epocas-title">
      <h2 id="epocas-title">{t(lang, 'home.epochs_heading')}</h2>
      <ol class="tiles">
        {
          ready.map(({ epoch, counts }) => (
            <li class="tile tile--link">
              <h3 class="tile__name">
                <a href={epochHref(lang, epoch.slug[lang])}>{epoch.name[lang]}</a>
              </h3>
              <p class="tile__years">{epochYearsText(epoch, lang)}</p>
              {epoch.theme && <p class="tile__theme">{epoch.theme[lang]}</p>}
              <p class="tile__count">
                {countVariants(counts).map((v) => <span class="fv" data-modes={v.modes.join(' ')}>{plural(lang, 'plural.stories', v.value)}</span>)}
              </p>
            </li>
          ))
        }
      </ol>
      <!-- All the epochs in order: the ready ones stand out and lead to their pages, the others are pale with "soon". -->
      <div class="timeline-wrap">
        <ol class="timeline" aria-label={t(lang, 'home.timeline_label')}>
          {
            tiles.map(({ epoch, available }) =>
              available ? (
                <li class="timeline__item timeline__item--ready">
                  <a href={epochHref(lang, epoch.slug[lang])}>
                    <span class="timeline__name">{epoch.name[lang]}</span>
                    <span class="timeline__years">{epochYearsText(epoch, lang)}</span>
                  </a>
                </li>
              ) : (
                <li class="timeline__item timeline__item--soon">
                  <span class="timeline__name">{epoch.name[lang]}</span>
                  <span class="timeline__years">{epochYearsText(epoch, lang)}</span>
                  <span class="timeline__soon">{t(lang, 'ui.soon')}</span>
                </li>
              ),
            )
          }
        </ol>
      </div>
      {soonCount > 0 && <p class="timeline__more">{plural(lang, 'plural.epochs_more', soonCount)}</p>}
    </section>

    {
      site.visibleThreads.length > 0 && (
        <section aria-labelledby="threads-title">
          <h2 id="threads-title">{t(lang, 'home.threads_heading')}</h2>
          <p>{t(lang, 'home.threads_intro')}</p>
          <ul class="chips">
            {site.visibleThreads.map((thread) => (
              <li data-hide-in={hideIn(zeroModes(threadCounts.get(thread.id)!))}>
                <ThreadChip lang={lang} name={thread.name} color={thread.color} href={threadHref(lang, thread.slug[lang])} count={threadCounts.get(thread.id)!} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<script>
  import '../scripts/last-epoch';
</script>

<style>
  .home > :global(* + *) {
    margin-block-start: var(--space-6);
  }

  .home :global(h2) {
    margin-block-end: var(--space-3);
  }

  /* ---- the band "You left off in the era ..." ---- */
  .continue-band {
    display: block;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--epoch-line);
    border-radius: var(--radius-md);
    background: var(--color-accent-tint);
    color: var(--color-ink);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .continue-band:hover {
    border-color: var(--color-accent);
  }

  .continue-band[hidden] {
    display: none;
  }

  .home > .continue-band + * {
    margin-block-start: var(--space-4);
  }

  /* ---- first screen: the story on the left, the elephant on the right (above the text on a phone, smaller) ---- */
  .hero {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }

  .hero__picture {
    order: -1;
    justify-self: start;
  }

  .hero h1 {
    font-size: var(--text-3xl);
    line-height: 1.1;
  }

  .hero__intro {
    max-width: var(--measure);
    margin-block-start: var(--space-3);
    font-size: var(--text-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-4);
    margin-block-start: var(--space-4);
  }

  .hero__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-6);
    }

    .hero__picture {
      order: 0;
      justify-self: end;
    }
  }

  /* ---- where to start, epochs ---- */
  /* The three cards are as tall as the tallest, so the small titles line up along the bottom. */
  .showcase > :global(li) {
    display: flex;
  }

  .showcase,
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--grid-home-tile-min)), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--epoch-line);
    border-radius: var(--radius-md);
    background: var(--epoch-surface);
  }

  .tile__name {
    font-size: var(--text-lg);
    line-height: 1.25;
  }

  .tile__years,
  .tile__count {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .tile__theme {
    font-family: var(--font-body);
    font-style: italic;
  }

  /* The whole tile is the link target (the link is the heading text, stretched over the tile). */
  .tile--link .tile__name a {
    text-decoration: none;
  }

  .tile--link .tile__name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .tile--link:hover {
    border-color: var(--color-accent);
  }

  .tile--link:focus-within {
    outline: var(--ring-width) solid var(--color-accent);
    outline-offset: var(--ring-offset-tight);
  }

  /* ---- the time strip: all the epochs in order ---- */
  .timeline-wrap {
    margin-block-start: var(--space-5);
    overflow-x: auto;
    padding-block-end: var(--space-2);
  }

  .timeline {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(var(--timeline-item-min), 1fr);
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-2) var(--space-1);
    border-block-start: var(--border-heavy) solid var(--epoch-line);
    font-size: var(--text-sm);
    line-height: 1.3;
  }

  /* A dot on the line for each epoch. */
  .timeline__item::before {
    content: '';
    position: absolute;
    inset-block-start: calc(var(--size-dot) / -2 - var(--border-heavy) / 2);
    inset-inline-start: var(--space-2);
    width: var(--size-dot);
    height: var(--size-dot);
    border-radius: 50%;
    background: var(--epoch-line);
  }

  .timeline__item--ready {
    border-block-start-color: var(--color-accent);
  }

  .timeline__item--ready::before {
    background: var(--color-accent);
  }

  .timeline__item--ready a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-height: var(--touch-target);
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: none;
  }

  .timeline__item--ready a:hover .timeline__name {
    text-decoration: underline;
  }

  .timeline__item--soon {
    color: var(--color-ink-muted);
  }

  .timeline__years {
    color: var(--color-ink-muted);
    font-weight: 400;
  }

  .timeline__soon {
    font-size: var(--text-sm);
    font-style: italic;
  }

  .timeline__more {
    margin-block-start: var(--space-2);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }
</style>
