---
// The page of a place: /pt/lugares/{id}/, /en/places/{id}/, /ru/mesta/{id}/ (docs/spec.md "Страницы мест").
// Order: the heading, the introduction (written, or built from the data), the districts of a city, the map of the stories, the stories in time (the oldest first,
// each with its era and year), "What to see today" (the bridges of the stories, each with "How to get there"), "Nearby" (the neighbouring places that have a page).
// The page exists while the place has three or more stories on the site (src/lib/places.ts); everything on it is counted from the data of the build.
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import FamilyNote from '../components/FamilyNote.astro';
import MapBlock from '../components/MapBlock.astro';
import { altPaths, pagePath, placePath, storyPath, withBase, type Lang } from '../i18n/routes';
import { plural, t } from '../i18n';
import { bridgeDirectionsLink } from '../lib/directions';
import { ageInfoOf, countByMode, countVariants, familyAttrs, FAMILY_MODES, isVisibleInMode } from '../lib/family';
import { toMapCards } from '../lib/map-cards';
import { cardsView, mapMaxBounds } from '../lib/map-data';
import { neighbourPages, ogStories, placeBridges, placeIntro, placeSeoDescription, placeSeoTitle } from '../lib/places';
import { epochPicture } from '../lib/pictures';
import { OG_CARD, placeCardPath } from '../lib/og-cards';
import { placeNodes } from '../lib/schema';
import { schemaContext } from '../lib/schema-site';
import { loadSite } from '../lib/site-data';
import { tileConfig } from '../lib/tiles';
import { placeCover } from '../lib/place-covers';

interface Props {
  lang: Lang;
  /** The id of the place (src/content/places.yaml). */
  id: string;
}

const { lang, id } = Astro.props;
const site = await loadSite();
const page = site.placePages.find((p) => p.place.id === id)!;
const { place, stories } = page;
const name = place.name[lang];

const intro = placeIntro(page, lang);
const epochs = new Map(site.epochs.map((e) => [e.id, e]));
const counts = countByMode(stories.map(ageInfoOf));
// A city with districts has no "What to see today": its districts have it, and the list of every bridge of the city would be a page of its own.
const bridges = page.districts.length > 0 ? [] : placeBridges(stories, lang);
// A place that no story is visible in (family mode) is hidden with its stories: nothing to show there.
const hiddenIn = (list: typeof stories) => FAMILY_MODES.filter((mode) => list.every((s) => !isVisibleInMode(ageInfoOf(s), mode)));
const hideAttr = (modes: readonly string[]) => (modes.length > 0 ? modes.join(' ') : undefined);

const parentPage = place.parent ? site.placePages.find((p) => p.place.id === place.parent) : undefined;
const districts = page.districts;
const neighbours = neighbourPages(page, site.placePages);

// The map: the same block as on the epoch pages, with the stories of the place; a click on a point opens the story.
const mapCards = toMapCards(stories, lang, (e) => storyPath(lang, e.slug[lang]));
const mapThreads = Object.fromEntries(site.threads.map((th) => [th.id, { name: th.name[lang], color: th.color }]));
const view = cardsView(mapCards, 0.25, 0.03);

const cover = place.cover ? placeCover(id) : undefined;
const alternates = altPaths((l) => placePath(l, id));
// The preview picture: three azulejo pictures of the stories the introduction names, the name of the place beneath (scripts/make-place-og.mjs).
const card = placeCardPath(id, lang);
const cardAlt = place.cover ? place.cover.alt[lang] : t(lang, 'places.og_alt').replace('{name}', name).replace('{titles}', ogStories(page).map((s) => t(lang, 'places.quote').replace('{t}', s.title[lang])).join(', '));
const noindex = stories.some((s) => s.placeholder);
const description = placeSeoDescription(intro.text);
const h1 = t(lang, 'places.h1').replace('{name}', name);
const schemaCtx = schemaContext(lang, Astro.site);
const url = schemaCtx.abs(alternates[lang]);
const schema = placeNodes(schemaCtx, {
  url,
  name: h1,
  description,
  place: { name, lat: place.center.lat, lon: place.center.lon },
  stories: stories.map((s) => ({ url: schemaCtx.abs(storyPath(lang, s.slug[lang])), name: s.title[lang] })),
  crumbs: [
    { name: t(lang, 'pages.places.title'), url: schemaCtx.abs(pagePath(lang, 'places')) },
    ...(parentPage ? [{ name: parentPage.place.name[lang], url: schemaCtx.abs(placePath(lang, parentPage.place.id)) }] : []),
    { name: h1, url },
  ],
});
---
<BaseLayout lang={lang} title={h1} seoTitle={placeSeoTitle(place, stories.length, lang)} alternates={alternates} description={description} noindex={noindex} schema={schema} preview={card ? { title: h1, imageUrl: withBase(card), imageSize: OG_CARD, imageAlt: cardAlt } : undefined}>
  <div class="place">
    <header class="place__head">
      <p class="place__crumb">
        <span data-nosnippet>
          <a href={pagePath(lang, 'places')}>{t(lang, 'pages.places.title')}</a>
          {parentPage && <><span aria-hidden="true"> / </span><a href={placePath(lang, parentPage.place.id)}>{parentPage.place.name[lang]}</a></>}
        </span>
      </p>
      {
        cover && place.cover && (
          <figure class="place__ribbon">
            <img
              src={cover.src}
              srcset={cover.srcset}
              sizes="100vw"
              width={cover.width}
              height={cover.height}
              alt={place.cover.alt[lang]}
              style={place.cover.focus ? `object-position: ${place.cover.focus}` : undefined}
              decoding="async"
            />
            {place.cover.credit && <figcaption class="place__credit"><span data-nosnippet>{place.cover.credit[lang]}</span></figcaption>}
          </figure>
        )
      }
      <h1>{h1}</h1>
      <p class="place__intro">{intro.text}</p>
      <p class="place__count">
        <span data-nosnippet>{countVariants(counts).map((v) => <span class="fv" data-modes={v.modes.join(' ')}>{plural(lang, 'plural.stories', v.value)}</span>)}</span>
      </p>
    </header>

    <FamilyNote lang={lang} cards={stories.map(ageInfoOf)} />

    {
      districts.length > 0 && (
        <section class="place__section" aria-labelledby="place-districts">
          <h2 id="place-districts">{t(lang, 'places.districts')}</h2>
          <ul class="place__links">
            {districts.map((d) => (
              <li>
                <a class="place__link" href={placePath(lang, d.place.id)}>
                  <span class="place__link-name">{d.place.name[lang]}</span>
                  <span class="place__link-count">{plural(lang, 'plural.stories', d.stories.length)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="place__map" data-map-js hidden>
      <h2 class="visually-hidden">{t(lang, 'places.map_label').replace('{name}', name)}</h2>
      <MapBlock
        lang={lang}
        mode="embedded"
        cards={mapCards}
        threads={mapThreads}
        known={{ threads: site.threads.map((th) => th.id), epochs: [] }}
        maxBounds={mapMaxBounds(mapCards)}
        view={view}
        home={view}
        tile={tileConfig(process.env)}
      />
    </div>

    <section class="place__section" aria-labelledby="place-stories">
      <h2 id="place-stories">{t(lang, 'places.stories')}</h2>
      <ul class="grid">
        {
          stories.map((event) => (
            <li {...familyAttrs(event)}>
              <p class="place__epoch">{epochs.get(event.epoch)?.name[lang]}</p>
              <EventCard
                lang={lang}
                event={event}
                variant="grid"
                threads={site.threads}
                visibleThreadIds={site.visibleThreadIds}
                showThreads={false}
                toneEpoch={event.epoch}
                fallback={epochPicture(epochs.get(event.epoch)!)}
              />
            </li>
          ))
        }
      </ul>
    </section>

    {bridges.length > 0 && (
    <section class="place__section" aria-labelledby="place-today">
      <h2 id="place-today">{t(lang, 'places.today')}</h2>
      <p class="place__lead">{t(lang, 'places.today_lead')}</p>
      <ul class="today">
        {
          bridges.map((b) => (
            <li class="today__item" data-hide-in={hideAttr(hiddenIn(b.stories))}>
              <p class="today__name">{b.title}</p>
              {b.local && <p class="today__local" lang="pt">{b.local}</p>}
              <address class="today__address">{b.address}</address>
              <p class="today__stories">
                {b.stories.map((s, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={storyPath(lang, s.slug[lang])}>{s.title[lang]}</a>
                  </>
                ))}
              </p>
              <p><a class="button button--secondary" href={bridgeDirectionsLink({ lat: b.lat, lon: b.lon, maps_url: b.mapsUrl })} target="_blank" rel="noopener">{t(lang, 'ui.directions')}</a></p>
            </li>
          ))
        }
      </ul>
    </section>
    )}

    {
      neighbours.length > 0 && (
        <section class="place__section" aria-labelledby="place-near">
          <h2 id="place-near">{t(lang, 'places.near')}</h2>
          <ul class="place__links">
            {neighbours.map((n) => (
              <li>
                <a class="place__link" href={placePath(lang, n.place.id)}>
                  <span class="place__link-name">{n.place.name[lang]}</span>
                  <span class="place__link-count">{plural(lang, 'plural.stories', n.stories.length)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .place > :global(* + *) {
    margin-block-start: var(--space-5);
  }

  .place__head > * + * {
    margin-block-start: var(--space-2);
  }

  .place__crumb,
  .place__count {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .place__head h1 {
    font-size: var(--text-2xl);
  }

  .place__intro,
  .place__lead {
    max-width: var(--measure);
    font-size: var(--text-lg);
  }

  .place__lead {
    margin-block-start: var(--space-2);
    font-size: var(--text-base);
    color: var(--color-ink-muted);
  }

  .place__section h2 {
    font-size: var(--text-xl);
  }

  /* The cover as a narrow ribbon above the map: the picture is cut to the strip, `focus` of the place says which part stays. */
  .place__ribbon {
    overflow: hidden;
  }

  .place__ribbon img {
    display: block;
    border: var(--epoch-frame);
    border-radius: var(--radius-md);
    width: 100%;
    height: var(--place-ribbon-height);
    object-fit: cover;
    filter: var(--image-filter);
  }

  .place__credit {
    margin-block-start: var(--space-1);
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
  }

  @media (min-width: 48rem) {
    .place__ribbon img {
      height: var(--place-ribbon-height-wide);
    }
  }

  /* The map is a block of its own under the introduction; the cards below are the list it points to. */
  .place__map {
    min-width: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--grid-tile-min)), 1fr));
    gap: var(--space-4);
    margin-block-start: var(--space-3);
    list-style: none;
  }

  /* The label of the era stands above the card: the cell is a column and the card takes what is left (a card that is 100% high would run over the next row). */
  .grid > li {
    display: flex;
    flex-direction: column;
  }

  .grid > li > :global(.ecard) {
    flex: 1 1 auto;
    height: auto;
  }

  .place__epoch {
    margin-block-end: var(--space-1);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .place__links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--grid-tile-min)), 1fr));
    gap: var(--space-3);
    margin-block-start: var(--space-3);
    list-style: none;
  }

  .place__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-height: var(--touch-target);
    padding: var(--space-3) var(--space-4);
    border: var(--epoch-frame);
    border-radius: var(--radius-md);
    background: var(--epoch-surface);
    color: var(--color-ink);
    text-decoration: none;
  }

  .place__link:hover {
    background: var(--color-surface-hover);
  }

  .place__link-name {
    font-weight: var(--weight-strong);
  }

  .place__link-count {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .today {
    display: grid;
    gap: var(--space-3);
    margin-block-start: var(--space-3);
    list-style: none;
  }

  .today__item {
    padding: var(--space-4);
    border: var(--epoch-frame);
    border-inline-start: var(--epoch-accent-bar);
    border-radius: var(--radius-md);
    background: var(--epoch-surface);
  }

  .today__item > * + * {
    margin-block-start: var(--space-2);
  }

  .today__name {
    font-weight: var(--weight-strong);
  }

  .today__local,
  .today__address {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    font-style: normal;
  }

  .today__stories {
    font-size: var(--text-sm);
  }

  @media (min-width: 48rem) {
    .today {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
