---
// Epoch page: /pt/epoca/{slug}, /en/era/{slug} (docs/spec.md section 5.2).
// Heading, thread filter with counters, timeline/grid switch, the feed, the map, neighbouring epochs.
// Wide screen: feed on the left, the map stays on screen on the right. One switch "Timeline · Cards · Map" (the map is a position of it on a phone only).
// The map needs JavaScript: without it the page is the plain feed (everything map-related starts hidden).
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import EpochSwitcher from '../components/EpochSwitcher.astro';
import FamilyNote from '../components/FamilyNote.astro';
import Mascot from '../components/Mascot.astro';
import PagerNav from '../components/PagerNav.astro';
import ThreadChip from '../components/ThreadChip.astro';
import MapBlock from '../components/MapBlock.astro';
import { LOCALES, altPaths, epochHref, storyPath, threadHref, type Lang } from '../i18n/routes';
import { ageInfoOf, countByMode, familyAttrs, zeroModes } from '../lib/family';
import { feedFilterCss, gridAvailable } from '../lib/epoch-filter';
import { pluralForms, t, tAll } from '../i18n';
import {
  epochFeed,
  epochHasTestText,
  epochSectionId,
  epochSwitcherItems,
  epochYearsText,
  neighbourEpochs,
  threadCountsInEpoch,
  type EpochData,
} from '../lib/epochs';
import { mascotAllowed } from '../lib/mascot';
import { yearRange } from '../lib/events';
import { toMapCards } from '../lib/map-cards';
import { mapMaxBounds, portugalView } from '../lib/map-data';
import { tileConfig } from '../lib/tiles';
import { loadSite } from '../lib/site-data';
import { previewImageUrl } from '../lib/picture-assets';
import { epochPicture } from '../lib/pictures';
import { epochNodes } from '../lib/schema';
import { schemaContext } from '../lib/schema-site';

interface Props {
  lang: Lang;
  epoch: EpochData;
}

const { lang, epoch } = Astro.props;
const site = await loadSite();

const feed = epochFeed(epoch, site.events);
const counts = threadCountsInEpoch(epoch, site.events);
// Only threads that have a page, and only those with cards in this epoch, so every counter is a real count.
const chips = site.visibleThreads.filter((th) => (counts.get(th.id) ?? 0) > 0);
// Family mode: the counters carry three numbers (off, all, 12), counted here from the data.
const feedCounts = countByMode(feed.map(ageInfoOf));
const chipCounts = new Map(chips.map((th) => [th.id, countByMode(feed.filter((e) => e.threads.includes(th.id)).map(ageInfoOf))]));
const hideIn = (modes: string[]) => (modes.length > 0 ? modes.join(' ') : undefined);
const emptyModes = zeroModes(feedCounts);

// The map shows the cards of this epoch; its thread follows the filter above (?fio=).
const mapCards = toMapCards(feed, lang, (e) => storyPath(lang, e.slug[lang]));
const mapThreads = Object.fromEntries(site.threads.map((th) => [th.id, { name: th.name[lang], color: th.color }]));

const switcherItems = epochSwitcherItems(epoch, site.epochs, site.events);
const { prev, next } = neighbourEpochs(epoch, site.epochs, site.events);
const neighbour = (n: EpochData | null, dir: string, rel: 'prev' | 'next') => (n ? { dir, title: n.name[lang], href: epochHref(lang, n.slug[lang]), rel } : null);

// The elephant walks to the next epoch, unless that page (or this one) is about the regime.
const walkingAllowed = Boolean(next) && mascotAllowed({ epoch: epoch.id }) && mascotAllowed({ epoch: next?.id });

// The introduction in the language of the page, if the data has it; no other language stands in for it.
const intro = epoch.intro?.[lang]?.trim() || undefined;

const alternates = altPaths((l) => epochHref(l, epoch.slug[l]));
// The picture of the epoch: for the cards without a picture of their own and for the link preview of the page.
const epochPic = epochPicture(epoch);
const previewUrl = epochPic ? await previewImageUrl(epochPic) : undefined;
// Pages that show test text stay out of search results until the text is real.
const noindex = epochHasTestText(epoch) || feed.some((e) => e.placeholder);
const schemaCtx = schemaContext(lang, Astro.site);
const schema = epochNodes(schemaCtx, {
  url: schemaCtx.abs(alternates[lang]),
  name: epoch.name[lang],
  description: epoch.description?.[lang] ?? epoch.theme?.[lang] ?? epoch.name[lang],
  stories: feed.map((e) => ({ url: schemaCtx.abs(storyPath(lang, e.slug[lang])), name: e.title[lang] })),
});
---
<BaseLayout
  lang={lang}
  title={epoch.name[lang]}
  alternates={alternates}
  description={epoch.description?.[lang] ?? epoch.theme?.[lang]}
  preview={{ title: epoch.name[lang], image: typeof epoch.fallback_image === 'string' ? epoch.fallback_image : undefined, imageUrl: previewUrl }}
  noindex={noindex}
  schema={schema}
  epoch={epoch.id}
>
  <!-- ?fio= applied before the first paint (the head script sets data-fio on <html>). -->
  <style slot="head" is:inline set:html={feedFilterCss(site.threads.map((th) => th.id))} />
  <div class="epoch" data-epoch-page data-pane="feed">
    <header class="epoch__header">
      <h1>{epoch.name[lang]}</h1>
      <p class="epoch__years">{epochYearsText(epoch, lang)}</p>
      {epoch.theme && <p class="epoch__theme">{epoch.theme[lang]}</p>}
      {intro && <p class="epoch__intro">{intro}</p>}
    </header>
    <div class="azulejo-rule" aria-hidden="true"></div>

    <EpochSwitcher lang={lang} items={switcherItems} />

    <div class="tools" data-epoch-tools data-threads={site.threads.map((th) => th.id).join(',')}>
      {
        chips.length > 0 && (
          <noscript>
            <nav aria-label={t(lang, 'epoch.chips_label')}>
              <ul class="chips">
                {chips.map((thread) => (
                  <li>
                    <ThreadChip
                      lang={lang}
                      name={thread.name}
                      color={thread.color}
                      description={thread.description[lang]}
                      href={`${threadHref(lang, thread.slug[lang])}#${epochSectionId(epoch.slug[lang])}`}
                      count={counts.get(thread.id) ?? 0}
                    />
                  </li>
                ))}
              </ul>
            </nav>
          </noscript>
        )
      }

      <!-- Filter and view switch need JavaScript. They are in the page from the start and shown by CSS as soon as the head script has set
           html[data-js] (before the first paint), so the script running later does not push the feed down. Counters are fixed at build time. -->
      <div class="tools__js" data-js-only>
        {
          chips.length > 0 && (
            <div role="group" aria-label={t(lang, 'epoch.chips_label')}>
              <ul class="chips">
                <li>
                  <ThreadChip
                    lang={lang}
                    name={tAll('epoch.filter_all')}
                    color="var(--color-ink-muted)"
                    count={feedCounts}
                    filter=""
                  />
                </li>
                {chips.map((thread) => (
                  <li data-hide-in={hideIn(zeroModes(chipCounts.get(thread.id)!))}>
                    <ThreadChip lang={lang} name={thread.name} color={thread.color} description={thread.description[lang]} count={chipCounts.get(thread.id)!} filter={thread.id} />
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div role="group" aria-label={t(lang, 'epoch.view_label')} class="view-switch" data-view-switch>
          <button type="button" data-view="timeline" aria-pressed="true">{t(lang, 'ui.view_timeline')}</button>
          <button type="button" data-view="grid" aria-pressed="false">{t(lang, 'ui.view_grid')}</button>
          <!-- Phone only (the map is beside the feed on a wide screen), and only when the map works: the script unhides it. -->
          <button type="button" data-pane-btn="map" aria-pressed="false" data-map-js hidden>{t(lang, 'epoch.map_pane')}</button>
        </div>
        <p
          class="visually-hidden"
          role="status"
          data-status
          data-locale={LOCALES[lang]}
          {...Object.fromEntries(Object.entries(pluralForms(lang, 'plural.stories')).map(([k, v]) => [`data-${k}`, v]))}
        >
        </p>
      </div>
    </div>

    <div class="epoch__body">
      <section class="epoch__feed" aria-labelledby="timeline-title">
        <h2 id="timeline-title" class="visually-hidden">{t(lang, 'epoch.timeline_label')}</h2>
        <FamilyNote lang={lang} cards={feed.map(ageInfoOf)} />
        {
          /* The grid needs enough stories (the switch is hidden below that, and the script falls back to the timeline). The head script has
             already set data-vista from ?vista=grelha: drop it here, before the feed is painted, so a short epoch does not jump from the grid
             to the timeline when the script arrives. */
          !gridAvailable(feed.length) && <script is:inline set:html="delete document.documentElement.dataset.vista;" />
        }
        <ol class="feed" data-view="timeline">
          {
            feed.map((event) => (
              <li class:list={['feed__item', `feed__item--${event.level}`]} data-threads={event.threads.join(' ')} {...familyAttrs(event)}>
                <span class="feed__year">{yearRange(event)[0]}</span>
                <EventCard lang={lang} event={event} variant="feed" threads={site.threads} visibleThreadIds={site.visibleThreadIds} scaleYear fallback={epochPic} tiles={gridAvailable(feed.length)} />
              </li>
            ))
          }
        </ol>
        <div class="feed-empty" data-empty hidden>
          {mascotAllowed({ epoch: epoch.id }) && <Mascot pose="peek" size="small" />}
          <p>{t(lang, 'epoch.empty')}</p>
          <button type="button" class="button button--secondary">{t(lang, 'epoch.show_all')}</button>
        </div>
        {
          emptyModes.length > 0 && (
            <div class="family-empty fv fv--block" data-modes={emptyModes.join(' ')} data-family-empty>
              {mascotAllowed({ epoch: epoch.id }) && <Mascot pose="think" size="small" />}
              <p>{t(lang, 'family.empty')}</p>
              <button type="button" class="linklike" data-family-set="off">{t(lang, 'family.show_all')}</button>
            </div>
          )
        }
      </section>

      <aside class="epoch__aside" data-epoch-aside data-map-js hidden>
        <MapBlock
          lang={lang}
          mode="embedded"
          cards={mapCards}
          threads={mapThreads}
          known={{ threads: site.threads.map((th) => th.id), epochs: [] }}
          maxBounds={mapMaxBounds(mapCards)}
          view={portugalView(mapCards)}
          tile={tileConfig(process.env)}
        />
      </aside>
    </div>

    <PagerNav
      label={t(lang, 'epoch.neighbours_label')}
      prev={neighbour(prev, `\u2190 ${t(lang, 'epoch.prev')}`, 'prev')}
      next={neighbour(next, `${t(lang, 'epoch.next')} \u2192`, 'next')}
      mascot={walkingAllowed ? 'walk' : undefined}
    />
  </div>
</BaseLayout>

<script>
  import '../scripts/epoch-filter';
  import '../scripts/epoch-map';
</script>

<style>
  .epoch > :global(* + *) {
    margin-block-start: var(--space-5);
  }

  .epoch__header > * + * {
    margin-block-start: var(--space-2);
  }

  .epoch__header h1 {
    font-size: var(--text-2xl);
  }

  .epoch__years {
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
  }

  .epoch__theme {
    max-width: var(--measure);
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-style: italic;
  }

  /* The introduction for readers who do not know the epoch: plain text, a comfortable line length. */
  .epoch__intro {
    max-width: var(--measure);
    margin-block-start: var(--space-3);
    font-size: var(--text-base);
  }

  .tools {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .tools__js {
    display: none;
    flex-direction: column;
    gap: var(--space-3);
  }

  :global(html[data-js]) .tools__js {
    display: flex;
  }

  .view-switch {
    display: inline-flex;
    align-self: flex-start;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    overflow: hidden;
    background: var(--epoch-surface);
  }

  /* Three positions on a narrow phone (Хронология, Карточки, Карта) must fit 320 px. */
  .view-switch button {
    min-height: var(--touch-target);
    padding-inline: var(--space-3);
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .view-switch button[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-surface);
  }

  @media (min-width: 30rem) {
    .view-switch button {
      padding-inline: var(--space-4);
    }
  }

  .feed-empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px dashed var(--epoch-line);
    border-radius: var(--radius-md);
  }

  /* Grid view: the same cards as tiles. One column on a narrow phone. */
  :global(html[data-vista='grelha']) .feed {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--grid-tile-min)), 1fr));
    gap: var(--space-4);
    padding: 0;
    border: 0;
  }

  :global(html[data-vista='grelha']) .feed .feed__item + .feed__item {
    margin-block-start: 0;
  }

  :global(html[data-vista='grelha']) .feed .feed__item::before {
    display: none;
  }

  :global(html[data-vista='grelha']) .feed .feed__item > :global(.ecard) {
    height: 100%;
  }

  /* A card of the grid: the picture on top when the story has one (it fills the top edge; without one nothing is reserved), then
     the credibility label first, then the date and the title, then the hook. The thread chips are left out: the filter above does
     their job and a narrow tile has no room for them. */
  :global(html[data-vista='grelha']) .feed :global(.ecard) {
    overflow: hidden;
  }

  :global(html[data-vista='grelha']) .feed :global(.ecard__head) {
    display: contents;
  }

  :global(html[data-vista='grelha']) .feed :global(.ecard__thumb) {
    order: -2;
    width: calc(100% + 2 * var(--space-4));
    height: auto;
    max-width: none;
    margin: calc(-1 * var(--space-3)) calc(-1 * var(--space-4)) var(--space-1);
    border-radius: 0;
    aspect-ratio: 1200 / 630;
  }

  :global(html[data-vista='grelha']) .feed :global(.ecard__tags) {
    order: -1;
  }

  :global(html[data-vista='grelha']) .feed :global(.ecard__tags li:has(.thread)) {
    display: none;
  }

  /* ---- feed and map ---- */

  /* The card whose marker was chosen on the map (and the reverse): a coloured bar on its left edge; the marker on the map is
     highlighted too, so the state is not a colour alone. All the cards are otherwise alike. */
  .feed__item[data-active] > :global(.ecard) {
    box-shadow: inset var(--border-heavy) 0 0 var(--epoch-primary);
  }

  /* Phone: one pane at a time; the switch (one for the timeline, the cards and the map) stays in view. */
  @media (max-width: 59.99rem) {
    .epoch[data-pane='map'] .epoch__feed,
    .epoch[data-pane='feed'] .epoch__aside {
      display: none;
    }
  }

  /* Wide screen: feed on the left, the map stays on screen while the feed scrolls. */
  @media (min-width: 60rem) {
    /* The map is beside the feed: no position for it in the switch, and with no grid there is nothing left to switch. */
    .view-switch [data-pane-btn],
    .view-switch[data-grid-off] {
      display: none;
    }

    /* The feed column is narrower beside the map: smaller tiles keep two columns in the grid view. */
    .epoch__feed {
      --grid-tile-min: var(--grid-tile-min-beside-map);
    }

    .epoch__body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--epoch-map-width);
      gap: var(--space-5);
      align-items: start;
    }

    .epoch__aside {
      position: sticky;
      inset-block-start: var(--space-4);
    }

    /* No map (tiles did not load): the feed takes the whole width again. */
    .epoch[data-map='unavailable'] .epoch__body {
      display: block;
    }
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  /* The feed is a timeline: a line on the left and a dot at every entry. */
  .feed {
    position: relative;
    margin: 0;
    padding: 0 0 0 var(--space-5);
    list-style: none;
    border-inline-start: var(--timeline-line) solid var(--epoch-line);
  }

  /* A strip of the epoch's pattern along the timeline line (behind the dots; the grid view has no timeline). */
  :global(html:not([data-vista='grelha'])) .feed::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: calc(-0.5 * (var(--timeline-line) + var(--azulejo-band-height)));
    width: var(--azulejo-band-height);
    background-color: var(--epoch-primary);
    opacity: var(--azulejo-opacity-frame);
    pointer-events: none;
    -webkit-mask: var(--azulejo-url) 0 0 / var(--azulejo-band-height) var(--azulejo-band-height) repeat-y;
    mask: var(--azulejo-url) 0 0 / var(--azulejo-band-height) var(--azulejo-band-height) repeat-y;
  }

  .feed__item {
    position: relative;
  }

  /* The year of the story, large and dark, on the scale beside the card. On a phone it stands above the card, on the line. */
  .feed__year {
    display: block;
    margin-block-end: var(--space-1);
    color: var(--color-ink);
    font-family: var(--font-label);
    font-size: var(--text-lg);
    font-variant-numeric: lining-nums;
    font-weight: 700;
    line-height: 1.2;
  }

  :global(html[data-vista='grelha']) .feed .feed__year {
    display: none;
  }

  @media (min-width: 40rem) {
    :global(html:not([data-vista='grelha'])) .feed {
      margin-inline-start: calc(var(--timeline-year-width) + var(--space-2));
    }

    :global(html:not([data-vista='grelha'])) .feed__year {
      position: absolute;
      inset-block-start: var(--timeline-year-top);
      inset-inline-end: calc(100% + var(--space-5) + var(--space-2));
      width: var(--timeline-year-width);
      margin: 0;
      text-align: end;
    }
  }

  .feed__item + .feed__item {
    margin-block-start: var(--space-4);
  }

  .feed__item::before {
    content: '';
    position: absolute;
    inset-inline-start: calc(-1 * var(--space-5) - var(--timeline-dot) / 2 - var(--timeline-line) / 2);
    inset-block-start: var(--timeline-dot-top);
    width: var(--timeline-dot);
    height: var(--timeline-dot);
    border: var(--border-medium) solid var(--color-surface);
    border-radius: 50%;
    background: var(--epoch-accent);
  }

  /* Stories between the key events: smaller dot, lighter card. */
  .feed__item--story::before {
    inset-inline-start: calc(-1 * var(--space-5) - var(--timeline-dot-small) / 2 - var(--timeline-line) / 2);
    width: var(--timeline-dot-small);
    height: var(--timeline-dot-small);
    background: var(--color-ink-muted);
  }
</style>
