---
// "Myth or fact": /pt/mito-ou-verdade/, /en/myth-or-fact/, /ru/mif-ili-pravda/ (docs/spec.md 5.8). Claims a tourist might say, each tied to one of our stories (src/content/myths.yaml).
// A card shows the claim and two buttons; a press opens the answer (the verdict and whether the guess was right, a few words, the story with its picture, Share, Next) and turns the buttons off.
// With JavaScript it is a game (src/scripts/myths.ts): one card at a time, a row of squares at the top, a result screen at the end (the row of tiles and a title by the range, no score; the misses with links, Share, Play again);
// the best result is kept in this browser only. The counter gets `myth-<id>` per answer, `myths-finish` and `myths-share`. Without JavaScript the card is a <details> opened by "Answer", all of them in a list.
// The same view makes the page of one card (/ru/mif-ili-pravda/<id>/): all the cards, that one first and marked; noindex, canonical to the page of all of them, a preview picture of its
// own (scripts/make-myth-og.mjs) with the claim and no answer.
import BaseLayout from '../layouts/BaseLayout.astro';
import GamesSwitch from '../components/GamesSwitch.astro';
import GameResult from '../components/GameResult.astro';
import MythVerdict from '../components/MythVerdict.astro';
import StoryPlate from '../components/StoryPlate.astro';
import ShareButton from '../components/ShareButton.astro';
import { RANKS, altPaths, mythPath, pagePath, rankPath, storyPath, withBase, type Lang } from '../i18n/routes';
import { plural, t } from '../i18n';
import { GAME_OG, gamePicture } from '../lib/games-images';
import { OG_CARD, mythCardPath } from '../lib/og-cards';
import { liveMyths, mythsInOrder, withStatement } from '../lib/myths';
import { MYTHS } from '../lib/myths-data';
import { pageNodes } from '../lib/schema';
import { schemaContext } from '../lib/schema-site';
import { loadSite } from '../lib/site-data';

interface Props {
  lang: Lang;
  /** The id of the claim whose own address this is; it goes first and is marked. */
  first?: string | undefined;
  /** The id of the range of a shared result (low, mid, high): the page of that result (/ru/mif-ili-pravda/zvanie/high/), the same page as the game, noindex, canonical to the game, a preview of its own. */
  rank?: string | undefined;
}

const { lang, first, rank } = Astro.props;
const site = await loadSite();
const events = new Map(site.events.map((e) => [e.id, e]));
const live = liveMyths(MYTHS, site.events);
const cards = mythsInOrder(live, first);
const title = t(lang, 'pages.myths.title');
const shareTemplate = t(lang, 'myths.share_text');
const abs = (path: string) => new URL(path, Astro.site).href;
const keys = ['progress_label', 'step', 'sq_label', 'sq_empty', 'sq_hit', 'sq_miss', 'outcome_hit', 'outcome_miss', 'outcome_part', 'next', 'finish', 'band_low', 'band_mid', 'band_high', 'share_title', 'share_ask', 'copied', 'best'] as const;
const strings = Object.fromEntries(keys.map((k) => [k, t(lang, `myths.${k}`)]));
strings.failed = t(lang, 'card.share_failed');
const one = first ? cards.find((c) => c.id === first) : undefined;
const og = one ? mythCardPath(one.id, lang) : undefined;
// The preview of the page of the game and of a shared result: the picture of the game (whole, on fields of paper); the description has the number of the claims, taken from the data.
const picture = gamePicture('myths');
const pageImage = picture ? { imageUrl: withBase(picture.og), imageSize: GAME_OG, imageAlt: t(lang, 'games.ai_caption') } : {};
const pageDescription = plural(lang, 'myths.og_description_page', live.length);
// Where "Share" leads: the page of the range of the result, with ?src=share.
const rankUrls = Object.fromEntries(RANKS.myths.map((r) => [r, `${abs(rankPath(lang, 'myths', r))}?src=share`]));
const ranked = rank && RANKS.myths.includes(rank) ? rank : undefined;
const schemaCtx = schemaContext(lang, Astro.site);
const schema = pageNodes(schemaCtx, { url: schemaCtx.abs(pagePath(lang, 'myths')), name: title, description: t(lang, 'pages.myths.description'), type: 'WebPage' });
---
<BaseLayout
  lang={lang}
  pageKey="myths"
  title={title}
  noindex={one !== undefined || ranked !== undefined}
  schema={one || ranked ? undefined : schema}
  alternates={one ? altPaths((l) => mythPath(l, one.id)) : ranked ? altPaths((l) => rankPath(l, 'myths', ranked)) : undefined}
  canonicalTo={one || ranked ? altPaths((l) => pagePath(l, 'myths')) : undefined}
  preview={ranked
    ? { title: t(lang, 'myths.rank_og_title').replace('{band}', t(lang, `myths.band_${ranked}`)), description: pageDescription, ...pageImage }
    : one
    ? {
        title: withStatement(t(lang, 'myths.og_title'), one.statement[lang]),
        description: t(lang, 'myths.og_description'),
        imageUrl: og ? withBase(og) : undefined,
        imageSize: og ? OG_CARD : undefined,
        imageAlt: one.statement[lang],
      }
    : { title: t(lang, 'myths.og_title_page'), description: pageDescription, ...pageImage }}
>
  <article class="myths" data-game data-strings={JSON.stringify(strings)} data-rank-urls={JSON.stringify(rankUrls)}>
    <GamesSwitch lang={lang} active="myths" />
    <h1>{title}</h1>
    <p class="myths__lead">{t(lang, 'myths.lead')}</p>
    <p class="myths__restart"><button class="myths__restart-button" type="button" data-restart hidden>{t(lang, 'myths.restart')}</button></p>
    <p class="myths__best" data-best hidden></p>
    <div class="myths__progress" data-progress role="group" aria-label={t(lang, 'myths.progress_label')} hidden>
      <p class="myths__step" data-step></p>
      <ol class="squares" data-squares></ol>
    </div>
    <div class="myths__list">
      {
        cards.map((m) => {
          const story = events.get(m.story)!;
          const href = mythPath(lang, m.id);
          return (
            <section class:list={['myth', { 'myth--first': m.id === first }]} id={m.id} data-myth={m.id} data-verdict={m.verdict} data-title={m.statement[lang]} aria-labelledby={`${m.id}-statement`}>
              <div class="myth__head">
                <span class="myth__place">{story.place.name[lang]}</span>
                <a class="myth__anchor" href={`#${m.id}`} aria-label={t(lang, 'myths.link')}>#</a>
              </div>
              <p class="myth__statement" id={`${m.id}-statement`}>{m.statement[lang]}</p>
              <div class="myth__buttons" role="group" aria-label={t(lang, 'myths.question')}>
                <button class="myth__button" type="button" data-pick="myth" aria-pressed="false">{t(lang, 'myths.myth')}</button>
                <button class="myth__button" type="button" data-pick="fact" aria-pressed="false">{t(lang, 'myths.fact')}</button>
              </div>
              <details class="myth__answer" data-answer>
                <summary class="myth__summary">{t(lang, 'myths.answer')}</summary>
                <div class="myth__body" tabindex="-1" data-body>
                  <p class="myth__verdict">
                    <MythVerdict lang={lang} verdict={m.verdict} />
                    <span class="myth__outcome" data-outcome></span>
                  </p>
                  <p class="myth__text">{m.answer[lang]}</p>
                  <div class="myth__foot">
                  <StoryPlate lang={lang} href={storyPath(lang, story.slug[lang])} story={story} more={t(lang, 'myths.full_story')} class="myth__story" />
                  <ShareButton lang={lang} url={abs(href)} shareUrl={abs(href)} title={title} text={withStatement(shareTemplate, m.statement[lang])} quiet />
                  </div>
                  <button class="button myth__next" type="button" data-next hidden>{t(lang, 'myths.next')}</button>
                </div>
              </details>
            </section>
          );
        })
      }
    </div>
    <GameResult lang={lang} game="myths" missesTitle={t(lang, 'myths.misses')} shareLabel={t(lang, 'ui.share')} againLabel={t(lang, 'myths.again')} readLabel={t(lang, 'myths.read')} readHref={pagePath(lang, 'home')} id="myths-score" />
    <p class="myths__end">{t(lang, 'myths.end')} <a href={pagePath(lang, 'share')}>{t(lang, 'myths.end_link')}</a></p>
  </article>
</BaseLayout>

<script>
  import '../scripts/myths';
</script>

<style>
  .myths > * + * {
    margin-block-start: var(--space-4);
  }

  .myths__lead {
    max-width: var(--measure);
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
  }

  .myths__list {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
  }

  .myth {
    padding: var(--space-4);
    border: 1px solid var(--epoch-line);
    border-radius: var(--radius-md);
    background: var(--epoch-surface);
    scroll-margin-block-start: var(--space-5);
  }

  /* The card the address points at (the page of one card: it is first; a link with #id: the target). */
  .myth--first,
  .myth:target {
    border-color: var(--epoch-accent);
    border-inline-start: var(--epoch-accent-bar);
  }

  .myth__head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    color: var(--color-ink-muted);
    font-family: var(--font-label);
    font-size: var(--text-xs);
    letter-spacing: var(--letter-label);
    text-transform: uppercase;
  }

  .myth__anchor {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--touch-target);
    min-height: var(--touch-target);
    margin: calc(-1 * var(--space-3)) calc(-1 * var(--space-3)) calc(-1 * var(--space-3)) 0;
    color: inherit;
    text-decoration: none;
  }

  .myth__anchor:hover {
    color: var(--color-accent);
  }

  .myth__statement {
    margin-block: var(--space-2) var(--space-4);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--weight-strong);
    line-height: var(--leading-heading);
  }

  /* The two buttons are for JavaScript; without it the <details> below is the way to the answer (and its summary is shown). */
  .myth__buttons {
    display: none;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  :global(html[data-js]) .myth__buttons {
    display: flex;
  }

  :global(html[data-js]) .myth__summary {
    display: none;
  }

  .myth__button {
    min-width: calc(var(--touch-target) * 2.5);
    min-height: var(--touch-target);
    padding: var(--space-2) var(--space-5);
    border: var(--border-medium) solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink);
    font-family: var(--font-label);
    font-size: var(--text-base);
    font-weight: var(--weight-strong);
    letter-spacing: var(--letter-label);
    text-transform: uppercase;
    cursor: pointer;
  }

  .myth__button:hover:not(:disabled) {
    background: var(--color-ink);
    color: var(--color-surface);
  }

  /* After the answer both are off: the one pressed stays marked, the other fades. */
  .myth__button:disabled {
    cursor: default;
    opacity: 0.45;
  }

  .myth__button[aria-pressed='true']:disabled {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-surface);
    opacity: 1;
  }

  .myth__summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    padding-inline: var(--space-4);
    border: var(--border-medium) solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    font-family: var(--font-label);
    font-weight: var(--weight-strong);
    letter-spacing: var(--letter-label);
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  .myth__summary::-webkit-details-marker {
    display: none;
  }

  .myth__body {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    margin-block-start: var(--space-4);
    padding-block-start: var(--space-4);
    border-block-start: 1px dashed var(--epoch-line);
  }

  .myth__body:focus {
    outline: none;
  }

  .myth__text {
    max-width: var(--measure);
  }

  /* The story and the quiet Share on one line (Share at the right); when they do not fit, Share goes under the story, at the left. */
  .myth__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
    width: 100%;
  }

  /* In the game the card is not shared (that would give the answer away): only the result is; the anchor "#" goes too. Without JavaScript both stay. */
  :global(html[data-js]) .myth__foot :global([data-share]),
  :global(html[data-js]) .myth__anchor {
    display: none;
  }

  /* The pieces of the game are for JavaScript: the script shows them, and `hidden` must win over the display of a button. */
  .myths [hidden] {
    display: none;
  }

  .myths__restart-button {
    min-height: var(--touch-target);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink-muted);
    font: inherit;
    font-size: var(--text-sm);
    text-decoration: underline;
    cursor: pointer;
  }

  .myths__restart-button:hover {
    color: var(--color-accent);
  }

  .myths__best,
  .myths__step {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .myths__step {
    font-family: var(--font-label);
    letter-spacing: var(--letter-label);
    text-transform: uppercase;
  }

  .myths__progress {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
  }

  .myth__verdict {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin: 0;
  }

  .myth__outcome {
    font-weight: var(--weight-strong);
  }

  .myth__next {
    justify-self: stretch;
  }

  .myths__end {
    max-width: var(--measure);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-align: center;
  }
</style>
