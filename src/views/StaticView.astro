---
// A static text page: About, Method and sources, Legal information (docs/spec.md 5.6). Texts: src/data/static-pages.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import { pagePath, type Lang } from '../i18n/routes';
import { plural, t } from '../i18n';
import { CONTACT_EMAIL, STATIC_PAGES, type StaticKey } from '../data/static-pages';
import { renderInline } from '../lib/static-text';
import { loadSite } from '../lib/site-data';

interface Props {
  lang: Lang;
  pageKey: StaticKey;
}

const { lang, pageKey } = Astro.props;
const page = STATIC_PAGES[pageKey][lang];
const title = t(lang, `pages.${pageKey}.title`);
const LINKS = ['about', 'method', 'report', 'legal', 'map'] as const;
const link = (key: string) =>
  (LINKS as readonly string[]).includes(key) ? { href: pagePath(lang, key as (typeof LINKS)[number]), label: t(lang, `pages.${key}.title`) } : undefined;
// {{stories}}: how many stories are published, counted from the data (with its noun in the language of the page).
const site = await loadSite();
const values = { stories: plural(lang, 'plural.stories', site.events.length) };
const html = (text: string) => renderInline(text, link, CONTACT_EMAIL, values);
---
<BaseLayout lang={lang} pageKey={pageKey} title={title}>
  <article class="static">
    <h1>{title}</h1>
    {page.lead && <p class="static__lead" set:html={html(page.lead)} />}
    {page.more?.map((p) => <p set:html={html(p)} />)}
    {
      page.sections.map((section) => (
        <section class="static__section" aria-labelledby={`s-${section.id}`}>
          <h2 id={`s-${section.id}`}>{section.heading}</h2>
          <div class="prose">
            {section.paragraphs.map((p) => <p set:html={html(p)} />)}
            {section.items && <ul>{section.items.map((item) => <li set:html={html(item)} />)}</ul>}
            {section.after?.map((p) => <p set:html={html(p)} />)}
          </div>
        </section>
      ))
    }
  </article>
</BaseLayout>

<style>
  .static > * + * {
    margin-block-start: var(--space-5);
  }

  .static > p {
    max-width: var(--measure);
  }

  .static__lead {
    max-width: var(--measure);
    font-size: var(--text-xl);
    line-height: 1.4;
  }

  .static__section h2 {
    margin-block-end: var(--space-2);
    font-size: var(--text-xl);
  }

  .prose ul {
    padding-inline-start: var(--space-5);
  }

  /* A long address (the licence link) must not push the page sideways on a phone. */
  .static :global(p),
  .static :global(li) {
    overflow-wrap: anywhere;
  }

  .prose li + li {
    margin-block-start: var(--space-2);
  }
</style>
