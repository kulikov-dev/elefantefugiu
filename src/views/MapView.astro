---
// Map page: /pt/mapa/, /en/map/ (docs/spec.md section 5.4).
// Without JavaScript only the plain list of all cards by epoch is shown; the map block and the filters need the script.
import BaseLayout from '../layouts/BaseLayout.astro';
import FamilyNote from '../components/FamilyNote.astro';
import EpochScale from '../components/EpochScale.astro';
import MapBlock from '../components/MapBlock.astro';
import ThreadChip from '../components/ThreadChip.astro';
import { pagePath, storyPath, type Lang } from '../i18n/routes';
import { t, tAll } from '../i18n';
import { epochHasContent, epochYearsText } from '../lib/epochs';
import { groupByEpoch, toMapCards } from '../lib/map-cards';
import { mapMaxBounds, portugalView } from '../lib/map-data';
import { tileConfig } from '../lib/tiles';
import { ageInfoOf, countByMode, zeroModes } from '../lib/family';
import { loadSite } from '../lib/site-data';
import { pageNodes } from '../lib/schema';
import { schemaContext } from '../lib/schema-site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const site = await loadSite();

const epochs = site.epochs.filter((e) => epochHasContent(e, site.events));
const inEpochs = new Set(epochs.map((e) => e.id));
const events = site.events.filter((e) => inEpochs.has(e.epoch));
const cards = toMapCards(events, lang, (e) => storyPath(lang, e.slug[lang]));
const groups = groupByEpoch(cards, epochs);

const threads = Object.fromEntries(site.threads.map((th) => [th.id, { name: th.name[lang], color: th.color }]));
const known = { threads: site.visibleThreads.map((th) => th.id), epochs: epochs.map((e) => e.id) };
const tile = tileConfig(process.env);
const noindex = events.some((e) => e.placeholder);
const schemaCtx = schemaContext(lang, Astro.site);
const schema = pageNodes(schemaCtx, { url: schemaCtx.abs(pagePath(lang, 'map')), name: t(lang, 'pages.map.title'), description: t(lang, 'pages.map.description') });
---
<BaseLayout lang={lang} title={t(lang, 'pages.map.title')} pageKey="map" noindex={noindex} schema={schema}>
  <div class="map-page">
    <h1>{t(lang, 'pages.map.title')}</h1>
    <FamilyNote lang={lang} cards={events.map(ageInfoOf)} />

    <!-- Filters need JavaScript: hidden until the loader shows them. -->
    <div class="map-filters" data-map-js hidden>
      <div role="group" aria-label={t(lang, 'map.threads_label')} class="map-filters__group">
        <ul class="map-chips">
          <li>
            <ThreadChip
              lang={lang}
              name={tAll('epoch.filter_all')}
              color="var(--color-ink-muted)"
              filter=""
            />
          </li>
          {
            site.visibleThreads.map((thread) => (
              <li>
                <ThreadChip lang={lang} name={thread.name} color={thread.color} description={thread.description[lang]} filter={thread.id} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <MapBlock
      lang={lang}
      cards={cards}
      threads={threads}
      known={known}
      maxBounds={mapMaxBounds(cards)}
      view={portugalView(cards)}
      tile={tile}
    >
      <EpochScale slot="under" lang={lang} epochs={site.epochs} readyIds={new Set(epochs.map((e) => e.id))} />
    </MapBlock>

    <section class="map-static" data-map-static aria-labelledby="map-static-title">
      <h2 id="map-static-title">{t(lang, 'map.static_title')}</h2>
      {
        groups.map((group) => (
          <section
            class="map-static__epoch"
            aria-labelledby={`map-static-${group.epoch.id}`}
            data-hide-in={zeroModes(countByMode(group.cards.map((c) => ({ minAge: c.minAge, sensitive: c.sensitive })))).join(' ') || undefined}
          >
            <h3 id={`map-static-${group.epoch.id}`}>
              {group.epoch.name[lang]} <span class="map-static__years">{epochYearsText(group.epoch, lang)}</span>
            </h3>
            <ol class="map-static__list">
              {group.cards.map((card) => (
                <li data-min-age={card.minAge} data-sensitive={String(card.sensitive)}>
                  <a href={card.href}>{card.title}</a>
                  <span class="map-static__meta">{card.meta}</span>
                  <span class="map-static__hook">{card.hook}</span>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </section>
  </div>
</BaseLayout>
