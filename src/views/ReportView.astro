---
// "Found a mistake?": /pt/corrigir/, /en/report/, /ru/oshibka/ (docs/spec.md 4 flow 5 and 5.6).
// A plain HTML form that posts to the FormSubmit service, which forwards it by email to CONTACT_EMAIL; it works without
// JavaScript (the service then sends the reader on to this page, #sent). With JavaScript the same data is sent with fetch
// and the confirmation appears in place (src/scripts/report-form.ts). The address of the card arrives as ?url= and fills the
// first field. No cookies, nothing is kept by the site itself. Not indexed: a form is no answer to a search.
import BaseLayout from '../layouts/BaseLayout.astro';
import { pagePath, type Lang } from '../i18n/routes';
import { t } from '../i18n';
import { CONTACT_EMAIL } from '../data/static-pages';
import { formsubmitEndpoint, reportSubject } from '../lib/report';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const title = t(lang, 'pages.report.title');
const action = formsubmitEndpoint(CONTACT_EMAIL, false);
const ajax = formsubmitEndpoint(CONTACT_EMAIL, true);
const next = `${new URL(pagePath(lang, 'report'), Astro.site).href}#sent`;
---
<BaseLayout lang={lang} pageKey="report" title={title} noindex>
  <article class="report">
    <h1>{title}</h1>
    <p class="report__lead">{t(lang, 'report.lead')}</p>

    <section id="sent" class="report__sent" tabindex="-1" aria-labelledby="sent-title" role="status" hidden>
      <h2 id="sent-title">{t(lang, 'report.sent_title')}</h2>
      <p>{t(lang, 'report.sent_text')}</p>
    </section>

    <form
      class="report__form"
      method="post"
      action={action}
      data-report-form
      data-ajax={ajax}
      data-sending={t(lang, 'report.sending')}
      data-submit={t(lang, 'report.submit')}
      data-too-short={t(lang, 'report.too_short')}
      novalidate
    >
      <input type="hidden" name="_subject" value={reportSubject(lang)} />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_next" value={next} />
      <input type="hidden" name="language" value={lang} />
      <!-- Honeypot: people never see it; a robot fills it and the service drops the message. -->
      <input type="text" name="_honey" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="field">
        <label for="f-url">{t(lang, 'report.url_label')}</label>
        <input id="f-url" name="page" type="text" inputmode="url" autocomplete="off" aria-describedby="f-url-hint" data-report-url />
        <p id="f-url-hint" class="field__hint">{t(lang, 'report.url_hint')}</p>
      </div>

      <div class="field">
        <label for="f-what">{t(lang, 'report.what_label')}</label>
        <textarea id="f-what" name="what" rows="5" required maxlength="2000" aria-describedby="f-what-hint f-what-error"></textarea>
        <p id="f-what-hint" class="field__hint">{t(lang, 'report.what_hint')}</p>
        <p id="f-what-error" class="field__error" role="alert" hidden></p>
      </div>

      <div class="field">
        <label for="f-fix">{t(lang, 'report.fix_label')}</label>
        <textarea id="f-fix" name="correct_version" rows="3" maxlength="2000"></textarea>
      </div>

      <div class="field">
        <label for="f-source">{t(lang, 'report.source_label')}</label>
        <input id="f-source" name="source" type="text" inputmode="url" autocomplete="off" maxlength="500" />
      </div>

      <div class="field">
        <label for="f-email">{t(lang, 'report.email_label')}</label>
        <input id="f-email" name="email" type="email" autocomplete="email" maxlength="200" aria-describedby="f-email-hint" />
        <p id="f-email-hint" class="field__hint">{t(lang, 'report.email_hint')}</p>
      </div>

      <p class="report__failed" role="alert" data-report-failed hidden>
        {t(lang, 'report.failed')} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>

      <button type="submit" class="button" data-report-submit>{t(lang, 'report.submit')}</button>
    </form>

    <p class="report__note">
      {t(lang, 'report.privacy')} <a href={`${pagePath(lang, 'legal')}#s-privacidade`}>{t(lang, 'pages.legal.title')}</a>.
    </p>
    <p class="report__note">{t(lang, 'report.direct')} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
  </article>
</BaseLayout>

<script>
  import '../scripts/report-form';
</script>

<style>
  .report > * + * {
    margin-block-start: var(--space-4);
  }

  .report__lead {
    max-width: var(--measure);
    font-size: var(--text-lg);
  }

  .report__form {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
  }

  .field {
    display: grid;
    gap: var(--space-1);
  }

  .field label {
    font-weight: var(--weight-strong);
  }

  .field input,
  .field textarea {
    width: 100%;
    min-height: var(--touch-target);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--epoch-surface);
    color: var(--color-ink);
    font: inherit;
  }

  .field__hint {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .field__error,
  .report__failed {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-heavy-border);
    border-radius: var(--radius-md);
    background: var(--color-heavy-bg);
    color: var(--color-heavy-ink);
  }

  .report__form .button {
    justify-self: start;
  }

  .report__note {
    max-width: var(--measure);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  /* The confirmation: shown when the page opens at #sent (the service sends the reader here) or by the script. */
  .report__sent {
    padding: var(--space-4);
    border: var(--epoch-frame);
    border-inline-start: var(--epoch-accent-bar);
    border-radius: var(--radius-md);
    background: var(--epoch-surface);
  }

  .report__sent:target {
    display: block !important;
  }
</style>
