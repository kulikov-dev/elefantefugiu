---
// The page of a holiday: /<lang>/festa/<slug>/ (docs/spec.md "Праздники"). The date, the name, the lead, the drawing, "The story of this day" (the story of
// the site named in `story` of src/data/festas.yaml, as the usual card), "Traditions and facts". Outside the window one line
// above the name says when the holiday is celebrated; the head script shows it. hreflang is given for the languages in which the holiday has a text.
import BaseLayout from '../layouts/BaseLayout.astro';
import FestaArt from '../components/FestaArt.astro';
import BoloGame from '../components/BoloGame.astro';
import StartCard from '../components/StartCard.astro';
import { festaPath, storyPath, LANGS, type Lang } from '../i18n/routes';
import { t } from '../i18n';
import type { FestaData } from '../data/schemas';
import { builtFesta, festaIndexable, festaText } from '../lib/festas-data';
import { cardPicture } from '../lib/pictures';
import { festaCardPath, festaCardSize } from '../lib/og-cards';
import { withBase } from '../i18n/routes';
import { loadSite } from '../lib/site-data';
import { pageNodes } from '../lib/schema';
import { schemaContext } from '../lib/schema-site';

interface Props {
  lang: Lang;
  festa: FestaData;
}

const { lang, festa } = Astro.props;
const text = festaText(festa, lang)!;
const site = await loadSite();
const bySlug = new Map(site.events.map((e) => [e.id, e]));
const href = festaPath(lang, festa.slug);
const indexable = festaIndexable(festa);
const built = builtFesta();
// Without JavaScript the line stands when the build is outside the window.
const offBuilt = !(indexable && built?.id === festa.id);
const og = festaCardPath(festa.id);
// Structured data (an indexable page only; BaseLayout leaves it out under noindex).
const schemaCtx = schemaContext(lang, Astro.site);
const schema = pageNodes(schemaCtx, { url: schemaCtx.abs(href), name: text.name, description: text.lead });
// The story of the day, as a card of "Where to start"; the section is left out when the holiday names none (or the story is not on the site).
const dayStory = festa.story ? bySlug.get(festa.story) : undefined;
const storyEpoch = dayStory ? site.epochs.find((ep) => ep.id === dayStory.epoch) : undefined;
const readyLangs = LANGS.filter((l) => festaText(festa, l));
---
<BaseLayout
  lang={lang}
  pageKey={undefined}
  title={text.name}
  description={text.lead}
  alternates={{ pt: festaPath('pt', festa.slug), en: festaPath('en', festa.slug), ru: festaPath('ru', festa.slug) }}
  readyLangs={readyLangs}
  activeLangs={readyLangs}
  noindex={!indexable}
  schema={schema}
  preview={{ title: `${text.name} · ${text.date}`, description: text.og_description ?? text.lead, imageUrl: og ? withBase(og) : undefined, imageSize: og ? festaCardSize(og) : undefined, imageAlt: text.art_title }}
>
  <article class="festa-page">
    <div class:list={['festa-page__top', { 'festa-page__top--stack': festa.art === 'bolo' }]}>
      <header>
        <!-- In the window the date; outside it the line "this holiday is celebrated on ..." in the same place, in the plain style of the lead (the head script decides). -->
        <p class:list={['festa-page__date', { 'is-off-built': offBuilt }]} data-festa-on={festa.id}>{text.date}</p>
        <p class="festa-page__off" data-festa-off={festa.id} data-festa-built={offBuilt ? '' : undefined}>{text.off_window}</p>
        <h1>{text.name}</h1>
        <p class="festa-page__lead">{text.lead}</p>
      </header>
      {
        festa.art && (
          <div class:list={['festa-page__art', { 'festa-page__art--wide': festa.art === 'bolo' }]}>
            {festa.art === 'bolo' && text.bolo ? (
              <BoloGame text={text.bolo} />
            ) : (
              <FestaArt art={festa.art} title={text.art_title} id={`festa-art-${festa.id}`} />
            )}
          </div>
        )
      }
    </div>
    {
      dayStory && (
        <section aria-labelledby="festa-history">
          <h2 id="festa-history">{t(lang, 'festa.history')}</h2>
          <div class="festa-story" data-festa-story={dayStory.id}>
            <StartCard lang={lang} event={dayStory} picture={cardPicture(dayStory, storyEpoch ?? {})} />
          </div>
        </section>
      )
    }
    <section aria-labelledby="festa-traditions">
      <h2 id="festa-traditions">{t(lang, 'festa.traditions')}</h2>
      <ul class="festa-trad">
        {
          text.traditions.map((item) => {
            const story = item.link ? bySlug.get(item.link.story) : undefined;
            return (
              <li>
                <strong>{item.title}</strong> {item.text}
                {item.link && story && (
                  <>
                    {' '}
                    <a href={storyPath(lang, story.slug[lang])}>{item.link.label}</a>
                  </>
                )}
              </li>
            );
          })
        }
      </ul>
    </section>
  </article>
</BaseLayout>
