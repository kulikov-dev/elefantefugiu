---
// "Which came first?": /pt/o-que-veio-primeiro/, /en/which-came-first/, /ru/chto-bylo-ranshe/ (docs/spec.md 5.9). A round is ten pairs of stories; the reader presses the one that came first.
// The page carries no list: src/scripts/order.ts reads /{lang}/order.json (made at build time from the published stories) and draws the pairs in the browser, in the family mode of the reader.
// A card shows a thumbnail, a title and the hook, no year, no epoch name, no epoch colour (they would give the answer away). After a press: the pressed card is framed and marked "Your pick", both dates, the mark "First",
// the label of the verdict (the one of "Myth or fact") with the years between beside it and Next; each card becomes a link to its story (the whole card), with "Whole story →" at its foot. The round is kept in this browser (`order:game`) and goes on from the same pair.
// The result is the one of "Myth or fact" (src/components/GameResult.astro). The counter gets one event, `order-finish`. Without JavaScript: a line and a link to the myths.
// The same view makes the page of a shared result (/ru/chto-bylo-ranshe/zvanie/high/): the page of the game, noindex, canonical to the game, a preview of its own.
// The styles are global: the cards of a pair are made by the script (the class names are all order__*).
import BaseLayout from '../layouts/BaseLayout.astro';
import GameResult from '../components/GameResult.astro';
import GamesSwitch from '../components/GamesSwitch.astro';
import { LOCALES, RANKS, altPaths, pagePath, rankPath, withBase, type Lang } from '../i18n/routes';
import { pluralForms, t } from '../i18n';
import { GAME_OG, gamePicture } from '../lib/games-images';
import { pageNodes } from '../lib/schema';
import { schemaContext } from '../lib/schema-site';

interface Props {
  lang: Lang;
  /** The id of the range of a shared result (low, mid, high, top): the page of that result. */
  rank?: string | undefined;
}

const { lang, rank } = Astro.props;
const title = t(lang, 'pages.order.title');
const abs = (path: string) => new URL(path, Astro.site).href;
const keys = ['progress_label', 'step', 'sq_label', 'sq_empty', 'sq_hit', 'sq_miss', 'first', 'yours', 'verdict_hit', 'verdict_miss', 'next', 'finish', 'band_top', 'band_high', 'band_mid', 'band_low', 'result_text', 'copied', 'empty'] as const;
const strings: Record<string, string> = Object.fromEntries(keys.map((k) => [k, t(lang, `order.${k}`)]));
strings.full_story = t(lang, 'myths.full_story');
for (const base of ['between', 'between_about']) for (const [category, text] of Object.entries(pluralForms(lang, `order.${base}`))) strings[`${base}_${category}`] = text;
strings.failed = t(lang, 'card.share_failed');
const schemaCtx = schemaContext(lang, Astro.site);
const schema = pageNodes(schemaCtx, { url: schemaCtx.abs(pagePath(lang, 'order')), name: title, description: t(lang, 'pages.order.description'), type: 'WebPage' });
// The preview of the page of the game and of a shared result: the picture of the game (whole, on fields of paper).
const picture = gamePicture('order');
const pageImage = picture ? { imageUrl: withBase(picture.og), imageSize: GAME_OG, imageAlt: t(lang, 'games.ai_caption') } : {};
const ranked = rank && RANKS.order.includes(rank) ? rank : undefined;
// Where "Share" leads: the page of the range of the result, with ?src=share.
const rankUrls = Object.fromEntries(RANKS.order.map((r) => [r, `${abs(rankPath(lang, 'order', r))}?src=share`]));
---
<BaseLayout
  lang={lang}
  pageKey="order"
  title={title}
  noindex={ranked !== undefined}
  schema={ranked ? undefined : schema}
  alternates={ranked ? altPaths((l) => rankPath(l, 'order', ranked)) : undefined}
  preview={ranked
    ? { title: t(lang, 'order.rank_og_title').replace('{band}', t(lang, `order.band_${ranked}`)), description: t(lang, 'order.rank_og_description'), ...pageImage }
    : { title: t(lang, 'order.og_title_page'), description: t(lang, 'order.og_description'), ...pageImage }}
>
  <article class="order" data-order data-strings={JSON.stringify(strings)} data-src={withBase(`${lang}/order.json`)} data-locale={LOCALES[lang]} data-rank-urls={JSON.stringify(rankUrls)}>
    <GamesSwitch lang={lang} active="order" />
    <h1>{title}</h1>
    <p class="order__lead">{t(lang, 'order.lead')}</p>
    <p class="order__nojs">{t(lang, 'order.nojs')} <a href={pagePath(lang, 'myths')}>{t(lang, 'order.nojs_link')}</a></p>
    <div class="order__game" data-game hidden>
      <div class="order__progress" data-progress role="group" aria-label={t(lang, 'order.progress_label')}>
        <p class="order__step" data-step></p>
        <ol class="squares" data-squares></ol>
      </div>
      <div class="order__pair" data-pair role="group" aria-label={t(lang, 'order.question')}></div>
      <div class="order__answer" data-answer tabindex="-1" hidden>
        <p class="order__verdict"><span data-verdict></span> <span class="order__between" data-between></span></p>
        <button class="button order__next" type="button" data-next></button>
      </div>
    </div>
    <p class="order__empty" data-empty hidden>{t(lang, 'order.empty')}</p>
    <GameResult lang={lang} game="order" missesTitle={t(lang, 'order.misses')} shareLabel={t(lang, 'ui.share')} againLabel={t(lang, 'order.again')} readLabel={t(lang, 'order.read_all')} readHref={pagePath(lang, 'home')} id="order-score" />
  </article>
</BaseLayout>

<script>
  import '../scripts/order';
</script>

<style is:global>
  .order > * + * {
    margin-block-start: var(--space-4);
  }

  .order [hidden] {
    display: none;
  }

  .order__lead {
    max-width: var(--measure);
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
  }

  /* The game is for JavaScript: without it only the line with the link to the myths stays. */
  html[data-js] .order__nojs {
    display: none;
  }

  .order__progress {
    display: grid;
    gap: var(--space-2);
  }

  .order__step {
    margin: 0;
    scroll-margin-block-start: var(--space-3);
    color: var(--color-ink-muted);
    font-family: var(--font-label);
    font-size: var(--text-sm);
    letter-spacing: var(--letter-label);
    text-transform: uppercase;
  }

  /* Two cards side by side where they fit, one under the other on a phone. */
  .order__pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--grid-tile-min)), 1fr));
    gap: var(--space-3);
    margin-block-start: var(--space-4);
  }

  .order__answer:focus {
    outline: none;
  }

  .order__cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .order__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 0;
    overflow: hidden;
    border: var(--border-medium) solid var(--epoch-line);
    border-radius: var(--radius-md);
    background: var(--epoch-surface);
    color: var(--color-ink);
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  button.order__card:hover {
    border-color: var(--color-ink);
  }

  /* After the answer a card is a link to its story (the whole card), with "Whole story →" at its foot. */
  a.order__card {
    text-decoration: none;
  }

  a.order__card:hover {
    border-color: var(--color-accent);
  }

  /* The picture, the title and the hook of the card not pressed fade; its date, the mark "First" and "Whole story →" do not (they are the answer and the way on). */
  .order__card[data-picked='false'] :is(.order__thumb, .order__title, .order__hint) {
    opacity: 0.45;
  }

  /* The card pressed: a frame of the colour of a link and the small mark "Your pick" above the title; the title stays on the surface of the card. */
  .order__card[data-picked='true'] {
    border-color: var(--color-accent);
  }

  .order__more {
    padding: 0 var(--space-4) var(--space-3);
    color: var(--color-accent);
    font-size: var(--text-sm);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .order__yours {
    padding: var(--space-2) var(--space-4) 0;
    color: var(--color-accent);
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: var(--letter-label);
    text-transform: uppercase;
  }

  .order__yours + .order__title {
    padding-block-start: var(--space-1);
  }

  .order__thumb {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 7;
    background: var(--epoch-line);
    filter: var(--image-filter);
    object-fit: cover;
  }

  .order__title {
    display: block;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--weight-strong);
    line-height: var(--leading-heading);
  }

  /* The hook under the title: smaller, muted, two lines at most. */
  .order__hint {
    display: -webkit-box;
    padding: 0 var(--space-4) var(--space-3);
    overflow: hidden;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-heading);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .order__when {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-4) var(--space-3);
  }

  .order__first {
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-tile-blue);
    border-radius: var(--radius-sm);
    color: var(--color-tile-blue);
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: var(--letter-label);
    text-transform: uppercase;
  }

  .order__date {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--weight-strong);
    line-height: var(--leading-heading);
  }

  .order__answer {
    display: grid;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
  }

  .order__answer > * {
    margin: 0;
  }

  /* The answer as in "Myth or fact": the label of the verdict and, beside it, the plain line of the years between. */
  .order__verdict {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .order__next {
    justify-self: stretch;
  }
</style>
