---
// "Which came first?": /pt/o-que-veio-primeiro/, /en/which-came-first/, /ru/chto-bylo-ranshe/ (docs/spec.md 5.9). A round is ten pairs of stories; the reader presses the one that came first.
// The page carries no list: src/scripts/order.ts reads /{lang}/order.json (made at build time from the published stories) and draws the pairs in the browser, in the family mode of the reader.
// A card shows a thumbnail and a title, no year, no epoch name, no epoch colour (they would give the answer away). After a press both dates, the mark "First", the years between and links to the stories.
// The styles are global: the cards of a pair are made by the script (the class names are all order__*). The result is the one of "Myth or fact" (src/components/GameResult.astro). The counter gets one event, `order-finish`. Nothing is kept between visits. Without JavaScript: a line and a link to the myths.
import BaseLayout from '../layouts/BaseLayout.astro';
import GameResult from '../components/GameResult.astro';
import GamesSwitch from '../components/GamesSwitch.astro';
import { LOCALES, pagePath, withBase, type Lang } from '../i18n/routes';
import { pluralForms, t } from '../i18n';
import { pageNodes } from '../lib/schema';
import { schemaContext } from '../lib/schema-site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const title = t(lang, 'pages.order.title');
const abs = (path: string) => new URL(path, Astro.site).href;
const keys = ['progress_label', 'step', 'sq_label', 'sq_empty', 'sq_hit', 'sq_miss', 'first', 'outcome_hit', 'outcome_miss', 'read', 'next', 'finish', 'band_top', 'band_high', 'band_mid', 'band_low', 'share_title', 'share_ask', 'copied', 'empty'] as const;
const strings: Record<string, string> = Object.fromEntries(keys.map((k) => [k, t(lang, `order.${k}`)]));
for (const base of ['between', 'between_about']) for (const [category, text] of Object.entries(pluralForms(lang, `order.${base}`))) strings[`${base}_${category}`] = text;
strings.failed = t(lang, 'card.share_failed');
const schemaCtx = schemaContext(lang, Astro.site);
const schema = pageNodes(schemaCtx, { url: schemaCtx.abs(pagePath(lang, 'order')), name: title, description: t(lang, 'pages.order.description'), type: 'WebPage' });
---
<BaseLayout lang={lang} pageKey="order" title={title} schema={schema} preview={{ title: t(lang, 'order.og_title_page'), description: t(lang, 'order.og_description') }}>
  <article
    class="order"
    data-order
    data-strings={JSON.stringify(strings)}
    data-src={withBase(`${lang}/order.json`)}
    data-locale={LOCALES[lang]}
    data-share-url={`${abs(pagePath(lang, 'order'))}?src=share`}
  >
    <GamesSwitch lang={lang} active="order" />
    <h1>{title}</h1>
    <p class="order__lead">{t(lang, 'order.lead')}</p>
    <p class="order__nojs">{t(lang, 'order.nojs')} <a href={pagePath(lang, 'myths')}>{t(lang, 'order.nojs_link')}</a></p>
    <div class="order__game" data-game hidden>
      <div class="order__progress" data-progress role="group" aria-label={t(lang, 'order.progress_label')}>
        <p class="order__step" data-step></p>
        <ol class="squares" data-squares></ol>
      </div>
      <div class="order__pair" data-pair role="group" aria-label={t(lang, 'order.question')} tabindex="-1"></div>
      <div class="order__answer" data-answer tabindex="-1" hidden>
        <p class="order__outcome" data-outcome></p>
        <p class="order__between" data-between></p>
        <button class="button order__next" type="button" data-next></button>
      </div>
    </div>
    <p class="order__empty" data-empty hidden>{t(lang, 'order.empty')}</p>
    <GameResult missesTitle={t(lang, 'order.misses')} shareLabel={t(lang, 'ui.share')} againLabel={t(lang, 'order.again')} readLabel={t(lang, 'order.read_all')} readHref={pagePath(lang, 'home')} id="order-score" />
  </article>
</BaseLayout>

<script>
  import '../scripts/order';
</script>

<style is:global>
  .order > * + * {
    margin-block-start: var(--space-4);
  }

  .order [hidden] {
    display: none;
  }

  .order__lead {
    max-width: var(--measure);
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
  }

  /* The game is for JavaScript: without it only the line with the link to the myths stays. */
  html[data-js] .order__nojs {
    display: none;
  }

  .order__progress {
    display: grid;
    gap: var(--space-2);
  }

  .order__step {
    margin: 0;
    scroll-margin-block-start: var(--space-3);
    color: var(--color-ink-muted);
    font-family: var(--font-label);
    font-size: var(--text-sm);
    letter-spacing: var(--letter-label);
    text-transform: uppercase;
  }

  /* Two cards side by side where they fit, one under the other on a phone. */
  .order__pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--grid-tile-min)), 1fr));
    gap: var(--space-3);
    margin-block-start: var(--space-4);
  }

  .order__pair:focus,
  .order__answer:focus {
    outline: none;
  }

  .order__cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .order__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 0;
    overflow: hidden;
    border: var(--border-medium) solid var(--epoch-line);
    border-radius: var(--radius-md);
    background: var(--epoch-surface);
    color: var(--color-ink);
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .order__card:hover:not(:disabled) {
    border-color: var(--color-ink);
  }

  /* After the answer both are off: the one pressed stays marked (as the button of "Myth or fact"), the other fades. */
  .order__card:disabled {
    cursor: default;
  }

  /* The picture and the title of the card not pressed fade; its date and the mark "First" do not (they are the answer). */
  .order__card:disabled:not([aria-pressed='true']) :is(.order__thumb, .order__title, .order__hint) {
    opacity: 0.45;
  }

  .order__card[aria-pressed='true']:disabled {
    border-color: var(--color-ink);
  }

  .order__card[aria-pressed='true']:disabled .order__title {
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .order__thumb {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 7;
    background: var(--epoch-line);
    filter: var(--image-filter);
    object-fit: cover;
  }

  .order__title {
    display: block;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--weight-strong);
    line-height: var(--leading-heading);
  }

  /* The hook under the title: smaller, muted, two lines at most. */
  .order__hint {
    display: -webkit-box;
    padding: 0 var(--space-4) var(--space-3);
    overflow: hidden;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-heading);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .order__when {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-4) var(--space-3);
  }

  .order__first {
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-tile-blue);
    border-radius: var(--radius-sm);
    color: var(--color-tile-blue);
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: var(--letter-label);
    text-transform: uppercase;
  }

  .order__date {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--weight-strong);
    line-height: var(--leading-heading);
  }

  .order__read {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    font-size: var(--text-sm);
  }

  .order__answer {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
  }

  .order__answer > * {
    margin: 0;
  }

  .order__outcome {
    font-weight: var(--weight-strong);
  }

  .order__between {
    color: var(--color-ink-muted);
  }

  .order__next {
    justify-self: stretch;
    margin-block-start: var(--space-2);
  }
</style>
