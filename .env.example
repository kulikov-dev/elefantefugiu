# Copy values into your shell (Astro config reads process.env). The production values are in the deploy workflow:
#   SITE_URL=https://elefantefugiu.pt, no base path. A project site (test only): SITE_URL=https://USER.github.io BASE_PATH=/REPO
SITE_URL=http://localhost:4321
# Leave empty for a site served from the domain root.
BASE_PATH=

# Map tiles. With CARTO_KEY the map uses the CARTO basemaps (Voyager in the light theme, Dark Matter in the dark one), with the
# attribution "(c) OpenStreetMap contributors, (c) CARTO". Without it the map uses the public OpenStreetMap server, which is
# fine for development only: its usage policy does not allow steady public traffic. The key is not a secret (it ends up in every
# tile address of the built site): restrict it to the site's domain in the CARTO dashboard. Do not commit this file.
CARTO_KEY=
# Another provider instead of CARTO: TILE_URL must be https and contain {z}, {x} and {y}; TILE_ATTRIBUTION (HTML, links
# allowed) is required with it. TILE_URL wins over CARTO_KEY.
TILE_URL=
TILE_ATTRIBUTION=
