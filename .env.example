# Copy values into your shell (Astro config reads process.env), e.g.:
#   SITE_URL=https://USER.github.io BASE_PATH=/REPO npm run build
SITE_URL=http://localhost:4321
# Leave empty for a site served from the domain root.
BASE_PATH=

# Map tiles (stage 5). Empty = the public OpenStreetMap server, fine for development only:
# its usage policy does not allow steady public traffic, so a tile provider or own tiles are needed before launch.
# TILE_URL must be https and contain {z}, {x} and {y}; TILE_ATTRIBUTION (HTML, links allowed) is required with it.
TILE_URL=
TILE_ATTRIBUTION=
