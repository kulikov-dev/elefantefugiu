{
  "name": "o-elefante-fugiu",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-i18n.mjs && node scripts/check-contrast.mjs && npm test && tsx scripts/check-data.ts && astro build",
    "postbuild": "node scripts/make-sitemap.mjs && node scripts/check-sitemap.mjs && node scripts/check-previews.mjs && node scripts/check-links.mjs && node scripts/check-cards.mjs && node scripts/check-listings.mjs && node scripts/check-weight.mjs && node scripts/check-tokens.mjs && node scripts/check-ru.mjs && node scripts/check-mascot.mjs && node scripts/check-published.mjs && node scripts/check-email.mjs && node scripts/check-https.mjs && node scripts/check-schema.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:data": "tsx scripts/check-data.ts",
    "check:links": "node scripts/check-links.mjs",
    "export:ui-table": "node scripts/export-ui-table.mjs",
    "test": "astro check && node --import tsx --test \"tests/**/*.test.ts\" && vitest run && tsx scripts/check-lang.ts && tsx scripts/check-ai-tells.ts",
    "check:cards": "node scripts/check-cards.mjs",
    "check:weight": "node scripts/check-weight.mjs",
    "check:listings": "node scripts/check-listings.mjs",
    "test:unit": "vitest run",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:ru": "node scripts/check-ru.mjs && node scripts/check-mascot.mjs",
    "check:published": "node scripts/check-published.mjs",
    "check:email": "node scripts/check-email.mjs",
    "check:https": "node scripts/check-https.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:lang": "tsx scripts/check-lang.ts",
    "check:ai-tells": "tsx scripts/check-ai-tells.ts",
    "lang:pending": "tsx scripts/lang-pending.ts",
    "lang:mark": "tsx scripts/lang-mark.ts",
    "lang:inventory": "tsx scripts/lang-inventory.ts",
    "make:og": "node scripts/make-og-images.mjs",
    "make:sitemap": "node scripts/make-sitemap.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:previews": "node scripts/check-previews.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "qa": "node scripts/qa/run.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "astro": "^7.3.8",
    "leaflet": "1.9.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@capsizecss/metrics": "^4.4.0",
    "@types/leaflet": "1.9.21",
    "@types/node": "^22.20.5",
    "tsx": "4.23.15",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  }
}
